        <mxCell id="cmcp-kafka-cr" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C5CAE9;strokeColor=#3949AB;fontSize=9;align=left;spacingLeft=5;fontFamily=Courier New;" value="Kafka CR&#xa;spec.tls:&#xa;  secretRef: kafka-tls" vertex="1">
          <mxGeometry height="45" width="170" x="75" y="445" as="geometry" />
        </mxCell>
        <mxCell id="cmcp-sr-cr" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C5CAE9;strokeColor=#3949AB;fontSize=9;align=left;spacingLeft=5;fontFamily=Courier New;" value="SchemaRegistry CR&#xa;spec.tls:&#xa;  secretRef: schemaregistry-tls" vertex="1">
          <mxGeometry height="45" width="210" x="265" y="445" as="geometry" />
        </mxCell>
        <mxCell id="cmcp-etc" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C5CAE9;strokeColor=#3949AB;fontSize=9;align=left;spacingLeft=5;" value="Connect, ControlCenter,&#xa;KRaftController CRs&#xa;(same pattern)" vertex="1">
          <mxGeometry height="45" width="170" x="500" y="445" as="geometry" />
        </mxCell>
        <mxCell id="cmcp-note" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;fontSize=9;fontStyle=2;align=left;spacingLeft=8;" value="&lt;b&gt;Unlike the operator webhook&lt;/b&gt;, CP components accept standard K8s TLS secrets (tls.crt, tls.key, ca.crt) directly.&#xa;No PKCS12 conversion or volume projection needed. CFK handles the JKS conversion internally for the component pods." vertex="1">
          <mxGeometry height="40" width="600" x="90" y="540" as="geometry" />
        </mxCell>
        <mxCell id="cmcp-wildcard" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#F9A825;fontSize=9;fontStyle=2;align=left;spacingLeft=8;" value="&lt;b&gt;Kafka SANs note:&lt;/b&gt; StatefulSet Pods need wildcard SANs &lt;code&gt;*.kafka-headless.&amp;lt;ns&amp;gt;.svc&lt;/code&gt;&#xa;so each broker (kafka-0, kafka-1, kafka-2) is covered by the same certificate." vertex="1">
          <mxGeometry height="35" width="600" x="90" y="590" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="cm-flink-op-ref" name="Reference — cert-manager + Flink Operator">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
