        </mxCell>
        <!-- ===== RECLAIM POLICIES ===== -->
        <mxCell id="st-reclaim" value="Reclaim Policies (what happens when PVC is deleted)" style="shape=mxgraph.gcp2.standard_rectangle;fillColor=#FCE4EC;strokeColor=#C62828;fontStyle=1;fontSize=13;verticalAlign=top;spacingTop=5;rounded=1;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="730" width="730" height="140" as="geometry" />
        </mxCell>
        <mxCell id="st-reclaim-table" value="&lt;table style=&#39;font-size:10px;border-collapse:collapse;width:100%&#39;&gt;&lt;tr style=&#39;background:#FCE4EC;font-weight:bold&#39;&gt;&lt;td style=&#39;padding:4px;border:1px solid #C62828&#39;&gt;Policy&lt;/td&gt;&lt;td style=&#39;padding:4px;border:1px solid #C62828&#39;&gt;PV After PVC Deletion&lt;/td&gt;&lt;td style=&#39;padding:4px;border:1px solid #C62828&#39;&gt;Data&lt;/td&gt;&lt;td style=&#39;padding:4px;border:1px solid #C62828&#39;&gt;When to Use&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#39;padding:4px;border:1px solid #ccc;font-weight:bold&#39;&gt;Delete&lt;/td&gt;&lt;td style=&#39;padding:4px;border:1px solid #ccc&#39;&gt;PV and storage deleted&lt;/td&gt;&lt;td style=&#39;padding:4px;border:1px solid #ccc;color:red&#39;&gt;LOST&lt;/td&gt;&lt;td style=&#39;padding:4px;border:1px solid #ccc&#39;&gt;Ephemeral data (default for dynamic provisioning)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#39;padding:4px;border:1px solid #ccc;font-weight:bold&#39;&gt;Retain&lt;/td&gt;&lt;td style=&#39;padding:4px;border:1px solid #ccc&#39;&gt;PV becomes &quot;Released&quot; — manual cleanup&lt;/td&gt;&lt;td style=&#39;padding:4px;border:1px solid #ccc;color:green&#39;&gt;KEPT&lt;/td&gt;&lt;td style=&#39;padding:4px;border:1px solid #ccc&#39;&gt;Important data (Kafka logs, databases)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#39;padding:4px;border:1px solid #ccc;font-weight:bold&#39;&gt;Recycle&lt;/td&gt;&lt;td style=&#39;padding:4px;border:1px solid #ccc&#39;&gt;Data wiped (rm -rf), PV available again&lt;/td&gt;&lt;td style=&#39;padding:4px;border:1px solid #ccc;color:orange&#39;&gt;WIPED&lt;/td&gt;&lt;td style=&#39;padding:4px;border:1px solid #ccc&#39;&gt;Deprecated — use dynamic provisioning&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;overflow=fill;rounded=1;whiteSpace=wrap;fillColor=#FAFAFA;strokeColor=#C62828;" vertex="1" parent="1">
          <mxGeometry x="55" y="760" width="700" height="100" as="geometry" />
        </mxCell>
        <!-- ===== RIGHT SIDE: Binding, StatefulSet, CSI, Lifecycle ===== -->
        <mxCell id="st-right" value="" style="shape=mxgraph.gcp2.standard_rectangle;fillColor=#FAFAFA;strokeColor=#9E9E9E;rounded=1;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="800" y="480" width="740" height="390" as="geometry" />
        </mxCell>
        <mxCell id="st-bind-title" value="Volume Binding Modes" style="text;html=1;fontSize=12;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="810" y="485" width="250" height="20" as="geometry" />
        </mxCell>
        <mxCell id="st-bind-imm" value="&lt;b&gt;Immediate&lt;/b&gt; — PV provisioned as soon as PVC created. Risk: PV may land in different zone than Pod." style="text;html=1;fontSize=9;align=left;spacingLeft=5;" vertex="1" parent="1">
          <mxGeometry x="810" y="510" width="710" height="15" as="geometry" />
        </mxCell>
        <mxCell id="st-bind-wait" value="&lt;b&gt;WaitForFirstConsumer&lt;/b&gt; — PV provisioned after Pod is scheduled. CSI creates storage in same zone. &lt;span style=&#39;color:#2E7D32;font-weight:bold&#39;&gt;Best practice.&lt;/span&gt;" style="text;html=1;fontSize=9;align=left;spacingLeft=5;" vertex="1" parent="1">
          <mxGeometry x="810" y="530" width="710" height="15" as="geometry" />
        </mxCell>
        <mxCell id="st-sts-title" value="StatefulSet + volumeClaimTemplates" style="text;html=1;fontSize=12;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="810" y="560" width="350" height="20" as="geometry" />
        </mxCell>
        <mxCell id="st-sts-desc" value="StatefulSets define a &lt;b&gt;volumeClaimTemplate&lt;/b&gt; — K8s creates one PVC per replica:&lt;br&gt;&lt;br&gt;&lt;code&gt;kafka&lt;/code&gt; (3 replicas) →  PVC: &lt;code&gt;data-kafka-0&lt;/code&gt; (50Gi) → PV-0 → EBS vol-abc&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;PVC: &lt;code&gt;data-kafka-1&lt;/code&gt; (50Gi) → PV-1 → EBS vol-def&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;PVC: &lt;code&gt;data-kafka-2&lt;/code&gt; (50Gi) → PV-2 → EBS vol-ghi&lt;br&gt;&lt;br&gt;If a Pod is rescheduled, it re-attaches to the &lt;b&gt;same PVC&lt;/b&gt; (stable identity)." style="text;html=1;fontSize=9;align=left;spacingLeft=5;" vertex="1" parent="1">
          <mxGeometry x="810" y="580" width="710" height="85" as="geometry" />
        </mxCell>
        <mxCell id="st-csi-title" value="Common CSI Drivers" style="text;html=1;fontSize=12;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="810" y="675" width="250" height="20" as="geometry" />
        </mxCell>
        <mxCell id="st-csi-table" value="&lt;table style=&#39;font-size:9px;border-collapse:collapse;width:100%&#39;&gt;&lt;tr style=&#39;background:#E3F2FD;font-weight:bold&#39;&gt;&lt;td style=&#39;padding:3px;border:1px solid #1565C0&#39;&gt;Provider&lt;/td&gt;&lt;td style=&#39;padding:3px;border:1px solid #1565C0&#39;&gt;CSI Driver&lt;/td&gt;&lt;td style=&#39;padding:3px;border:1px solid #1565C0&#39;&gt;Modes&lt;/td&gt;&lt;td style=&#39;padding:3px;border:1px solid #1565C0&#39;&gt;Type&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#39;padding:3px;border:1px solid #ccc&#39;&gt;AWS EBS&lt;/td&gt;&lt;td style=&#39;padding:3px;border:1px solid #ccc&#39;&gt;&lt;code&gt;ebs.csi.aws.com&lt;/code&gt;&lt;/td&gt;&lt;td style=&#39;padding:3px;border:1px solid #ccc&#39;&gt;RWO&lt;/td&gt;&lt;td style=&#39;padding:3px;border:1px solid #ccc&#39;&gt;Block&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#39;padding:3px;border:1px solid #ccc&#39;&gt;AWS EFS&lt;/td&gt;&lt;td style=&#39;padding:3px;border:1px solid #ccc&#39;&gt;&lt;code&gt;efs.csi.aws.com&lt;/code&gt;&lt;/td&gt;&lt;td style=&#39;padding:3px;border:1px solid #ccc&#39;&gt;RWX, ROX, RWO&lt;/td&gt;&lt;td style=&#39;padding:3px;border:1px solid #ccc&#39;&gt;NFS&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#39;padding:3px;border:1px solid #ccc&#39;&gt;NetApp Trident&lt;/td&gt;&lt;td style=&#39;padding:3px;border:1px solid #ccc&#39;&gt;&lt;code&gt;csi.trident.netapp.io&lt;/code&gt;&lt;/td&gt;&lt;td style=&#39;padding:3px;border:1px solid #ccc&#39;&gt;RWO, RWX, ROX&lt;/td&gt;&lt;td style=&#39;padding:3px;border:1px solid #ccc&#39;&gt;Block / NFS&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#39;padding:3px;border:1px solid #ccc&#39;&gt;Ceph (Rook)&lt;/td&gt;&lt;td style=&#39;padding:3px;border:1px solid #ccc&#39;&gt;&lt;code&gt;rook-ceph.rbd.csi.ceph.com&lt;/code&gt;&lt;/td&gt;&lt;td style=&#39;padding:3px;border:1px solid #ccc&#39;&gt;RWO, RWX&lt;/td&gt;&lt;td style=&#39;padding:3px;border:1px solid #ccc&#39;&gt;Block / FS&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#39;padding:3px;border:1px solid #ccc&#39;&gt;NFS (generic)&lt;/td&gt;&lt;td style=&#39;padding:3px;border:1px solid #ccc&#39;&gt;&lt;code&gt;nfs.csi.k8s.io&lt;/code&gt;&lt;/td&gt;&lt;td style=&#39;padding:3px;border:1px solid #ccc&#39;&gt;RWO, RWX, ROX&lt;/td&gt;&lt;td style=&#39;padding:3px;border:1px solid #ccc&#39;&gt;NFS&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;overflow=fill;rounded=1;whiteSpace=wrap;fillColor=#FAFAFA;strokeColor=#9E9E9E;" vertex="1" parent="1">
          <mxGeometry x="810" y="700" width="710" height="150" as="geometry" />
        </mxCell>
        <!-- ===== PV LIFECYCLE ===== -->
        <mxCell id="st-lc-title" value="PV Lifecycle" style="text;html=1;fontSize=12;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="890" width="200" height="20" as="geometry" />
        </mxCell>
        <mxCell id="st-lc-avail" value="Available" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C8E6C9;strokeColor=#2E7D32;fontSize=10;fontStyle=1;" vertex="1" parent="1">
