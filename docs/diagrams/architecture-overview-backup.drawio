        <mxCell id="ly4" parent="1" style="shape=process;whiteSpace=wrap;html=1;fillColor=#CE93D8;strokeColor=#8E24AA;fontSize=12;fontStyle=1;size=0.04;shadow=1;" value="Deployment / StatefulSet" vertex="1">
