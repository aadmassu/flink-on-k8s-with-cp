        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="cfk-admission-ref" name="Reference — CFK Operator Admission">
    <mxGraphModel dx="1600" dy="1400" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <!-- Title -->
        <mxCell id="adm-title" value="CFK Operator — Admission, TLS &amp; Reconciliation" style="text;html=1;fontSize=22;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="250" y="15" width="600" height="40" as="geometry" />
        </mxCell>
        <mxCell id="adm-subtitle" value="How CFK validates custom resources, secures the webhook with TLS, and reconciles desired state" style="text;html=1;fontSize=11;fontStyle=2;align=center;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="200" y="50" width="700" height="25" as="geometry" />
        </mxCell>
        <!-- ===== 1. TLS BETWEEN API SERVER AND WEBHOOK ===== -->
        <mxCell id="tls-group" value="1. Webhook TLS — How the API Server Trusts the Webhook" style="shape=mxgraph.gcp2.standard_rectangle;fillColor=#FFF3E0;strokeColor=#E65100;fontStyle=1;fontSize=13;verticalAlign=top;spacingTop=5;rounded=1;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="90" width="1500" height="250" as="geometry" />
        </mxCell>
        <mxCell id="tls-api" value="kube-apiserver" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#1565C0;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="140" width="150" height="50" as="geometry" />
        </mxCell>
        <mxCell id="tls-arrow" style="rounded=1;strokeColor=#E65100;strokeWidth=3;" edge="1" parent="1" source="tls-api" target="tls-webhook">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="tls-arrow-l" value="HTTPS POST /confluent-operator/validate&#xa;(mutual trust via caBundle)" style="edgeLabel;fontSize=9;fillColor=none;fontStyle=1;labelBackgroundColor=none;" connectable="0" vertex="1" parent="tls-arrow">
          <mxGeometry relative="1" as="geometry">
            <mxPoint y="-15" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="tls-webhook" value="CFK Operator Pod&#xa;(webhook server :8443)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CE93D8;strokeColor=#8E24AA;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="550" y="140" width="190" height="50" as="geometry" />
        </mxCell>
        <mxCell id="tls-secret" value="Secret: confluent-operator-serving-cert&#xa;fullchain.pem | privkey.pem | cacerts.pem&#xa;(mounted via directoryPathInContainer)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;fontSize=9;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="550" y="200" width="280" height="45" as="geometry" />
        </mxCell>
        <mxCell id="tls-certmgr" value="cert-manager&#xa;Certificate CR" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#F9A825;fontSize=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="550" y="260" width="120" height="40" as="geometry" />
        </mxCell>
        <mxCell id="tls-issuer" value="Self-Signed&#xa;Issuer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#F9A825;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="700" y="260" width="90" height="40" as="geometry" />
        </mxCell>
        <mxCell id="tls-cm-secret" style="rounded=1;strokeColor=#F9A825;strokeWidth=1;" edge="1" parent="1" source="tls-certmgr" target="tls-secret">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="tls-cm-secret-l" value="creates &amp;&#xa;auto-renews" style="edgeLabel;fontSize=7;fillColor=none;" connectable="0" vertex="1" parent="tls-cm-secret">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="-30" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="tls-cm-issuer" style="rounded=1;strokeColor=#F9A825;" edge="1" parent="1" source="tls-certmgr" target="tls-issuer">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="tls-cm-issuer-l" value="signs with" style="edgeLabel;fontSize=7;fillColor=none;" connectable="0" vertex="1" parent="tls-cm-issuer">
          <mxGeometry relative="1" as="geometry">
            <mxPoint y="-8" as="offset" />
          </mxGeometry>
        </mxCell>
        <!-- caBundle explanation -->
        <mxCell id="tls-vwc" value="ValidatingWebhookConfiguration" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1BEE7;strokeColor=#8E24AA;fontSize=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="220" width="230" height="40" as="geometry" />
        </mxCell>
        <mxCell id="tls-vwc-detail" value="caBundle: &lt;base64 CA cert&gt;&#xa;← API server uses this to verify&#xa;   the webhook&#39;s TLS certificate" style="text;html=1;fontSize=9;align=left;spacingLeft=5;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="80" y="265" width="250" height="40" as="geometry" />
        </mxCell>
        <mxCell id="tls-vwc-arrow" style="rounded=1;strokeColor=#8E24AA;dashed=1;" edge="1" parent="1" source="tls-api" target="tls-vwc">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="tls-vwc-arrow-l" value="reads caBundle" style="edgeLabel;fontSize=7;fillColor=none;" connectable="0" vertex="1" parent="tls-vwc-arrow">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="-15" as="offset" />
          </mxGeometry>
        </mxCell>
        <!-- TLS flow explanation -->
        <mxCell id="tls-explain" value="&lt;b&gt;How it works:&lt;/b&gt;&lt;br&gt;1. cert-manager creates the TLS secret (auto-renewed)&lt;br&gt;2. Volume projection mounts it as fullchain.pem / privkey.pem / cacerts.pem into the operator pod&lt;br&gt;3. The operator starts an HTTPS server on :8443 using those certs&lt;br&gt;4. The ValidatingWebhookConfiguration contains the &lt;b&gt;caBundle&lt;/b&gt; (CA cert, base64-encoded)&lt;br&gt;5. When API server receives a Kafka/KRaft/SR/etc. CR, it POSTs to the webhook over HTTPS&lt;br&gt;6. API server validates the webhook&#39;s TLS cert against the caBundle — if it matches, trust is established" style="text;html=1;fontSize=9;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="880" y="130" width="620" height="100" as="geometry" />
        </mxCell>
        <mxCell id="tls-san-note" value="&lt;b&gt;SAN requirement:&lt;/b&gt; The cert must include &lt;code&gt;confluent-operator.&amp;lt;namespace&amp;gt;.svc&lt;/code&gt; as a DNS SAN,&#xa;because that&#39;s the service name the API server connects to." style="text;html=1;fontSize=9;fontStyle=2;fontColor=#C62828;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="880" y="240" width="580" height="25" as="geometry" />
        </mxCell>
        <!-- ===== 2. ADMISSION FLOW ===== -->
        <mxCell id="adm-flow" value="2. Admission Flow — What Happens When You Apply a CR" style="shape=mxgraph.gcp2.standard_rectangle;fillColor=#E3F2FD;strokeColor=#1565C0;fontStyle=1;fontSize=13;verticalAlign=top;spacingTop=5;rounded=1;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="360" width="1500" height="230" as="geometry" />
        </mxCell>
        <!-- Steps -->
        <mxCell id="adm-user" value="User / ArgoCD" style="shape=actor;whiteSpace=wrap;html=1;fillColor=#C8E6C9;strokeColor=#2E7D32;fontSize=9;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="70" y="410" width="50" height="45" as="geometry" />
        </mxCell>
        <mxCell id="adm-user-cmd" value="kubectl apply -f&#xa;kafka.yaml" style="text;html=1;fontSize=8;fontStyle=2;fontFamily=Courier New;align=center;" vertex="1" parent="1">
          <mxGeometry x="50" y="460" width="100" height="20" as="geometry" />
        </mxCell>
        <mxCell id="adm-api" value="kube-apiserver" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#1565C0;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="200" y="405" width="140" height="45" as="geometry" />
        </mxCell>
        <mxCell id="adm-mutate" value="Mutating&#xa;Admission" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0E0E0;strokeColor=#9E9E9E;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="420" y="405" width="110" height="45" as="geometry" />
        </mxCell>
        <mxCell id="adm-mutate-note" value="(CFK does not use&#xa;a MutatingWebhook)" style="text;html=1;fontSize=8;fontStyle=2;fontColor=#999;align=center;" vertex="1" parent="1">
          <mxGeometry x="415" y="455" width="120" height="20" as="geometry" />
        </mxCell>
        <mxCell id="adm-validate" value="ValidatingWebhook&#xa;confluent-operator&#xa;(:8443 HTTPS)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CE93D8;strokeColor=#8E24AA;fontSize=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="610" y="395" width="160" height="60" as="geometry" />
        </mxCell>
        <mxCell id="adm-reject" value="REJECT&#xa;(error to user)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFCDD2;strokeColor=#C62828;fontSize=9;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="660" y="500" width="100" height="35" as="geometry" />
        </mxCell>
        <mxCell id="adm-etcd" value="etcd&#xa;(CR stored)" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#CFD8DC;strokeColor=#546E7A;fontSize=10;fontStyle=1;size=8;" vertex="1" parent="1">
          <mxGeometry x="860" y="400" width="100" height="55" as="geometry" />
        </mxCell>
        <mxCell id="adm-watch" value="CFK Operator&#xa;(controller loop)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CE93D8;strokeColor=#8E24AA;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1050" y="405" width="150" height="45" as="geometry" />
        </mxCell>
        <mxCell id="adm-resources" value="K8s Resources&#xa;Created" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#1565C0;fontSize=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1290" y="405" width="120" height="45" as="geometry" />
        </mxCell>
        <mxCell id="adm-resources-detail" value="StatefulSet, Pods,&#xa;Services, ConfigMaps,&#xa;PVCs, Routes..." style="text;html=1;fontSize=8;fontStyle=2;fontColor=#666;align=center;" vertex="1" parent="1">
          <mxGeometry x="1280" y="455" width="140" height="30" as="geometry" />
        </mxCell>
        <!-- Flow arrows -->
        <mxCell id="adm-fa1" style="rounded=1;strokeColor=#333;strokeWidth=2;" edge="1" parent="1" source="adm-user" target="adm-api">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="adm-fa1-l" value="1" style="edgeLabel;fontSize=10;fontStyle=1;fillColor=#E3F2FD;labelBackgroundColor=none;" connectable="0" vertex="1" parent="adm-fa1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint y="-12" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="adm-fa2" style="rounded=1;strokeColor=#333;strokeWidth=2;" edge="1" parent="1" source="adm-api" target="adm-mutate">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="adm-fa2-l" value="2" style="edgeLabel;fontSize=10;fontStyle=1;fillColor=#E0E0E0;labelBackgroundColor=none;" connectable="0" vertex="1" parent="adm-fa2">
          <mxGeometry relative="1" as="geometry">
            <mxPoint y="-12" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="adm-fa3" style="rounded=1;strokeColor=#333;strokeWidth=2;" edge="1" parent="1" source="adm-mutate" target="adm-validate">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="adm-fa3-l" value="3" style="edgeLabel;fontSize=10;fontStyle=1;fillColor=#E1BEE7;labelBackgroundColor=none;" connectable="0" vertex="1" parent="adm-fa3">
          <mxGeometry relative="1" as="geometry">
            <mxPoint y="-12" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="adm-fa3-reject" style="rounded=1;strokeColor=#C62828;dashed=1;" edge="1" parent="1" source="adm-validate" target="adm-reject">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="adm-fa3-reject-l" value="invalid" style="edgeLabel;fontSize=8;fontColor=#C62828;fillColor=none;" connectable="0" vertex="1" parent="adm-fa3-reject">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="-15" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="adm-fa4" style="rounded=1;strokeColor=#333;strokeWidth=2;" edge="1" parent="1" source="adm-validate" target="adm-etcd">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="adm-fa4-l" value="4 valid" style="edgeLabel;fontSize=10;fontStyle=1;fillColor=#CFD8DC;labelBackgroundColor=none;" connectable="0" vertex="1" parent="adm-fa4">
          <mxGeometry relative="1" as="geometry">
            <mxPoint y="-12" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="adm-fa5" style="rounded=1;strokeColor=#8E24AA;strokeWidth=2;dashed=1;dashPattern=8 4;" edge="1" parent="1" source="adm-etcd" target="adm-watch">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="adm-fa5-l" value="5 watch" style="edgeLabel;fontSize=10;fontStyle=1;fillColor=#E1BEE7;labelBackgroundColor=none;" connectable="0" vertex="1" parent="adm-fa5">
          <mxGeometry relative="1" as="geometry">
            <mxPoint y="-12" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="adm-fa6" style="rounded=1;strokeColor=#333;strokeWidth=2;" edge="1" parent="1" source="adm-watch" target="adm-resources">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="adm-fa6-l" value="6 create" style="edgeLabel;fontSize=10;fontStyle=1;fillColor=#BBDEFB;labelBackgroundColor=none;" connectable="0" vertex="1" parent="adm-fa6">
          <mxGeometry relative="1" as="geometry">
            <mxPoint y="-12" as="offset" />
          </mxGeometry>
        </mxCell>
        <!-- ===== 3. WHAT CFK VALIDATES ===== -->
        <mxCell id="adm-checks" value="3. What CFK ValidatingWebhook Checks" style="shape=mxgraph.gcp2.standard_rectangle;fillColor=#F3E5F5;strokeColor=#8E24AA;fontStyle=1;fontSize=13;verticalAlign=top;spacingTop=5;rounded=1;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="610" width="1500" height="210" as="geometry" />
        </mxCell>
        <mxCell id="adm-checks-table" value="&lt;table style=&#39;font-size:10px;border-collapse:collapse;width:100%&#39;&gt;&lt;tr style=&#39;background:#E1BEE7;font-weight:bold&#39;&gt;&lt;td style=&#39;padding:4px;border:1px solid #8E24AA&#39;&gt;CR Type&lt;/td&gt;&lt;td style=&#39;padding:4px;border:1px solid #8E24AA&#39;&gt;Validations Performed&lt;/td&gt;&lt;td style=&#39;padding:4px;border:1px solid #8E24AA&#39;&gt;Example Rejection&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#39;padding:4px;border:1px solid #ccc;font-weight:bold&#39;&gt;Kafka&lt;/td&gt;&lt;td style=&#39;padding:4px;border:1px solid #ccc&#39;&gt;Replica count, listener config, KRaft dependency, storage resize (up only)&lt;/td&gt;&lt;td style=&#39;padding:4px;border:1px solid #ccc;color:#C62828;font-style:italic&#39;&gt;&quot;authentication type &#39;plain&#39; not supported with OAuth&quot;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#39;padding:4px;border:1px solid #ccc;font-weight:bold&#39;&gt;KRaftController&lt;/td&gt;&lt;td style=&#39;padding:4px;border:1px solid #ccc&#39;&gt;Odd replica count (1,3,5), no scale-down, TLS consistency&lt;/td&gt;&lt;td style=&#39;padding:4px;border:1px solid #ccc;color:#C62828;font-style:italic&#39;&gt;&quot;replicas must be odd for quorum consensus&quot;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#39;padding:4px;border:1px solid #ccc;font-weight:bold&#39;&gt;SchemaRegistry&lt;/td&gt;&lt;td style=&#39;padding:4px;border:1px solid #ccc&#39;&gt;Kafka dependency configured, auth matches listener&lt;/td&gt;&lt;td style=&#39;padding:4px;border:1px solid #ccc;color:#C62828;font-style:italic&#39;&gt;&quot;dependencies.kafka.bootstrapEndpoint is required&quot;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#39;padding:4px;border:1px solid #ccc;font-weight:bold&#39;&gt;Connect&lt;/td&gt;&lt;td style=&#39;padding:4px;border:1px solid #ccc&#39;&gt;Kafka dependency, image specified for custom connectors&lt;/td&gt;&lt;td style=&#39;padding:4px;border:1px solid #ccc;color:#C62828;font-style:italic&#39;&gt;&quot;dependencies.kafka is required&quot;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#39;padding:4px;border:1px solid #ccc;font-weight:bold&#39;&gt;ControlCenter&lt;/td&gt;&lt;td style=&#39;padding:4px;border:1px solid #ccc&#39;&gt;Single replica only, Kafka + SR + Connect deps&lt;/td&gt;&lt;td style=&#39;padding:4px;border:1px solid #ccc;color:#C62828;font-style:italic&#39;&gt;&quot;replicas must be 1 for ControlCenter&quot;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#39;padding:4px;border:1px solid #ccc;font-weight:bold&#39;&gt;StatefulSet/Pod deletion&lt;/td&gt;&lt;td style=&#39;padding:4px;border:1px solid #ccc&#39;&gt;Prevents unsafe deletes and evictions of Kafka/KRaft pods&lt;/td&gt;&lt;td style=&#39;padding:4px;border:1px solid #ccc;color:#C62828;font-style:italic&#39;&gt;&quot;cannot evict pod kafka-0: under-replicated partitions&quot;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;overflow=fill;rounded=1;whiteSpace=wrap;fillColor=#FAFAFA;strokeColor=#8E24AA;" vertex="1" parent="1">
          <mxGeometry x="55" y="640" width="1470" height="170" as="geometry" />
        </mxCell>
        <!-- ===== 4. RECONCILIATION LOOP ===== -->
        <mxCell id="adm-recon" value="4. Reconciliation Loop — The Operator Never Stops Watching" style="shape=mxgraph.gcp2.standard_rectangle;fillColor=#E8F5E9;strokeColor=#2E7D32;fontStyle=1;fontSize=13;verticalAlign=top;spacingTop=5;rounded=1;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="840" width="1500" height="260" as="geometry" />
        </mxCell>
        <!-- Desired -->
        <mxCell id="adm-desired" value="Desired State&#xa;(CR in etcd)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C8E6C9;strokeColor=#2E7D32;fontSize=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="885" width="130" height="40" as="geometry" />
        </mxCell>
        <mxCell id="adm-desired-eg" value="replicas: 3&#xa;version: 8.1.1" style="text;html=1;fontSize=8;fontStyle=2;fontFamily=Courier New;fontColor=#666;align=left;spacingLeft=5;" vertex="1" parent="1">
          <mxGeometry x="80" y="928" width="130" height="20" as="geometry" />
        </mxCell>
        <!-- Operator -->
        <mxCell id="adm-op" value="CFK Operator&#xa;Reconcile()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CE93D8;strokeColor=#8E24AA;fontSize=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="310" y="885" width="130" height="40" as="geometry" />
        </mxCell>
        <!-- Compare -->
        <mxCell id="adm-compare" value="Compare&#xa;desired vs actual" style="shape=rhombus;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#F9A825;fontSize=9;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="530" y="875" width="130" height="60" as="geometry" />
        </mxCell>
        <!-- Actual -->
        <mxCell id="adm-actual" value="Actual State&#xa;(live K8s resources)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#1565C0;fontSize=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="310" y="975" width="150" height="40" as="geometry" />
        </mxCell>
        <mxCell id="adm-actual-eg" value="e.g. StatefulSet has 2 pods&#xa;(one crashed)" style="text;html=1;fontSize=8;fontStyle=2;fontFamily=Courier New;fontColor=#666;align=left;spacingLeft=5;" vertex="1" parent="1">
          <mxGeometry x="310" y="1018" width="170" height="20" as="geometry" />
        </mxCell>
        <!-- Drift -->
        <mxCell id="adm-drift-yes" value="Drift!" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFCDD2;strokeColor=#C62828;fontSize=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="740" y="870" width="80" height="30" as="geometry" />
        </mxCell>
        <mxCell id="adm-drift-no" value="No drift — requeue" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C8E6C9;strokeColor=#2E7D32;fontSize=9;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="740" y="915" width="120" height="25" as="geometry" />
        </mxCell>
        <!-- Actions -->
        <mxCell id="adm-actions" value="Operator Actions" style="shape=mxgraph.gcp2.standard_rectangle;fillColor=#FFF3E0;strokeColor=#E65100;fontStyle=1;fontSize=10;verticalAlign=top;spacingTop=3;rounded=1;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="910" y="865" width="580" height="80" as="geometry" />
        </mxCell>
