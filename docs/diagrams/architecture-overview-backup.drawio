  <diagram id="eks-managed" name="Reference — EKS (Managed K8s)">
    <mxGraphModel dx="1600" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="eks-title" value="Amazon EKS — Managed Kubernetes Architecture" style="text;html=1;fontSize=22;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="250" y="15" width="700" height="40" as="geometry" />
        </mxCell>
        <mxCell id="eks-subtitle" value="AWS manages the control plane — you manage the worker nodes and your workloads" style="text;html=1;fontSize=11;fontStyle=2;align=center;fontColor=#666;" vertex="1" parent="1">
          <mxGeometry x="300" y="50" width="600" height="20" as="geometry" />
        </mxCell>
        <!-- ===== AWS MANAGED CONTROL PLANE ===== -->
        <mxCell id="eks-cp" value="" style="shape=mxgraph.gcp2.standard_rectangle;fillColor=#E3F2FD;strokeColor=#1565C0;fontStyle=1;fontSize=14;verticalAlign=top;spacingTop=5;rounded=1;arcSize=8;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="85" width="1500" height="290" as="geometry" />
        </mxCell>
        <mxCell id="eks-cp-title" value="Control Plane — MANAGED BY AWS" style="text;html=1;fontSize=14;fontStyle=1;align=left;fontColor=#1565C0;" vertex="1" parent="1">
          <mxGeometry x="55" y="92" width="350" height="22" as="geometry" />
        </mxCell>
        <mxCell id="eks-cp-note" value="Multi-AZ, auto-scaling, auto-patched, auto-upgraded. You never SSH into these." style="text;html=1;fontSize=9;fontStyle=2;fontColor=#666;align=left;spacingLeft=5;" vertex="1" parent="1">
          <mxGeometry x="55" y="115" width="500" height="15" as="geometry" />
