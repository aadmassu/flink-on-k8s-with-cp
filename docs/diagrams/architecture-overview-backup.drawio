        <mxCell id="cmcp-s4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8BBD0;strokeColor=#C62828;fontSize=8;" value="controlcenter-tls" vertex="1">
          <mxGeometry height="30" width="100" x="500" y="330" as="geometry" />
        </mxCell>
        <mxCell id="cmcp-s5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8BBD0;strokeColor=#C62828;fontSize=8;" value="kraftcontroller-tls" vertex="1">
          <mxGeometry height="30" width="110" x="615" y="330" as="geometry" />
        </mxCell>
        <mxCell id="cmcp-comps" parent="1" style="shape=mxgraph.gcp2.standard_rectangle;fillColor=#E8EAF6;strokeColor=#3949AB;fontStyle=1;fontSize=11;verticalAlign=top;spacingTop=5;rounded=1;arcSize=8;" value="CP Component CRs (reference the TLS secrets)" vertex="1">
