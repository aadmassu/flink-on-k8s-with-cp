        <!-- Comparison table -->
        <mxCell id="eks-compare" value="&lt;table style=&#39;font-size:10px;border-collapse:collapse;width:100%&#39;&gt;&lt;tr style=&#39;background:#E3F2FD;font-weight:bold&#39;&gt;&lt;td style=&#39;padding:5px;border:1px solid #1565C0&#39;&gt;Component&lt;/td&gt;&lt;td style=&#39;padding:5px;border:1px solid #1565C0&#39;&gt;Self-Managed K8s&lt;/td&gt;&lt;td style=&#39;padding:5px;border:1px solid #1565C0&#39;&gt;EKS (Managed)&lt;/td&gt;&lt;td style=&#39;padding:5px;border:1px solid #1565C0&#39;&gt;EKS + Fargate&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#39;padding:5px;border:1px solid #ccc;font-weight:bold&#39;&gt;API Server&lt;/td&gt;&lt;td style=&#39;padding:5px;border:1px solid #ccc;color:#C62828&#39;&gt;You install &amp; manage&lt;/td&gt;&lt;td style=&#39;padding:5px;border:1px solid #ccc;color:#2E7D32&#39;&gt;AWS manages&lt;/td&gt;&lt;td style=&#39;padding:5px;border:1px solid #ccc;color:#2E7D32&#39;&gt;AWS manages&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#39;padding:5px;border:1px solid #ccc;font-weight:bold&#39;&gt;etcd&lt;/td&gt;&lt;td style=&#39;padding:5px;border:1px solid #ccc;color:#C62828&#39;&gt;You manage (backup, HA)&lt;/td&gt;&lt;td style=&#39;padding:5px;border:1px solid #ccc;color:#2E7D32&#39;&gt;AWS manages&lt;/td&gt;&lt;td style=&#39;padding:5px;border:1px solid #ccc;color:#2E7D32&#39;&gt;AWS manages&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#39;padding:5px;border:1px solid #ccc;font-weight:bold&#39;&gt;Worker Nodes&lt;/td&gt;&lt;td style=&#39;padding:5px;border:1px solid #ccc;color:#C62828&#39;&gt;You provision &amp; patch&lt;/td&gt;&lt;td style=&#39;padding:5px;border:1px solid #ccc;color:#E65100&#39;&gt;You choose instance type, AWS provisions&lt;/td&gt;&lt;td style=&#39;padding:5px;border:1px solid #ccc;color:#2E7D32&#39;&gt;No nodes — serverless&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#39;padding:5px;border:1px solid #ccc;font-weight:bold&#39;&gt;Networking&lt;/td&gt;&lt;td style=&#39;padding:5px;border:1px solid #ccc;color:#C62828&#39;&gt;You install CNI&lt;/td&gt;&lt;td style=&#39;padding:5px;border:1px solid #ccc;color:#2E7D32&#39;&gt;AWS VPC CNI (Pods get VPC IPs)&lt;/td&gt;&lt;td style=&#39;padding:5px;border:1px solid #ccc;color:#2E7D32&#39;&gt;AWS VPC CNI&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#39;padding:5px;border:1px solid #ccc;font-weight:bold&#39;&gt;Storage&lt;/td&gt;&lt;td style=&#39;padding:5px;border:1px solid #ccc;color:#C62828&#39;&gt;You install CSI drivers&lt;/td&gt;&lt;td style=&#39;padding:5px;border:1px solid #ccc;color:#2E7D32&#39;&gt;EBS CSI + EFS CSI (add-ons)&lt;/td&gt;&lt;td style=&#39;padding:5px;border:1px solid #ccc;color:#2E7D32&#39;&gt;EFS only (no EBS)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#39;padding:5px;border:1px solid #ccc;font-weight:bold&#39;&gt;Load Balancer&lt;/td&gt;&lt;td style=&#39;padding:5px;border:1px solid #ccc;color:#C62828&#39;&gt;You configure&lt;/td&gt;&lt;td style=&#39;padding:5px;border:1px solid #ccc;color:#2E7D32&#39;&gt;AWS LB Controller → ALB/NLB&lt;/td&gt;&lt;td style=&#39;padding:5px;border:1px solid #ccc;color:#2E7D32&#39;&gt;Same&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#39;padding:5px;border:1px solid #ccc;font-weight:bold&#39;&gt;Upgrades&lt;/td&gt;&lt;td style=&#39;padding:5px;border:1px solid #ccc;color:#C62828&#39;&gt;Manual (risky)&lt;/td&gt;&lt;td style=&#39;padding:5px;border:1px solid #ccc;color:#2E7D32&#39;&gt;One-click control plane upgrade&lt;/td&gt;&lt;td style=&#39;padding:5px;border:1px solid #ccc;color:#2E7D32&#39;&gt;One-click&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#39;padding:5px;border:1px solid #ccc;font-weight:bold&#39;&gt;Cost&lt;/td&gt;&lt;td style=&#39;padding:5px;border:1px solid #ccc&#39;&gt;Infra + ops staff&lt;/td&gt;&lt;td style=&#39;padding:5px;border:1px solid #ccc&#39;&gt;$0.10/hr/cluster + EC2&lt;/td&gt;&lt;td style=&#39;padding:5px;border:1px solid #ccc&#39;&gt;$0.10/hr + per-Pod pricing&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;overflow=fill;rounded=1;whiteSpace=wrap;fillColor=#FAFAFA;strokeColor=#9E9E9E;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="770" width="1100" height="280" as="geometry" />
        </mxCell>
      </root>
