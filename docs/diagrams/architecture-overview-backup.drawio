          <mxGeometry x="65" y="665" width="120" height="30" as="geometry" />
        </mxCell>
        <mxCell id="st-dyn-sc" value="StorageClass: gp3&#xa;provisioner: ebs.csi" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#F9A825;fontSize=9;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="230" y="665" width="120" height="30" as="geometry" />
        </mxCell>
        <mxCell id="st-dyn-csi" value="CSI Driver&#xa;(ebs.csi.aws.com)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CFD8DC;strokeColor=#546E7A;fontSize=9;" vertex="1" parent="1">
