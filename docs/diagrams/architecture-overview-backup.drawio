  <diagram id="k8s-workloads-ref" name="Reference — Deployments vs StatefulSets">
    <mxGraphModel dx="1425" dy="777" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="wl-title" parent="1" style="text;html=1;fontSize=22;fontStyle=1;align=center;verticalAlign=middle;" value="Deployments, ReplicaSets, StatefulSets &amp; Services" vertex="1">
          <mxGeometry height="40" width="700" x="390" y="15" as="geometry" />
        </mxCell>
        <mxCell id="dep-group" parent="1" style="shape=mxgraph.gcp2.standard_rectangle;fillColor=#E3F2FD;strokeColor=#1565C0;fontStyle=1;fontSize=13;verticalAlign=top;spacingTop=5;rounded=1;arcSize=3;" value="Deployment + ReplicaSet + Pods + Service" vertex="1">
          <mxGeometry height="380" width="1260" x="40" y="70" as="geometry" />
        </mxCell>
        <mxCell id="dep-desc" parent="1" style="text;html=1;fontSize=10;align=left;spacingLeft=5;" value="A &lt;b&gt;Deployment&lt;/b&gt; manages a &lt;b&gt;ReplicaSet&lt;/b&gt;, which manages &lt;b&gt;Pods&lt;/b&gt;. Pods are interchangeable — no stable identity.&lt;br&gt;A &lt;b&gt;Service&lt;/b&gt; (ClusterIP) provides a stable network endpoint. On update, a new ReplicaSet is created for rolling deployment." vertex="1">
          <mxGeometry height="35" width="700" x="50" y="95" as="geometry" />
        </mxCell>
        <mxCell id="dep-deploy" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#1565C0;fontSize=10;fontStyle=1;align=left;spacingLeft=8;" value="Deployment&#xa;(schema-registry)&#xa;replicas: 2&#xa;strategy: RollingUpdate" vertex="1">
          <mxGeometry height="70" width="180" x="60" y="142.5" as="geometry" />
        </mxCell>
        <mxCell id="dep-rs" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C5CAE9;strokeColor=#3949AB;fontSize=10;fontStyle=1;align=left;spacingLeft=8;" value="ReplicaSet&#xa;(schema-registry-7b4f9c)&#xa;replicas: 2 / 2 ready" vertex="1">
          <mxGeometry height="55" width="200" x="320" y="150" as="geometry" />
        </mxCell>
        <mxCell id="dep-pod1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#F9A825;fontSize=9;align=left;spacingLeft=5;" value="Pod: sr-7b4f9c-abc12&#xa;IP: 10.244.1.5&#xa;(ephemeral, replaceable)" vertex="1">
          <mxGeometry height="45" width="170" x="600" y="140" as="geometry" />
        </mxCell>
        <mxCell id="dep-pod2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#F9A825;fontSize=9;align=left;spacingLeft=5;" value="Pod: sr-7b4f9c-def34&#xa;IP: 10.244.2.8&#xa;(ephemeral, replaceable)" vertex="1">
          <mxGeometry height="45" width="170" x="600" y="195" as="geometry" />
        </mxCell>
        <mxCell id="dep-svc" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C8E6C9;strokeColor=#2E7D32;fontSize=10;fontStyle=1;align=left;spacingLeft=8;" value="Service (ClusterIP)&#xa;schemaregistry:8081&#xa;selector: app=schema-registry" vertex="1">
          <mxGeometry height="55" width="220" x="870" y="155" as="geometry" />
        </mxCell>
        <mxCell id="dep-a1" edge="1" parent="1" source="dep-deploy" style="rounded=1;strokeColor=#1565C0;strokeWidth=2;" target="dep-rs">
