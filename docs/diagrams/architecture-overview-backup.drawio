        <mxCell id="sts-a3a" edge="1" parent="1" source="sts-hsvc" style="rounded=1;strokeColor=#2E7D32;dashed=1;" target="sts-dns0">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="sts-a3b" edge="1" parent="1" source="sts-hsvc" style="rounded=1;strokeColor=#2E7D32;dashed=1;" target="sts-dns1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="sts-a3c" edge="1" parent="1" source="sts-hsvc" style="rounded=1;strokeColor=#2E7D32;dashed=1;" target="sts-dns2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="sts-chars" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#8E24AA;fontSize=9;align=left;spacingLeft=8;verticalAlign=top;spacingTop=8;" value="&lt;b&gt;StatefulSet characteristics:&lt;/b&gt;&lt;br&gt;• Pods have &lt;b&gt;stable names&lt;/b&gt; — ordinal index (kafka-0, kafka-1, kafka-2)&lt;br&gt;• &lt;b&gt;Stable network identity&lt;/b&gt; via headless Service + per-Pod DNS&lt;br&gt;• &lt;b&gt;Stable storage&lt;/b&gt; — each Pod gets its own PVC (survives restarts)&lt;br&gt;• &lt;b&gt;Ordered&lt;/b&gt; creation (0→1→2) and deletion (2→1→0)&lt;br&gt;• If kafka-1 is rescheduled, it reconnects to PVC data-kafka-1&lt;br&gt;• Use for: Kafka, KRaft, databases, ZooKeeper — anything stateful" vertex="1">
          <mxGeometry height="110" width="320" x="695" y="730" as="geometry" />
        </mxCell>
        <mxCell id="sts-resched" parent="1" style="text;html=1;fontSize=9;fontStyle=3;fontColor=#8E24AA;align=left;" value="Pod rescheduled → same name, same PVC, new IP (DNS updates automatically)" vertex="1">
          <mxGeometry height="15" width="380" x="310" y="740" as="geometry" />
        </mxCell>
        <mxCell id="wl-compare" parent="1" style="text;html=1;overflow=fill;rounded=1;whiteSpace=wrap;fillColor=#FAFAFA;strokeColor=#9E9E9E;" value="&lt;table style=&#39;font-size:10px;border-collapse:collapse;width:100%&#39;&gt;&lt;tr style=&#39;background:#E3F2FD;font-weight:bold&#39;&gt;&lt;td style=&#39;padding:5px;border:1px solid #1565C0&#39;&gt;&lt;/td&gt;&lt;td style=&#39;padding:5px;border:1px solid #1565C0&#39;&gt;Deployment&lt;/td&gt;&lt;td style=&#39;padding:5px;border:1px solid #1565C0&#39;&gt;StatefulSet&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#39;padding:5px;border:1px solid #ccc;font-weight:bold&#39;&gt;Pod names&lt;/td&gt;&lt;td style=&#39;padding:5px;border:1px solid #ccc&#39;&gt;Random hash (sr-7b4f9c-abc12)&lt;/td&gt;&lt;td style=&#39;padding:5px;border:1px solid #ccc&#39;&gt;Ordinal (kafka-0, kafka-1)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#39;padding:5px;border:1px solid #ccc;font-weight:bold&#39;&gt;Network identity&lt;/td&gt;&lt;td style=&#39;padding:5px;border:1px solid #ccc&#39;&gt;Via Service (shared VIP)&lt;/td&gt;&lt;td style=&#39;padding:5px;border:1px solid #ccc&#39;&gt;Per-Pod DNS via headless Service&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#39;padding:5px;border:1px solid #ccc;font-weight:bold&#39;&gt;Storage&lt;/td&gt;&lt;td style=&#39;padding:5px;border:1px solid #ccc&#39;&gt;Shared or none&lt;/td&gt;&lt;td style=&#39;padding:5px;border:1px solid #ccc&#39;&gt;Per-Pod PVC (volumeClaimTemplate)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#39;padding:5px;border:1px solid #ccc;font-weight:bold&#39;&gt;Scaling order&lt;/td&gt;&lt;td style=&#39;padding:5px;border:1px solid #ccc&#39;&gt;Any order (parallel)&lt;/td&gt;&lt;td style=&#39;padding:5px;border:1px solid #ccc&#39;&gt;Sequential (0→1→2)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#39;padding:5px;border:1px solid #ccc;font-weight:bold&#39;&gt;Update strategy&lt;/td&gt;&lt;td style=&#39;padding:5px;border:1px solid #ccc&#39;&gt;New ReplicaSet (rolling)&lt;/td&gt;&lt;td style=&#39;padding:5px;border:1px solid #ccc&#39;&gt;In-place rolling (reverse order)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#39;padding:5px;border:1px solid #ccc;font-weight:bold&#39;&gt;Use case&lt;/td&gt;&lt;td style=&#39;padding:5px;border:1px solid #ccc&#39;&gt;Stateless (SR, Connect, CMF, operators)&lt;/td&gt;&lt;td style=&#39;padding:5px;border:1px solid #ccc&#39;&gt;Stateful (Kafka, KRaft, ControlCenter)&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" vertex="1">
          <mxGeometry height="200" width="700" x="50" y="890" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="k8s-dns-ref" name="Reference — K8s Networking &amp; CoreDNS">
    <mxGraphModel dx="1377" dy="751" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="dns-title" parent="1" style="text;html=1;fontSize=22;fontStyle=1;align=center;verticalAlign=middle;" value="Kubernetes Networking &amp; CoreDNS" vertex="1">
          <mxGeometry height="40" width="500" x="300" y="15" as="geometry" />
        </mxCell>
        <mxCell id="dns-net" parent="1" style="shape=mxgraph.gcp2.standard_rectangle;fillColor=#E3F2FD;strokeColor=#1565C0;fontStyle=1;fontSize=13;verticalAlign=top;spacingTop=5;rounded=1;arcSize=8;" value="1. Pod Networking Basics" vertex="1">
          <mxGeometry height="240" width="1500" x="40" y="70" as="geometry" />
        </mxCell>
        <mxCell id="dns-net-desc" parent="1" style="text;html=1;fontSize=10;align=left;spacingLeft=5;" value="Every Pod gets its own IP address from the cluster&#39;s Pod CIDR (e.g. 10.244.0.0/16).&lt;br&gt;All Pods can reach all other Pods directly by IP — no NAT. This is the &lt;b&gt;flat network model&lt;/b&gt;.&lt;br&gt;The CNI plugin (Calico, OVN-Kubernetes, Cilium) implements this by programming routes on each node." vertex="1">
          <mxGeometry height="45" width="700" x="50" y="95" as="geometry" />
        </mxCell>
        <mxCell id="dns-node1" parent="1" style="shape=mxgraph.gcp2.standard_rectangle;fillColor=#FFE0B2;strokeColor=#E65100;fontStyle=1;fontSize=10;verticalAlign=top;spacingTop=3;rounded=1;arcSize=10;" value="Node A" vertex="1">
          <mxGeometry height="130" width="300" x="60" y="150" as="geometry" />
        </mxCell>
        <mxCell id="dns-pod1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#F9A825;fontSize=9;" value="Pod A&#xa;10.244.1.5" vertex="1">
          <mxGeometry height="30" width="90" x="80" y="175" as="geometry" />
        </mxCell>
        <mxCell id="dns-pod2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#F9A825;fontSize=9;" value="Pod B&#xa;10.244.1.6" vertex="1">
          <mxGeometry height="30" width="90" x="80" y="240" as="geometry" />
        </mxCell>
        <mxCell id="dns-node2" parent="1" style="shape=mxgraph.gcp2.standard_rectangle;fillColor=#FFE0B2;strokeColor=#E65100;fontStyle=1;fontSize=10;verticalAlign=top;spacingTop=3;rounded=1;arcSize=10;" value="Node B" vertex="1">
          <mxGeometry height="75" width="250" x="420" y="150" as="geometry" />
        </mxCell>
        <mxCell id="dns-pod3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#F9A825;fontSize=9;" value="Pod C&#xa;10.244.2.8" vertex="1">
          <mxGeometry height="30" width="90" x="450" y="175" as="geometry" />
        </mxCell>
        <mxCell id="dns-cross" edge="1" parent="1" source="dns-pod1" style="rounded=1;strokeColor=#E65100;strokeWidth=2;" target="dns-pod3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="dns-cross-l" connectable="0" parent="dns-cross" style="edgeLabel;fontSize=8;fillColor=none;labelBackgroundColor=none;" value="direct Pod-to-Pod (no NAT, CNI routes)" vertex="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="-110" y="-20" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="dns-cidr" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;fontSize=9;align=left;spacingLeft=8;verticalAlign=top;spacingTop=5;" value="&lt;b&gt;CIDR ranges:&lt;/b&gt;&lt;br&gt;Pod CIDR: 10.244.0.0/16 (each node gets a /24)&lt;br&gt;Service CIDR: 10.96.0.0/12 (ClusterIP range)&lt;br&gt;Node network: whatever the infrastructure provides" vertex="1">
          <mxGeometry height="70" width="300" x="730" y="145" as="geometry" />
        </mxCell>
        <mxCell id="dns-coredns" parent="1" style="shape=mxgraph.gcp2.standard_rectangle;fillColor=#F3E5F5;strokeColor=#8E24AA;fontStyle=1;fontSize=13;verticalAlign=top;spacingTop=5;rounded=1;arcSize=8;" value="2. CoreDNS — The Cluster DNS Server" vertex="1">
          <mxGeometry height="400" width="1500" x="40" y="350" as="geometry" />
        </mxCell>
        <mxCell id="dns-coredns-desc" parent="1" style="text;html=1;fontSize=10;align=left;spacingLeft=5;" value="CoreDNS runs as a Deployment in &lt;code&gt;kube-system&lt;/code&gt; namespace. Every Pod&#39;s &lt;code&gt;/etc/resolv.conf&lt;/code&gt;&lt;br&gt;points to the CoreDNS Service IP. CoreDNS watches the K8s API for Services and Endpoints." vertex="1">
          <mxGeometry height="30" width="600" x="50" y="375" as="geometry" />
        </mxCell>
        <mxCell id="dns-app" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C8E6C9;strokeColor=#2E7D32;fontSize=10;fontStyle=1;" value="App Pod" vertex="1">
          <mxGeometry height="35" width="90" x="60" y="450" as="geometry" />
        </mxCell>
        <mxCell id="dns-resolv" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;fontSize=8;align=left;spacingLeft=5;fontFamily=Courier New;" value="/etc/resolv.conf&#xa;nameserver 10.96.0.10&#xa;search ns.svc.cluster.local&#xa;       svc.cluster.local&#xa;       cluster.local" vertex="1">
          <mxGeometry height="70" width="200" x="60" y="510" as="geometry" />
        </mxCell>
        <mxCell id="dns-server" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1BEE7;strokeColor=#8E24AA;fontSize=10;fontStyle=1;" value="CoreDNS&#xa;(10.96.0.10)&#xa;kube-system ns" vertex="1">
          <mxGeometry height="50" width="130" x="340" y="442.5" as="geometry" />
        </mxCell>
        <mxCell id="dns-app-a" edge="1" parent="1" source="dns-app" style="rounded=1;strokeColor=#8E24AA;strokeWidth=2;" target="dns-server">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="dns-app-a-l" connectable="0" parent="dns-app-a" style="edgeLabel;fontSize=8;fillColor=none;labelBackgroundColor=none;" value="DNS query" vertex="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="-15" y="-17" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="dns-records" parent="1" style="text;html=1;overflow=fill;rounded=1;whiteSpace=wrap;fillColor=#FAFAFA;strokeColor=#8E24AA;" value="&lt;table style=&#39;font-size:9px;border-collapse:collapse;width:100%&#39;&gt;&lt;tr style=&#39;background:#E1BEE7;font-weight:bold&#39;&gt;&lt;td style=&#39;padding:4px;border:1px solid #8E24AA&#39;&gt;Query&lt;/td&gt;&lt;td style=&#39;padding:4px;border:1px solid #8E24AA&#39;&gt;Record Type&lt;/td&gt;&lt;td style=&#39;padding:4px;border:1px solid #8E24AA&#39;&gt;Response&lt;/td&gt;&lt;td style=&#39;padding:4px;border:1px solid #8E24AA&#39;&gt;Explanation&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#39;padding:4px;border:1px solid #ccc;font-family:Courier New&#39;&gt;kafka.confluent-dev.svc.cluster.local&lt;/td&gt;&lt;td style=&#39;padding:4px;border:1px solid #ccc&#39;&gt;A&lt;/td&gt;&lt;td style=&#39;padding:4px;border:1px solid #ccc&#39;&gt;10.96.45.12 (ClusterIP)&lt;/td&gt;&lt;td style=&#39;padding:4px;border:1px solid #ccc&#39;&gt;Regular Service → returns ClusterIP&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#39;padding:4px;border:1px solid #ccc;font-family:Courier New&#39;&gt;kafka-headless.confluent-dev.svc.cluster.local&lt;/td&gt;&lt;td style=&#39;padding:4px;border:1px solid #ccc&#39;&gt;A (multiple)&lt;/td&gt;&lt;td style=&#39;padding:4px;border:1px solid #ccc&#39;&gt;10.244.1.5, 10.244.2.8, 10.244.3.2&lt;/td&gt;&lt;td style=&#39;padding:4px;border:1px solid #ccc&#39;&gt;Headless Service → returns all Pod IPs&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#39;padding:4px;border:1px solid #ccc;font-family:Courier New&#39;&gt;kafka-0.kafka-headless.confluent-dev.svc.cluster.local&lt;/td&gt;&lt;td style=&#39;padding:4px;border:1px solid #ccc&#39;&gt;A&lt;/td&gt;&lt;td style=&#39;padding:4px;border:1px solid #ccc&#39;&gt;10.244.1.5&lt;/td&gt;&lt;td style=&#39;padding:4px;border:1px solid #ccc&#39;&gt;StatefulSet Pod → specific Pod IP&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#39;padding:4px;border:1px solid #ccc;font-family:Courier New&#39;&gt;kafka (short name from same namespace)&lt;/td&gt;&lt;td style=&#39;padding:4px;border:1px solid #ccc&#39;&gt;A&lt;/td&gt;&lt;td style=&#39;padding:4px;border:1px solid #ccc&#39;&gt;10.96.45.12&lt;/td&gt;&lt;td style=&#39;padding:4px;border:1px solid #ccc&#39;&gt;Search path appends .confluent-dev.svc.cluster.local&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#39;padding:4px;border:1px solid #ccc;font-family:Courier New&#39;&gt;google.com&lt;/td&gt;&lt;td style=&#39;padding:4px;border:1px solid #ccc&#39;&gt;A&lt;/td&gt;&lt;td style=&#39;padding:4px;border:1px solid #ccc&#39;&gt;(forwarded to upstream)&lt;/td&gt;&lt;td style=&#39;padding:4px;border:1px solid #ccc&#39;&gt;Not a cluster name → CoreDNS forwards upstream&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" vertex="1">
          <mxGeometry height="175" width="980" x="540" y="415" as="geometry" />
        </mxCell>
        <mxCell id="dns-format" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#8E24AA;fontSize=9;align=left;spacingLeft=8;verticalAlign=top;spacingTop=5;" value="&lt;b&gt;DNS naming convention:&lt;/b&gt;&lt;br&gt;&lt;code&gt;&amp;lt;service&amp;gt;.&amp;lt;namespace&amp;gt;.svc.cluster.local&lt;/code&gt; — Service ClusterIP&lt;br&gt;&lt;code&gt;&amp;lt;pod&amp;gt;.&amp;lt;headless-svc&amp;gt;.&amp;lt;namespace&amp;gt;.svc.cluster.local&lt;/code&gt; — StatefulSet Pod&lt;br&gt;&lt;br&gt;&lt;b&gt;Short names work within the same namespace&lt;/b&gt; (search path in resolv.conf):&lt;br&gt;&lt;code&gt;kafka&lt;/code&gt; resolves to &lt;code&gt;kafka.confluent-dev.svc.cluster.local&lt;/code&gt;" vertex="1">
          <mxGeometry height="90" width="450" x="60" y="600" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="cm-cfk-op-ref" name="Reference — cert-manager + CFK Operator">
    <mxGraphModel dx="826" dy="450" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="cmop-title" parent="1" style="text;html=1;fontSize=22;fontStyle=1;align=center;verticalAlign=middle;" value="cert-manager Integration — CFK Operator Webhook" vertex="1">
          <mxGeometry height="40" width="700" x="120" y="50" as="geometry" />
        </mxCell>
        <mxCell id="cmop-subtitle" parent="1" style="text;html=1;fontSize=11;fontStyle=2;align=center;fontColor=#666;" value="CFK expects PKCS12 keystores named .jks — cert-manager produces .p12 — projected volume bridges the gap" vertex="1">
          <mxGeometry height="20" width="700" x="110" y="80" as="geometry" />
        </mxCell>
        <mxCell id="cmop-issuer" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#F9A825;fontSize=10;fontStyle=1;" value="Issuer&#xa;(self-signed)" vertex="1">
          <mxGeometry height="40" width="110" x="40" y="185" as="geometry" />
        </mxCell>
        <mxCell id="cmop-cert" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#F9A825;fontSize=9;fontStyle=1;align=left;spacingLeft=8;" value="Certificate CR&#xa;confluent-operator-serving-cert&#xa;keystores.pkcs12.create: true" vertex="1">
          <mxGeometry height="55" width="230" x="220" y="175" as="geometry" />
        </mxCell>
        <mxCell id="cmop-secret" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE4EC;strokeColor=#C62828;fontSize=9;align=left;spacingLeft=8;fontFamily=Courier New;" value="Secret: confluent-operator-serving-cert&#xa;├── tls.crt&#xa;├── tls.key&#xa;├── ca.crt&#xa;├── keystore.p12  ← PKCS12&#xa;└── truststore.p12 ← PKCS12" vertex="1">
          <mxGeometry height="90" width="260" x="550" y="157.5" as="geometry" />
        </mxCell>
        <mxCell id="cmop-pwsecret" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE4EC;strokeColor=#C62828;fontSize=9;align=left;spacingLeft=8;fontFamily=Courier New;" value="Secret: cfk-jks-password&#xa;└── password: changeit" vertex="1">
          <mxGeometry height="35" width="230" x="220" y="270" as="geometry" />
        </mxCell>
        <mxCell id="cmop-pwfile" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE4EC;strokeColor=#C62828;fontSize=9;align=left;spacingLeft=8;fontFamily=Courier New;" value="Secret: cfk-jks-password-file&#xa;└── jksPassword.txt: jksPassword=changeit" vertex="1">
          <mxGeometry height="35" width="260" x="550" y="270" as="geometry" />
        </mxCell>
        <mxCell id="cmop-a1" edge="1" parent="1" source="cmop-issuer" style="rounded=1;strokeColor=#F9A825;strokeWidth=2;" target="cmop-cert">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="cmop-a1-l" connectable="0" parent="cmop-a1" style="edgeLabel;fontSize=8;fillColor=none;labelBackgroundColor=none;" value="signs" vertex="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="-15" y="-19" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="cmop-a2" edge="1" parent="1" source="cmop-cert" style="rounded=1;strokeColor=#C62828;strokeWidth=2;" target="cmop-secret">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="cmop-a2-l" connectable="0" parent="cmop-a2" style="edgeLabel;fontSize=8;fillColor=none;labelBackgroundColor=none;" value="creates &amp; auto-renews" vertex="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="-40" y="-17" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="cmop-a3" edge="1" parent="1" source="cmop-cert" style="rounded=1;strokeColor=#C62828;dashed=1;" target="cmop-pwsecret">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="cmop-a3-l" connectable="0" parent="cmop-a3" style="edgeLabel;fontSize=7;fillColor=none;" value="reads password" vertex="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint y="-10" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="cmop-proj" parent="1" style="shape=mxgraph.gcp2.standard_rectangle;fillColor=#E8F5E9;strokeColor=#2E7D32;fontStyle=1;fontSize=11;verticalAlign=top;spacingTop=5;rounded=1;arcSize=8;" value="Projected Volume (in Helm values)" vertex="1">
          <mxGeometry height="160" width="770" x="40" y="345" as="geometry" />
        </mxCell>
        <mxCell id="cmop-proj-src1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C8E6C9;strokeColor=#2E7D32;fontSize=9;align=left;spacingLeft=8;fontFamily=Courier New;" value="Source 1: confluent-operator-serving-cert&#xa;  keystore.p12 → keystore.jks&#xa;  truststore.p12 → truststore.jks" vertex="1">
          <mxGeometry height="50" width="310" x="60" y="385" as="geometry" />
        </mxCell>
        <mxCell id="cmop-proj-src2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C8E6C9;strokeColor=#2E7D32;fontSize=9;align=left;spacingLeft=8;fontFamily=Courier New;" value="Source 2: cfk-jks-password-file&#xa;  jksPassword.txt → jksPassword.txt" vertex="1">
          <mxGeometry height="40" width="310" x="60" y="445" as="geometry" />
        </mxCell>
        <mxCell id="cmop-mount" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;fontSize=9;align=left;spacingLeft=8;fontFamily=Courier New;fontStyle=1;" value="/mnt/webhook-certs/&#xa;├── keystore.jks      ← PKCS12 binary&#xa;├── truststore.jks    ← PKCS12 binary&#xa;└── jksPassword.txt   ← jksPassword=changeit" vertex="1">
          <mxGeometry height="70" width="340" x="460" y="375" as="geometry" />
        </mxCell>
        <mxCell id="cmop-proj-a" edge="1" parent="1" source="cmop-proj-src1" style="rounded=1;strokeColor=#2E7D32;strokeWidth=2;" target="cmop-mount">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="cmop-pod" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CE93D8;strokeColor=#8E24AA;fontSize=10;fontStyle=1;align=left;spacingLeft=8;" value="CFK Operator Pod&#xa;webhooks.tls.directoryPathInContainer: /mnt/webhook-certs&#xa;Starts HTTPS server on :8443 using the PKCS12 keystores" vertex="1">
          <mxGeometry height="55" width="360" x="450" y="555" as="geometry" />
        </mxCell>
        <mxCell id="cmop-pod-a" edge="1" parent="1" source="cmop-mount" style="rounded=1;strokeColor=#8E24AA;strokeWidth=2;" target="cmop-pod">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="cmop-pod-a-l" connectable="0" parent="cmop-pod-a" style="edgeLabel;fontSize=8;fillColor=none;labelBackgroundColor=none;" value="mounted&#xa;read-only" vertex="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint y="-35" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="cmop-api" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#1565C0;fontSize=11;fontStyle=1;" value="kube-apiserver" vertex="1">
          <mxGeometry height="40" width="140" x="560" y="675" as="geometry" />
        </mxCell>
        <mxCell id="cmop-vwc" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1BEE7;strokeColor=#8E24AA;fontSize=9;align=left;spacingLeft=8;" value="ValidatingWebhookConfiguration&#xa;caBundle: &lt;ca.crt base64&gt;" vertex="1">
          <mxGeometry height="40" width="240" x="130" y="675" as="geometry" />
        </mxCell>
        <mxCell id="cmop-api-a" edge="1" parent="1" source="cmop-api" style="rounded=1;strokeColor=#1565C0;strokeWidth=2;" target="cmop-pod">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="cmop-api-a-l" connectable="0" parent="cmop-api-a" style="edgeLabel;fontSize=8;fillColor=none;" value="HTTPS POST&#xa;(validates CR)" vertex="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint y="-13" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="cmop-api-vwc" edge="1" parent="1" source="cmop-api" style="rounded=1;strokeColor=#8E24AA;dashed=1;" target="cmop-vwc">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="cmop-api-vwc-l" connectable="0" parent="cmop-api-vwc" style="edgeLabel;fontSize=7;fillColor=none;labelBackgroundColor=none;" value="reads caBundle to verify TLS" vertex="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="-45" y="-20" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="cmop-finding" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFCDD2;strokeColor=#C62828;fontSize=9;fontStyle=2;align=left;spacingLeft=8;" value="&lt;b&gt;Key finding:&lt;/b&gt; CFK names the files .jks but parses them as PKCS12 internally. cert-manager&#39;s &lt;code&gt;keystores.jks&lt;/code&gt; produces&#xa;real Java KeyStore format which CFK rejects. Use &lt;code&gt;keystores.pkcs12&lt;/code&gt; instead and rename via projected volume." vertex="1">
          <mxGeometry height="45" width="500" x="130" y="750" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
