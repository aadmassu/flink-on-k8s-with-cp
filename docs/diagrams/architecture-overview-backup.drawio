        <mxCell id="st-lc-a2" style="rounded=1;strokeColor=#333;" edge="1" parent="1" source="st-lc-bound" target="st-lc-released">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="st-lc-a2-l" value="PVC deleted&#xa;(Retain)" style="edgeLabel;fontSize=7;fillColor=none;" connectable="0" vertex="1" parent="st-lc-a2">
          <mxGeometry relative="1" as="geometry">
            <mxPoint y="-8" as="offset" />
