        <mxCell id="ly3" parent="1" style="shape=process;whiteSpace=wrap;html=1;fillColor=#FFCCBC;strokeColor=#E65100;fontSize=12;fontStyle=1;size=0.04;shadow=1;" value="Pod (Container Runtime)" vertex="1">
