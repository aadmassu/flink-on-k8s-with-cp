        <mxCell id="sts-pod1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#F9A825;fontSize=9;align=left;spacingLeft=5;" value="Pod: kafka-1&#xa;IP: 10.244.2.8" vertex="1">
