        <mxCell id="ly7-cfk" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;fontSize=9;align=left;spacingLeft=8;verticalAlign=top;spacingTop=5;" value="&lt;b&gt;Users / Developers&lt;/b&gt; → Control Center UI (HTTPS)&lt;br&gt;&lt;b&gt;Azure DevOps CI/CD&lt;/b&gt; → CMF REST API (deploy Flink SQL jobs)&lt;br&gt;&lt;b&gt;External producers/consumers&lt;/b&gt; → Kafka brokers (SASL_SSL)" vertex="1">
