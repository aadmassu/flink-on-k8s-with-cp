        <mxCell id="ly3-cfk" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#E65100;fontSize=9;align=left;spacingLeft=8;verticalAlign=top;spacingTop=5;" value="&lt;b&gt;kafka-0, kafka-1, kafka-2&lt;/b&gt; — Confluent Server 8.1.1 (broker + MDS :8090)&lt;br&gt;&lt;b&gt;kraftcontroller-0/1/2&lt;/b&gt; — KRaft metadata quorum&lt;br&gt;&lt;b&gt;schemaregistry-*&lt;/b&gt;, &lt;b&gt;connect-*&lt;/b&gt;, &lt;b&gt;controlcenter-*&lt;/b&gt;, &lt;b&gt;cmf-*&lt;/b&gt;&lt;br&gt;&lt;b&gt;flink-session-dispatcher&lt;/b&gt; (JM), &lt;b&gt;flink-session-taskmanager&lt;/b&gt; (TMs)" vertex="1">
