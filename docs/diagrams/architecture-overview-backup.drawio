          <mxGeometry x="1380" y="95" width="110" height="25" as="geometry" />
        </mxCell>
        <mxCell id="eks-aws-badge-desc" value="HA, upgrades, patching,&#xa;etcd backup, scaling" style="text;html=1;fontSize=8;fontStyle=2;fontColor=#2E7D32;align=center;" vertex="1" parent="1">
          <mxGeometry x="1370" y="123" width="130" height="20" as="geometry" />
        </mxCell>
        <!-- API Server (managed) -->
        <mxCell id="eks-api" value="" style="shape=mxgraph.kubernetes.icon2;prIcon=api;fillColor=#1565C0;strokeColor=none;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="120" y="150" width="50" height="48" as="geometry" />
        </mxCell>
        <mxCell id="eks-api-l" value="API Server&#xa;(managed)" style="text;html=1;fontSize=10;fontStyle=1;align=center;" vertex="1" parent="1">
