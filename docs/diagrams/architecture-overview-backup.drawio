        <mxCell id="ly4-cfk" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#8E24AA;fontSize=9;align=left;spacingLeft=8;verticalAlign=top;spacingTop=5;" value="&lt;b&gt;StatefulSets:&lt;/b&gt; Kafka (3), KRaftController (3) — stable identity, per-Pod PVC&lt;br&gt;&lt;b&gt;Deployments:&lt;/b&gt; SchemaRegistry, Connect, ControlCenter, CMF,&lt;br&gt;    CFK Operator (2 HA), Flink Operator (2 HA),&lt;br&gt;    Flink JobManager, Flink TaskManagers" vertex="1">
