        <mxCell id="ly7" parent="1" style="shape=process;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#1565C0;fontSize=12;fontStyle=1;size=0.04;shadow=1;" value="Client Application / External Access" vertex="1">
