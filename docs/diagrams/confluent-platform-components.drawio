          <mxGeometry height="25" width="90" x="380" y="345" as="geometry" />
        </mxCell>
        <mxCell id="kb-raft01" edge="1" parent="1" source="kb-kr0" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#1565C0;strokeWidth=2;" target="kb-kr1">
