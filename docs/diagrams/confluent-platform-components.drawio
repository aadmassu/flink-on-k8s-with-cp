        <mxCell id="sr-pn1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;fontSize=9;align=left;spacingLeft=5;" value="&lt;b&gt;1&lt;/b&gt; Producer registers schema (or gets cached ID).&#xa;Schema Registry returns schema ID." vertex="1">
