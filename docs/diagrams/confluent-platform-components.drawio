  <diagram id="ksqldb" name="ksqlDB">
    <mxGraphModel dx="689" dy="375" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="ks-title" parent="1" style="text;html=1;fontSize=22;fontStyle=1;align=center;" value="ksqlDB — Stream Processing with SQL" vertex="1">
          <mxGeometry height="40" width="500" x="350" y="15" as="geometry" />
        </mxCell>
        <mxCell id="ks-broker" parent="1" style="shape=mxgraph.signs.tech.server_2;fillColor=#1565C0;strokeColor=none;shadow=1;" value="" vertex="1">
          <mxGeometry height="65" width="55" x="90" y="220" as="geometry" />
        </mxCell>
        <mxCell id="ks-broker-l" parent="1" style="text;html=1;fontSize=10;fontStyle=1;align=center;fontColor=#1565C0;" value="Kafka Brokers&#xa;(source topics)" vertex="1">
          <mxGeometry height="25" width="115" x="60" y="190" as="geometry" />
        </mxCell>
        <mxCell id="ks-server" parent="1" style="shape=mxgraph.gcp2.standard_rectangle;fillColor=#E0F7FA;strokeColor=#00838F;fontStyle=1;fontSize=12;verticalAlign=top;spacingTop=5;rounded=1;arcSize=3;shadow=1;" value="ksqlDB Server" vertex="1">
          <mxGeometry height="340" width="580" x="300" y="100" as="geometry" />
        </mxCell>
        <mxCell id="ks-engine" parent="1" style="shape=mxgraph.signs.tech.server_2;fillColor=#00838F;strokeColor=none;shadow=1;" value="" vertex="1">
          <mxGeometry height="55" width="45" x="520" y="140" as="geometry" />
        </mxCell>
        <mxCell id="ks-engine-l" parent="1" style="text;html=1;fontSize=10;fontStyle=1;align=center;fontColor=#00838F;" value="Query Engine" vertex="1">
          <mxGeometry height="15" width="90" x="500" y="198" as="geometry" />
        </mxCell>
        <mxCell id="ks-stream" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#B2EBF2;strokeColor=#00838F;fontSize=8;align=left;spacingLeft=5;fontFamily=Courier New;" value="CREATE STREAM orders_stream&#xa;(order_id VARCHAR, amount DOUBLE)&#xa;WITH (kafka_topic=&#39;orders&#39;, value_format=&#39;JSON&#39;);" vertex="1">
          <mxGeometry height="45" width="310" x="320" y="230" as="geometry" />
        </mxCell>
        <mxCell id="ks-stream-note" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F7FA;strokeColor=#00838F;fontSize=8;align=left;spacingLeft=5;" value="&lt;b&gt;STREAM&lt;/b&gt; = unbounded sequence of events.&#xa;Append-only, immutable. Backed by a Kafka topic." vertex="1">
          <mxGeometry height="40" width="230" x="640" y="230" as="geometry" />
        </mxCell>
        <mxCell id="ks-table" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#B2EBF2;strokeColor=#00838F;fontSize=8;align=left;spacingLeft=5;fontFamily=Courier New;" value="CREATE TABLE customer_table&#xa;(customer_id VARCHAR PRIMARY KEY, name VARCHAR)&#xa;WITH (kafka_topic=&#39;customers&#39;, value_format=&#39;JSON&#39;);" vertex="1">
          <mxGeometry height="45" width="310" x="320" y="290" as="geometry" />
        </mxCell>
        <mxCell id="ks-table-note" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F7FA;strokeColor=#00838F;fontSize=8;align=left;spacingLeft=5;" value="&lt;b&gt;TABLE&lt;/b&gt; = materialized view of latest value per key.&#xa;Upsert semantics. State stored in RocksDB." vertex="1">
          <mxGeometry height="40" width="230" x="640" y="290" as="geometry" />
        </mxCell>
        <mxCell id="ks-query" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#F9A825;fontSize=8;align=left;spacingLeft=5;fontFamily=Courier New;fontStyle=1;" value="CREATE STREAM enriched_orders AS&#xa;  SELECT o.order_id, o.amount, c.name&#xa;  FROM orders_stream o&#xa;  JOIN customer_table c ON o.customer_id = c.customer_id&#xa;  EMIT CHANGES;" vertex="1">
