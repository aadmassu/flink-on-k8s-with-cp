          <mxGeometry height="45" width="400" x="55" y="580" as="geometry" />
        </mxCell>
        <mxCell id="rp-when" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#F9A825;fontSize=9;align=left;spacingLeft=8;shadow=1;" value="&lt;b&gt;When to use REST Proxy:&lt;/b&gt;&lt;br&gt;- Apps that can&#39;t use native Kafka clients (browser, serverless, IoT)&lt;br&gt;- Quick ad-hoc produce/consume without installing client libraries&lt;br&gt;- Firewall constraints (only HTTP/443 allowed)&lt;br&gt;&lt;br&gt;&lt;b&gt;When NOT to use:&lt;/b&gt; High-throughput production workloads (use native clients)" vertex="1">
          <mxGeometry height="100" width="250" x="480" y="475" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
