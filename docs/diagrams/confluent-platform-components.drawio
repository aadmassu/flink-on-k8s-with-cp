        </mxCell>
        <mxCell id="kb-raft02" edge="1" parent="1" source="kb-kr0" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#1565C0;strokeWidth=2;" target="kb-kr2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="kb-raft02-l" connectable="0" parent="kb-raft02" style="edgeLabel;fontSize=8;fillColor=none;fontColor=#1565C0;" value="log replication" vertex="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="15" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="kb-raft12" edge="1" parent="1" source="kb-kr1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#1565C0;strokeWidth=1;dashed=1;" target="kb-kr2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="kb-raft12-l" connectable="0" parent="kb-raft12" style="edgeLabel;fontSize=8;fillColor=none;fontColor=#1565C0;" value="heartbeat / vote" vertex="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint y="10" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="kb-kr-note1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;fontSize=9;align=left;spacingLeft=5;shadow=1;" value="&lt;b&gt;What KRaft stores:&lt;/b&gt;&lt;br&gt;- Broker registrations&lt;br&gt;- Topic &amp; partition metadata&lt;br&gt;- Partition assignments&lt;br&gt;- ACLs &amp; quotas&lt;br&gt;- Cluster configuration" vertex="1">
          <mxGeometry height="80" width="180" x="60" y="390" as="geometry" />
        </mxCell>
        <mxCell id="kb-kr-note2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;fontSize=9;align=left;spacingLeft=5;shadow=1;" value="&lt;b&gt;Quorum rules:&lt;/b&gt;&lt;br&gt;- Majority must agree (2 of 3)&lt;br&gt;- Leader elected by vote&lt;br&gt;- Followers replicate log&lt;br&gt;- If leader dies, new election&lt;br&gt;- Odd number required (1,3,5)" vertex="1">
          <mxGeometry height="80" width="180" x="340" y="390" as="geometry" />
        </mxCell>
        <mxCell id="kb-brokers" parent="1" style="shape=mxgraph.gcp2.standard_rectangle;fillColor=#E8F5E9;strokeColor=#2E7D32;fontStyle=1;fontSize=13;verticalAlign=top;spacingTop=5;rounded=1;arcSize=4;shadow=1;" value="Broker Cluster (Data Plane)" vertex="1">
          <mxGeometry height="400" width="550" x="680" y="80" as="geometry" />
        </mxCell>
        <mxCell id="kb-b0" parent="1" style="shape=mxgraph.signs.tech.server_2;fillColor=#2E7D32;strokeColor=none;shadow=1;" value="" vertex="1">
          <mxGeometry height="60" width="50" x="770" y="140" as="geometry" />
        </mxCell>
        <mxCell id="kb-b0-l" parent="1" style="text;html=1;fontSize=10;fontStyle=1;align=center;fontColor=#2E7D32;" value="Broker-0" vertex="1">
          <mxGeometry height="15" width="80" x="755" y="205" as="geometry" />
        </mxCell>
        <mxCell id="kb-b0-parts" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C8E6C9;strokeColor=#2E7D32;fontSize=8;align=left;spacingLeft=5;" value="P0-Leader&#xa;P1-Follower&#xa;P2-Follower" vertex="1">
          <mxGeometry height="40" width="100" x="740" y="225" as="geometry" />
        </mxCell>
        <mxCell id="kb-b1" parent="1" style="shape=mxgraph.signs.tech.server_2;fillColor=#2E7D32;strokeColor=none;shadow=1;" value="" vertex="1">
          <mxGeometry height="60" width="50" x="930" y="140" as="geometry" />
        </mxCell>
        <mxCell id="kb-b1-l" parent="1" style="text;html=1;fontSize=10;fontStyle=1;align=center;fontColor=#2E7D32;" value="Broker-1" vertex="1">
          <mxGeometry height="15" width="80" x="915" y="205" as="geometry" />
        </mxCell>
        <mxCell id="kb-b1-parts" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C8E6C9;strokeColor=#2E7D32;fontSize=8;align=left;spacingLeft=5;" value="P0-Follower&#xa;P1-Leader&#xa;P2-Follower" vertex="1">
          <mxGeometry height="40" width="100" x="900" y="225" as="geometry" />
        </mxCell>
        <mxCell id="kb-b2" parent="1" style="shape=mxgraph.signs.tech.server_2;fillColor=#2E7D32;strokeColor=none;shadow=1;" value="" vertex="1">
          <mxGeometry height="60" width="50" x="1090" y="140" as="geometry" />
        </mxCell>
        <mxCell id="kb-b2-l" parent="1" style="text;html=1;fontSize=10;fontStyle=1;align=center;fontColor=#2E7D32;" value="Broker-2" vertex="1">
          <mxGeometry height="15" width="80" x="1075" y="205" as="geometry" />
        </mxCell>
        <mxCell id="kb-b2-parts" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C8E6C9;strokeColor=#2E7D32;fontSize=8;align=left;spacingLeft=5;" value="P0-Follower&#xa;P1-Follower&#xa;P2-Leader" vertex="1">
          <mxGeometry height="40" width="100" x="1060" y="225" as="geometry" />
        </mxCell>
        <mxCell id="kb-bb01" edge="1" parent="1" source="kb-b0" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#2E7D32;strokeWidth=1;dashed=1;" target="kb-b1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="kb-bb12" edge="1" parent="1" source="kb-b1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#2E7D32;strokeWidth=1;dashed=1;" target="kb-b2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="kb-bb-l" parent="1" style="text;fontSize=8;fontStyle=2;fontColor=#2E7D32;align=center;" value="partition replication (ISR)" vertex="1">
          <mxGeometry height="12" width="150" x="850" y="125" as="geometry" />
        </mxCell>
        <mxCell id="kb-b-note1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;fontSize=9;align=left;spacingLeft=5;shadow=1;" value="&lt;b&gt;Broker responsibilities:&lt;/b&gt;&lt;br&gt;- Accept produce requests&lt;br&gt;- Serve fetch requests&lt;br&gt;- Replicate partitions (ISR)&lt;br&gt;- Handle consumer group coordination&lt;br&gt;- Expose JMX metrics" vertex="1">
          <mxGeometry height="80" width="190" x="700" y="300" as="geometry" />
        </mxCell>
        <mxCell id="kb-b-note2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;fontSize=9;align=left;spacingLeft=5;shadow=1;" value="&lt;b&gt;Partition leadership:&lt;/b&gt;&lt;br&gt;Each partition has 1 leader and&lt;br&gt;N-1 followers (replication factor).&lt;br&gt;Leaders handle all reads/writes.&lt;br&gt;Followers replicate for fault tolerance." vertex="1">
          <mxGeometry height="80" width="200" x="920" y="300" as="geometry" />
        </mxCell>
        <mxCell id="kb-kr-b-arrow" edge="1" parent="1" source="kb-kraft" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#333;strokeWidth=3;" target="kb-brokers">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="kb-comm" parent="1" style="shape=mxgraph.gcp2.standard_rectangle;fillColor=#FAFAFA;strokeColor=#333;fontStyle=1;fontSize=11;verticalAlign=top;spacingTop=3;rounded=1;arcSize=10;shadow=1;" value="KRaft → Broker Communication" vertex="1">
          <mxGeometry height="170" width="1190" x="40" y="510" as="geometry" />
        </mxCell>
        <mxCell id="kb-comm1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;fontSize=9;align=left;spacingLeft=5;" value="&lt;b&gt;1. Broker Registration&lt;/b&gt;&lt;br&gt;On startup, each broker sends a BrokerRegistration&#xa;request to the active KRaft controller. KRaft assigns&#xa;a broker ID and adds it to the metadata log." vertex="1">
          <mxGeometry height="55" width="270" x="55" y="540" as="geometry" />
        </mxCell>
        <mxCell id="kb-comm2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;fontSize=9;align=left;spacingLeft=5;" value="&lt;b&gt;2. Metadata Push&lt;/b&gt;&lt;br&gt;KRaft leader pushes metadata updates (new topics,&#xa;partition reassignments, config changes) to all brokers&#xa;via the metadata log. Brokers apply changes locally." vertex="1">
          <mxGeometry height="55" width="270" x="340" y="540" as="geometry" />
        </mxCell>
        <mxCell id="kb-comm3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;fontSize=9;align=left;spacingLeft=5;" value="&lt;b&gt;3. Heartbeats&lt;/b&gt;&lt;br&gt;Brokers send periodic heartbeats to KRaft.&#xa;If a broker misses heartbeats, KRaft marks it&#xa;as offline and reassigns partition leadership." vertex="1">
          <mxGeometry height="55" width="270" x="625" y="540" as="geometry" />
        </mxCell>
        <mxCell id="kb-comm4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;fontSize=9;align=left;spacingLeft=5;" value="&lt;b&gt;4. Leader Election&lt;/b&gt;&lt;br&gt;When a partition leader fails, KRaft selects a new&#xa;leader from the ISR (in-sync replicas) and pushes&#xa;the update to all brokers. No ZooKeeper needed." vertex="1">
          <mxGeometry height="55" width="270" x="910" y="540" as="geometry" />
        </mxCell>
        <mxCell id="kb-comm5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#F9A825;fontSize=9;align=left;spacingLeft=5;fontStyle=2;" value="&lt;b&gt;Key difference from ZooKeeper:&lt;/b&gt; KRaft uses a single metadata log replicated via Raft consensus.&#xa;Brokers fetch metadata directly from the controller — no more split-brain, no ZK watches, faster failover." vertex="1">
          <mxGeometry height="35" width="600" x="55" y="620" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
