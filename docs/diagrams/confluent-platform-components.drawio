          </mxGeometry>
        </mxCell>
        <mxCell id="sr-c1-l" connectable="0" parent="sr-c1" style="edgeLabel;fontSize=12;fontStyle=1;fillColor=#C62828;fontColor=#FFF;labelBackgroundColor=none;" value="3" vertex="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="15" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="sr-c2" edge="1" parent="1" source="sr-consumer" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#C62828;strokeWidth=3;" target="sr-sr">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="sr-c2-l" connectable="0" parent="sr-c2" style="edgeLabel;fontSize=12;fontStyle=1;fillColor=#C62828;fontColor=#FFF;labelBackgroundColor=none;" value="4" vertex="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint y="-12" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="sr-cn1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE4EC;strokeColor=#C62828;fontSize=9;align=left;spacingLeft=5;" value="&lt;b&gt;3&lt;/b&gt; Consumer fetches bytes from broker.&#xa;Extracts schema ID from the first 5 bytes." vertex="1">
          <mxGeometry height="35" width="272.5" x="657.5" y="130" as="geometry" />
        </mxCell>
        <mxCell id="sr-cn2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE4EC;strokeColor=#C62828;fontSize=9;align=left;spacingLeft=5;" value="&lt;b&gt;4&lt;/b&gt; Consumer fetches schema by ID from Schema Registry&#xa;(cached locally after first fetch). Deserializes payload." vertex="1">
          <mxGeometry height="35" width="270" x="657.5" y="185" as="geometry" />
        </mxCell>
        <mxCell id="sr-k1" edge="1" parent="1" source="sr-connect" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#E65100;strokeWidth=3;" target="sr-broker">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="sr-k1-l" connectable="0" parent="sr-k1" style="edgeLabel;fontSize=12;fontStyle=1;fillColor=#E65100;fontColor=#FFF;labelBackgroundColor=none;" value="5" vertex="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="-15" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="sr-k2" edge="1" parent="1" source="sr-connect" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#E65100;strokeWidth=3;" target="sr-sr">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="300" y="583" />
              <mxPoint x="300" y="355" />
              <mxPoint x="458" y="355" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="sr-k2-l" connectable="0" parent="sr-k2" style="edgeLabel;fontSize=12;fontStyle=1;fillColor=#E65100;fontColor=#FFF;labelBackgroundColor=none;" value="6" vertex="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="-15" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="sr-kn1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#E65100;fontSize=9;align=left;spacingLeft=5;" value="&lt;b&gt;5&lt;/b&gt; Source connector produces to broker with schema.&#xa;Sink connector consumes from broker." vertex="1">
          <mxGeometry height="30" width="310" x="510" y="520" as="geometry" />
        </mxCell>
        <mxCell id="sr-kn2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#E65100;fontSize=9;align=left;spacingLeft=5;" value="&lt;b&gt;6&lt;/b&gt; Connect uses converters (AvroConverter, JsonSchemaConverter)&#xa;that interact with Schema Registry automatically." vertex="1">
          <mxGeometry height="30" width="310" x="510" y="560" as="geometry" />
        </mxCell>
        <mxCell id="sr-wire" parent="1" style="shape=mxgraph.gcp2.standard_rectangle;fillColor=#FAFAFA;strokeColor=#333;fontStyle=1;fontSize=11;verticalAlign=top;spacingTop=3;rounded=1;arcSize=10;shadow=1;" value="Wire Format (what the broker stores)" vertex="1">
          <mxGeometry height="100" width="530" x="55" y="670" as="geometry" />
        </mxCell>
        <mxCell id="sr-wire-diagram" parent="1" style="text;html=1;overflow=fill;rounded=1;whiteSpace=wrap;fillColor=#FAFAFA;strokeColor=none;" value="&lt;table style=&#39;font-size:11px;border-collapse:collapse;font-family:Courier New&#39;&gt;&lt;tr&gt;&lt;td style=&#39;padding:8px;border:2px solid #333;background:#E8F5E9;font-weight:bold&#39;&gt;0x00&lt;br&gt;(magic byte)&lt;/td&gt;&lt;td style=&#39;padding:8px;border:2px solid #333;background:#E3F2FD;font-weight:bold&#39;&gt;00 00 00 19&lt;br&gt;(schema ID = 25)&lt;/td&gt;&lt;td style=&#39;padding:8px;border:2px solid #333;background:#FFF3E0;font-weight:bold&#39;&gt;Avro / JSON / Protobuf binary payload&lt;br&gt;(the actual data)&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" vertex="1">
          <mxGeometry height="55" width="500" x="75" y="700" as="geometry" />
        </mxCell>
        <mxCell id="sr-insight" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#F9A825;fontSize=10;fontStyle=2;align=left;spacingLeft=8;shadow=1;" value="&lt;b&gt;Key insight:&lt;/b&gt; The broker NEVER reads or validates the schema. It stores raw bytes.&#xa;Schema enforcement happens entirely on the &lt;b&gt;client side&lt;/b&gt; (producer serializer / consumer deserializer)." vertex="1">
          <mxGeometry height="35" width="530" x="55" y="790" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
