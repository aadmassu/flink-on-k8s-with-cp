        <mxCell id="sr-p2-l" connectable="0" parent="sr-p2" style="edgeLabel;fontSize=12;fontStyle=1;fillColor=#2E7D32;fontColor=#FFF;labelBackgroundColor=none;" value="2" vertex="1">
