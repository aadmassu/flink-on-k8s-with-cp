          <mxGeometry height="200" width="510" x="50" y="520" as="geometry" />
        </mxCell>
        <mxCell id="c3-how" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#C62828;fontSize=9;align=left;spacingLeft=8;shadow=1;" value="&lt;b&gt;How Control Center collects metrics:&lt;/b&gt;&lt;br&gt;1. &lt;b&gt;Monitoring Interceptors&lt;/b&gt; on producers/consumers report to &lt;code&gt;_confluent-monitoring&lt;/code&gt; topic&lt;br&gt;2. Control Center &lt;b&gt;consumes&lt;/b&gt; from monitoring topics on the brokers&lt;br&gt;3. Queries &lt;b&gt;REST APIs&lt;/b&gt; on Connect (:8083), ksqlDB (:8088), Schema Registry (:8081)&lt;br&gt;4. Stores aggregated metrics in internal topics (&lt;code&gt;_confluent-command&lt;/code&gt;, &lt;code&gt;_confluent-metrics&lt;/code&gt;)" vertex="1">
          <mxGeometry height="80" width="480" x="580" y="520" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
