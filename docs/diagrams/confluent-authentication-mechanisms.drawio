        <mxCell id="deleg-worker-l" parent="1" style="text;html=1;fontSize=9;fontStyle=1;align=center;fontColor=#E65100;labelBackgroundColor=none;" value="Worker / Task&#xa;(uses delegation token)" vertex="1">
          <mxGeometry height="25" width="110" x="555" y="937.5" as="geometry" />
        </mxCell>
        <mxCell id="deleg-a1" edge="1" parent="1" source="deleg-client" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#F9A825;strokeWidth=2;labelBackgroundColor=none;" target="deleg-broker">
