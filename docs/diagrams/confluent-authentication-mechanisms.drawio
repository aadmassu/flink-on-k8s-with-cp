        </mxCell>
        <mxCell id="oauth-a4-l" connectable="0" parent="oauth-a4" style="edgeLabel;fontSize=8;fillColor=none;fontColor=#000000;fontStyle=1;labelBackgroundColor=none;" value="4 (JWKS)" vertex="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="-20" y="-20" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="oauth-steps" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;fontSize=8;align=left;spacingLeft=8;shadow=1;labelBackgroundColor=none;arcSize=5;" value="&lt;b&gt;1&lt;/b&gt; Client authenticates to IdP (client credentials grant)&lt;br&gt;&lt;b&gt;2&lt;/b&gt; IdP returns JWT access token&lt;br&gt;&lt;b&gt;3&lt;/b&gt; Client sends JWT to broker in SASL handshake&lt;br&gt;&lt;b&gt;4&lt;/b&gt; Broker validates JWT signature via JWKS endpoint&lt;br&gt;&lt;br&gt;&lt;b&gt;Modern standard.&lt;/b&gt; Token-based, short-lived. Integrates&#xa;with Okta, Azure AD, Keycloak. Used by FCB." vertex="1">
          <mxGeometry height="115" width="195" x="660" y="100" as="geometry" />
        </mxCell>
        <mxCell id="plain-group" parent="1" style="shape=mxgraph.gcp2.standard_rectangle;fillColor=#FFF3E0;strokeColor=#E65100;fontStyle=1;fontSize=13;verticalAlign=top;spacingTop=5;rounded=1;arcSize=8;shadow=1;labelBackgroundColor=none;" value="2. SASL/PLAIN (Username + Password)" vertex="1">
