          <mxGeometry height="18" width="290" x="560" y="418" as="geometry" />
        </mxCell>
        <mxCell id="ldap-group" parent="1" style="shape=mxgraph.gcp2.standard_rectangle;fillColor=#F3E5F5;strokeColor=#8E24AA;fontStyle=1;fontSize=13;verticalAlign=top;spacingTop=5;rounded=1;arcSize=8;shadow=1;labelBackgroundColor=none;" value="3. SASL/PLAIN with LDAP Backend" vertex="1">
