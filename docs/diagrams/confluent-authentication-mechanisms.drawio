        <mxCell id="kerb-steps" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;fontSize=8;align=left;spacingLeft=8;shadow=1;labelBackgroundColor=none;" value="&lt;b&gt;1&lt;/b&gt; Client requests TGT from KDC (AS-REQ)&lt;br&gt;&lt;b&gt;2&lt;/b&gt; KDC returns TGT + service ticket for kafka/broker@REALM&lt;br&gt;&lt;b&gt;3&lt;/b&gt; Client presents service ticket to broker (mutual auth)&lt;br&gt;&lt;br&gt;&lt;b&gt;No passwords over the wire.&lt;/b&gt; Uses tickets + keytabs.&#xa;Enterprise standard. Complex to set up (KDC, DNS, time sync)." vertex="1">
          <mxGeometry height="110" width="195" x="660" y="1165" as="geometry" />
        </mxCell>
