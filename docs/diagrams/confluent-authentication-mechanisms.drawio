        <mxCell id="deleg-worker" parent="1" style="shape=mxgraph.azure.user;fillColor=#E65100;strokeColor=none;shadow=1;labelBackgroundColor=none;" value="" vertex="1">
          <mxGeometry height="40" width="40" x="590" y="970" as="geometry" />
