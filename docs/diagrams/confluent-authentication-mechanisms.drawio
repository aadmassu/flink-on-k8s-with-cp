        <mxCell id="deleg-a2-l" connectable="0" parent="deleg-a2" style="edgeLabel;fontSize=8;fillColor=none;fontStyle=1;fontColor=#F9A825;labelBackgroundColor=none;" value="2 distribute token" vertex="1">
