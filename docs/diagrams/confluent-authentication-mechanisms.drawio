        </mxCell>
        <mxCell id="deleg-a3-l" connectable="0" parent="deleg-a3" style="edgeLabel;fontSize=8;fillColor=none;fontStyle=1;fontColor=#E65100;labelBackgroundColor=none;" value="3 authenticate&#xa;with token" vertex="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint y="-27" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="deleg-steps" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#F9A825;fontSize=8;align=left;spacingLeft=8;shadow=1;labelBackgroundColor=none;" value="&lt;b&gt;1&lt;/b&gt; Authenticated client requests a delegation token from broker&lt;br&gt;&lt;b&gt;2&lt;/b&gt; Client distributes token to workers (Spark, Flink, etc.)&lt;br&gt;&lt;b&gt;3&lt;/b&gt; Workers authenticate using the token (no Kerberos needed)&lt;br&gt;&lt;br&gt;&lt;b&gt;Use case:&lt;/b&gt; Distributed frameworks (Spark, Flink) where&#xa;sharing keytabs to every executor is impractical.&#xa;Token has an expiry and can be renewed." vertex="1">
          <mxGeometry height="115" width="195" x="660" y="950" as="geometry" />
        </mxCell>
        <mxCell id="compare" parent="1" style="text;html=1;overflow=fill;rounded=1;whiteSpace=wrap;fillColor=#FAFAFA;strokeColor=#9E9E9E;shadow=1;labelBackgroundColor=none;arcSize=7;" value="&lt;table style=&quot;font-size:9px;border-collapse:collapse;width:100%&quot;&gt;&lt;tbody&gt;&lt;tr style=&quot;background-image: initial; background-position: initial; background-size: initial; background-repeat: initial; background-attachment: initial; background-origin: initial; background-clip: initial; font-weight: bold;&quot;&gt;&lt;td style=&quot;padding:4px;border:1px solid #1565C0&quot;&gt;Mechanism&lt;/td&gt;&lt;td style=&quot;padding:4px;border:1px solid #1565C0&quot;&gt;Password Over Wire?&lt;/td&gt;&lt;td style=&quot;padding:4px;border:1px solid #1565C0&quot;&gt;External IdP?&lt;/td&gt;&lt;td style=&quot;padding:4px;border:1px solid #1565C0&quot;&gt;Complexity&lt;/td&gt;&lt;td style=&quot;padding:4px;border:1px solid #1565C0&quot;&gt;Best For&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:4px;border:1px solid #ccc;font-weight:bold&quot;&gt;GSSAPI (Kerberos)&lt;/td&gt;&lt;td style=&quot;padding:4px;border:1px solid #ccc;color:#2E7D32&quot;&gt;No (tickets)&lt;/td&gt;&lt;td style=&quot;padding:4px;border:1px solid #ccc&quot;&gt;KDC (AD)&lt;/td&gt;&lt;td style=&quot;padding:4px;border:1px solid #ccc;color:#C62828&quot;&gt;High&lt;/td&gt;&lt;td style=&quot;padding:4px;border:1px solid #ccc&quot;&gt;Enterprise with existing AD/Kerberos&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:4px;border:1px solid #ccc;font-weight:bold&quot;&gt;OAUTHBEARER&lt;/td&gt;&lt;td style=&quot;padding:4px;border:1px solid #ccc;color:#2E7D32&quot;&gt;No (JWT token)&lt;/td&gt;&lt;td style=&quot;padding:4px;border:1px solid #ccc&quot;&gt;Okta/AzureAD/Keycloak&lt;/td&gt;&lt;td style=&quot;padding:4px;border:1px solid #ccc;color:#F9A825&quot;&gt;Medium&lt;/td&gt;&lt;td style=&quot;padding:4px;border:1px solid #ccc&quot;&gt;Modern cloud-native, Confluent recommended&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:4px;border:1px solid #ccc;font-weight:bold&quot;&gt;PLAIN&lt;/td&gt;&lt;td style=&quot;padding:4px;border:1px solid #ccc;color:#C62828&quot;&gt;Yes (cleartext)&lt;/td&gt;&lt;td style=&quot;padding:4px;border:1px solid #ccc&quot;&gt;No (static JAAS)&lt;/td&gt;&lt;td style=&quot;padding:4px;border:1px solid #ccc;color:#2E7D32&quot;&gt;Low&lt;/td&gt;&lt;td style=&quot;padding:4px;border:1px solid #ccc&quot;&gt;Dev/test, Confluent Cloud API keys&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:4px;border:1px solid #ccc;font-weight:bold&quot;&gt;PLAIN + LDAP&lt;/td&gt;&lt;td style=&quot;padding:4px;border:1px solid #ccc;color:#C62828&quot;&gt;Yes (to broker)&lt;/td&gt;&lt;td style=&quot;padding:4px;border:1px solid #ccc&quot;&gt;LDAP/AD&lt;/td&gt;&lt;td style=&quot;padding:4px;border:1px solid #ccc;color:#F9A825&quot;&gt;Medium&lt;/td&gt;&lt;td style=&quot;padding:4px;border:1px solid #ccc&quot;&gt;Enterprise with LDAP, Confluent RBAC/MDS&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:4px;border:1px solid #ccc;font-weight:bold&quot;&gt;SCRAM&lt;/td&gt;&lt;td style=&quot;padding:4px;border:1px solid #ccc;color:#2E7D32&quot;&gt;No (challenge-response)&lt;/td&gt;&lt;td style=&quot;padding:4px;border:1px solid #ccc&quot;&gt;No (built-in)&lt;/td&gt;&lt;td style=&quot;padding:4px;border:1px solid #ccc;color:#2E7D32&quot;&gt;Low&lt;/td&gt;&lt;td style=&quot;padding:4px;border:1px solid #ccc&quot;&gt;Self-managed without external IdP&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:4px;border:1px solid #ccc;font-weight:bold&quot;&gt;Delegation Tokens&lt;/td&gt;&lt;td style=&quot;padding:4px;border:1px solid #ccc;color:#2E7D32&quot;&gt;No (token)&lt;/td&gt;&lt;td style=&quot;padding:4px;border:1px solid #ccc&quot;&gt;Piggybacks on primary&lt;/td&gt;&lt;td style=&quot;padding:4px;border:1px solid #ccc;color:#F9A825&quot;&gt;Medium&lt;/td&gt;&lt;td style=&quot;padding:4px;border:1px solid #ccc&quot;&gt;Spark/Flink distributed workers&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;" vertex="1">
          <mxGeometry height="140" width="580" x="900" y="70" as="geometry" />
        </mxCell>
        <mxCell id="sec-note" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFCDD2;strokeColor=#C62828;fontSize=9;fontStyle=2;align=left;spacingLeft=8;shadow=1;labelBackgroundColor=none;" value="&lt;b&gt;All SASL mechanisms should be used with TLS encryption (SASL_SSL listener).&lt;/b&gt;&#xa;SASL alone authenticates the client but does NOT encrypt the data in transit.&#xa;Without TLS, even SCRAM/Kerberos traffic can be sniffed for metadata." vertex="1">
          <mxGeometry height="45" width="450" x="900" y="310" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
