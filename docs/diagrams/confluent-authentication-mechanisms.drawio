          </mxGeometry>
        </mxCell>
        <mxCell id="ldap-a2" edge="1" parent="1" source="ldap-broker" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#8E24AA;strokeWidth=2;labelBackgroundColor=none;" target="ldap-server">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ldap-a2-l" connectable="0" parent="ldap-a2" style="edgeLabel;fontSize=10;fontStyle=1;fillColor=#8E24AA;fontColor=#000000;labelBackgroundColor=none;" value="2" vertex="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint y="-19" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="ldap-steps" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#8E24AA;fontSize=8;align=left;spacingLeft=8;shadow=1;labelBackgroundColor=none;" value="&lt;b&gt;1&lt;/b&gt; Client sends username + password (SASL/PLAIN)&lt;br&gt;&lt;b&gt;2&lt;/b&gt; Broker delegates auth to LDAP (LDAP bind with user creds)&lt;br&gt;&lt;br&gt;Same wire protocol as SASL/PLAIN but broker&#xa;validates against LDAP instead of a static JAAS file.&#xa;Confluent&#39;s MDS uses this for RBAC + LDAP groups." vertex="1">
          <mxGeometry height="100" width="210" x="640" y="525" as="geometry" />
        </mxCell>
        <mxCell id="scram-group" parent="1" style="shape=mxgraph.gcp2.standard_rectangle;fillColor=#E0F7FA;strokeColor=#00838F;fontStyle=1;fontSize=13;verticalAlign=top;spacingTop=5;rounded=1;arcSize=8;shadow=1;labelBackgroundColor=none;" value="4. SASL/SCRAM (Salted Challenge Response)" vertex="1">
          <mxGeometry height="200" width="820" x="50" y="700" as="geometry" />
        </mxCell>
        <mxCell id="scram-client" parent="1" style="shape=mxgraph.azure.user;fillColor=#00838F;strokeColor=none;shadow=1;labelBackgroundColor=none;" value="" vertex="1">
          <mxGeometry height="40" width="40" x="90" y="750" as="geometry" />
        </mxCell>
        <mxCell id="scram-client-l" parent="1" style="text;html=1;fontSize=9;fontStyle=1;align=center;fontColor=#00838F;labelBackgroundColor=none;" value="Client" vertex="1">
          <mxGeometry height="15" width="60" x="80" y="793" as="geometry" />
        </mxCell>
        <mxCell id="scram-broker" parent="1" style="shape=mxgraph.signs.tech.server_2;fillColor=#2E7D32;strokeColor=none;shadow=1;labelBackgroundColor=none;" value="" vertex="1">
          <mxGeometry height="55" width="50" x="410" y="743" as="geometry" />
        </mxCell>
        <mxCell id="scram-broker-l" parent="1" style="text;html=1;fontSize=9;fontStyle=1;align=center;fontColor=#2E7D32;labelBackgroundColor=none;" value="Kafka Broker&#xa;(stores salted hash)" vertex="1">
          <mxGeometry height="25" width="140" x="365" y="798" as="geometry" />
        </mxCell>
        <mxCell id="scram-a1" edge="1" parent="1" source="scram-client" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#00838F;strokeWidth=2;labelBackgroundColor=none;" target="scram-broker">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="scram-a1-l" connectable="0" parent="scram-a1" style="edgeLabel;fontSize=8;fillColor=none;fontStyle=1;fontColor=#00838F;labelBackgroundColor=none;" value="challenge-response&#xa;(4 round trips)" vertex="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="-40" y="-30" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="scram-steps" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F7FA;strokeColor=#00838F;fontSize=8;align=left;spacingLeft=8;shadow=1;labelBackgroundColor=none;arcSize=7;" value="SCRAM-SHA-256 or SCRAM-SHA-512.&lt;br&gt;&lt;br&gt;&lt;b&gt;Password NEVER sent over the wire.&lt;/b&gt;&lt;br&gt;Client and broker exchange nonces + salted proofs.&#xa;Broker stores only salted hash (not plaintext password).&lt;br&gt;&lt;br&gt;More secure than PLAIN. No external IdP required.&#xa;Users managed via &lt;code&gt;kafka-configs --alter --add-config&lt;/code&gt;.&#xa;Stored in ZooKeeper/KRaft metadata." vertex="1">
          <mxGeometry height="110" width="290" x="560" y="730" as="geometry" />
        </mxCell>
        <mxCell id="scram-flow" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#B2EBF2;strokeColor=#00838F;fontSize=8;align=left;spacingLeft=5;fontFamily=Courier New;labelBackgroundColor=none;" value="Client → Server: ClientFirst (username + nonce)&#xa;Server → Client: ServerFirst (salt + server nonce + iterations)&#xa;Client → Server: ClientFinal (salted proof)&#xa;Server → Client: ServerFinal (server signature = mutual auth)" vertex="1">
          <mxGeometry height="55" width="350" x="120" y="840" as="geometry" />
        </mxCell>
        <mxCell id="deleg-group" parent="1" style="shape=mxgraph.gcp2.standard_rectangle;fillColor=#FFF8E1;strokeColor=#F9A825;fontStyle=1;fontSize=13;verticalAlign=top;spacingTop=5;rounded=1;arcSize=8;shadow=1;labelBackgroundColor=none;" value="4. Delegation Tokens (SASL/SSL)" vertex="1">
          <mxGeometry height="200" width="820" x="50" y="920" as="geometry" />
        </mxCell>
        <mxCell id="deleg-client" parent="1" style="shape=mxgraph.azure.user;fillColor=#F9A825;strokeColor=none;shadow=1;labelBackgroundColor=none;" value="" vertex="1">
          <mxGeometry height="40" width="40" x="90" y="970" as="geometry" />
        </mxCell>
