        <mxCell id="oauth-a3" edge="1" parent="1" source="oauth-client" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#2E7D32;strokeWidth=2;labelBackgroundColor=none;" target="oauth-broker">
