        <mxCell id="mt-mtls-a1" edge="1" parent="1" source="mt-mtls-client" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#1565C0;strokeWidth=3;labelBackgroundColor=none;" target="mt-mtls-broker">
