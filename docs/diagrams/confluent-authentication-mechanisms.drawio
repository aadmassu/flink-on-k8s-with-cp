        <mxCell id="mt-std-a1-l" connectable="0" parent="mt-std-a1" style="edgeLabel;fontSize=8;fillColor=none;fontStyle=1;fontColor=#546E7A;labelBackgroundColor=none;" value="Client verifies server cert ✓&#xa;Server does NOT verify client ✗" vertex="1">
