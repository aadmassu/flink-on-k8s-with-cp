        <mxCell id="deleg-a1-l" connectable="0" parent="deleg-a1" style="edgeLabel;fontSize=8;fillColor=none;fontStyle=1;fontColor=#F9A825;labelBackgroundColor=none;" value="1 request token" vertex="1">
          <mxGeometry relative="1" as="geometry">
