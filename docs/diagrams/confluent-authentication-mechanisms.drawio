        <mxCell id="oauth-a4" edge="1" parent="1" source="oauth-broker" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#F9A825;strokeWidth=1;dashed=1;labelBackgroundColor=none;" target="oauth-idp">
