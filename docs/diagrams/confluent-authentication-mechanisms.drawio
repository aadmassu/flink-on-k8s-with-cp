          <mxGeometry relative="1" as="geometry">
            <mxPoint x="-43" y="-27" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="mt-mtls-note" parent="1" style="text;html=1;fontSize=8;fontStyle=2;fontColor=#1565C0;align=left;spacingLeft=5;labelBackgroundColor=none;" value="&lt;b&gt;Encrypts&lt;/b&gt; the connection AND&#xa;&lt;b&gt;authenticates&lt;/b&gt; both parties.&#xa;No passwords needed." vertex="1">
          <mxGeometry height="40" width="150" x="470" y="338" as="geometry" />
        </mxCell>
        <mxCell id="mt-flow" parent="1" style="shape=mxgraph.gcp2.standard_rectangle;fillColor=#E8F5E9;strokeColor=#2E7D32;fontStyle=1;fontSize=14;verticalAlign=top;spacingTop=5;rounded=1;arcSize=4;shadow=1;labelBackgroundColor=none;" value="mTLS Handshake — Step by Step" vertex="1">
