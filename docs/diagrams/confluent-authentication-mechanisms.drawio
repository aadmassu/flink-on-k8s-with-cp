        <mxCell id="kerb-a3-l" connectable="0" parent="kerb-a3" style="edgeLabel;fontSize=10;fontStyle=1;fillColor=#2E7D32;fontColor=#000000;labelBackgroundColor=none;" value="3" vertex="1">
          <mxGeometry relative="1" as="geometry">
