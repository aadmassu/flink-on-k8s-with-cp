          <mxGeometry height="55" width="50" x="340" y="962.5" as="geometry" />
        </mxCell>
        <mxCell id="deleg-broker-l" parent="1" style="text;html=1;fontSize=9;fontStyle=1;align=center;fontColor=#2E7D32;labelBackgroundColor=none;" value="Kafka Broker&#xa;(issues token)" vertex="1">
          <mxGeometry height="25" width="120" x="305" y="1023" as="geometry" />
