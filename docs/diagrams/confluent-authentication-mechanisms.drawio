          <mxGeometry height="25" width="100" x="1140" y="543" as="geometry" />
        </mxCell>
        <mxCell id="sso-comp-note" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;fontSize=8;align=left;spacingLeft=8;shadow=1;" value="&lt;b&gt;MDS (Metadata Service)&lt;/b&gt; is the central authorization service.&#xa;It validates JWT tokens from the IdP and enforces RBAC role bindings.&#xa;All CP components delegate authorization to MDS.&#xa;&#xa;&lt;b&gt;RBAC roles:&lt;/b&gt; SystemAdmin, ClusterAdmin, ResourceOwner, DeveloperRead, DeveloperWrite, DeveloperManage" vertex="1">
          <mxGeometry height="55" width="450" x="800" y="580" as="geometry" />
        </mxCell>
        <mxCell id="sso-vs" parent="1" style="shape=mxgraph.gcp2.standard_rectangle;fillColor=#FFF8E1;strokeColor=#F9A825;fontStyle=1;fontSize=12;verticalAlign=top;spacingTop=3;rounded=1;arcSize=3;shadow=1;" value="SSO vs SASL — When to Use What" vertex="1">
          <mxGeometry height="270" width="1250" x="30" y="670" as="geometry" />
        </mxCell>
        <mxCell id="sso-vs-table" parent="1" style="text;html=1;overflow=fill;rounded=1;whiteSpace=wrap;fillColor=#FAFAFA;strokeColor=#F9A825;arcSize=5;" value="&lt;table style=&#39;font-size:10px;border-collapse:collapse;width:100%&#39;&gt;&lt;tr style=&#39;background:#FFF9C4;font-weight:bold&#39;&gt;&lt;td style=&#39;padding:5px;border:1px solid #F9A825&#39;&gt;&lt;/td&gt;&lt;td style=&#39;padding:5px;border:1px solid #F9A825&#39;&gt;SSO (OIDC)&lt;/td&gt;&lt;td style=&#39;padding:5px;border:1px solid #F9A825&#39;&gt;SASL/OAUTHBEARER&lt;/td&gt;&lt;td style=&#39;padding:5px;border:1px solid #F9A825&#39;&gt;SASL/PLAIN&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#39;padding:5px;border:1px solid #ccc;font-weight:bold&#39;&gt;Who authenticates?&lt;/td&gt;&lt;td style=&#39;padding:5px;border:1px solid #ccc&#39;&gt;Humans (browser-based)&lt;/td&gt;&lt;td style=&#39;padding:5px;border:1px solid #ccc&#39;&gt;Applications (service-to-service)&lt;/td&gt;&lt;td style=&#39;padding:5px;border:1px solid #ccc&#39;&gt;Applications (simple)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#39;padding:5px;border:1px solid #ccc;font-weight:bold&#39;&gt;Protocol&lt;/td&gt;&lt;td style=&#39;padding:5px;border:1px solid #ccc&#39;&gt;OIDC Authorization Code flow&lt;/td&gt;&lt;td style=&#39;padding:5px;border:1px solid #ccc&#39;&gt;OAuth 2.0 Client Credentials&lt;/td&gt;&lt;td style=&#39;padding:5px;border:1px solid #ccc&#39;&gt;Username + password&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#39;padding:5px;border:1px solid #ccc;font-weight:bold&#39;&gt;Used for&lt;/td&gt;&lt;td style=&#39;padding:5px;border:1px solid #ccc&#39;&gt;Control Center UI, Cloud Console&lt;/td&gt;&lt;td style=&#39;padding:5px;border:1px solid #ccc&#39;&gt;Kafka clients, Connect, SR, Flink&lt;/td&gt;&lt;td style=&#39;padding:5px;border:1px solid #ccc&#39;&gt;Kafka clients (basic)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#39;padding:5px;border:1px solid #ccc;font-weight:bold&#39;&gt;MFA support&lt;/td&gt;&lt;td style=&#39;padding:5px;border:1px solid #ccc;color:#2E7D32&#39;&gt;Yes (via IdP)&lt;/td&gt;&lt;td style=&#39;padding:5px;border:1px solid #ccc;color:#C62828&#39;&gt;No (machine identity)&lt;/td&gt;&lt;td style=&#39;padding:5px;border:1px solid #ccc;color:#C62828&#39;&gt;No&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#39;padding:5px;border:1px solid #ccc;font-weight:bold&#39;&gt;Example&lt;/td&gt;&lt;td style=&#39;padding:5px;border:1px solid #ccc&#39;&gt;Admin opens C3, redirected to Okta&lt;/td&gt;&lt;td style=&#39;padding:5px;border:1px solid #ccc&#39;&gt;Flink job uses client_id/secret for JWT&lt;/td&gt;&lt;td style=&#39;padding:5px;border:1px solid #ccc&#39;&gt;kcat with API key&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" vertex="1">
          <mxGeometry height="145" width="1200" x="55" y="695" as="geometry" />
        </mxCell>
        <mxCell id="sso-arch" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#F9A825;fontSize=10;align=left;spacingLeft=8;shadow=1;fontStyle=2;" value="&lt;b&gt;In practice, you use BOTH:&lt;/b&gt;&lt;br&gt;- &lt;b&gt;SSO (OIDC)&lt;/b&gt; for humans accessing Control Center / Confluent Cloud UI&lt;br&gt;- &lt;b&gt;SASL/OAUTHBEARER&lt;/b&gt; for applications (producers, consumers, connectors, Flink)&lt;br&gt;- Both backed by the &lt;b&gt;same IdP&lt;/b&gt; (Okta, Azure AD) — different OAuth flows but same identity store" vertex="1">
          <mxGeometry height="65" width="600" x="55" y="860" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="mtls" name="Mutual TLS (mTLS)">
