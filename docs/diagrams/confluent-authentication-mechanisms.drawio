        </mxCell>
        <mxCell id="deleg-a2" edge="1" parent="1" source="deleg-client" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#F9A825;strokeWidth=2;labelBackgroundColor=none;" target="deleg-worker">
          <mxGeometry relative="1" as="geometry">
