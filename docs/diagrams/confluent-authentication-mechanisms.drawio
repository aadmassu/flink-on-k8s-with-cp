        </mxCell>
        <mxCell id="mt-fc" parent="1" style="shape=mxgraph.azure.user;fillColor=#2E7D32;strokeColor=none;shadow=1;labelBackgroundColor=none;" value="" vertex="1">
          <mxGeometry height="55" width="55" x="100" y="530" as="geometry" />
        </mxCell>
        <mxCell id="mt-fc-l" parent="1" style="text;html=1;fontSize=11;fontStyle=1;align=center;fontColor=#2E7D32;labelBackgroundColor=none;" value="Kafka Client" vertex="1">
          <mxGeometry height="18" width="95" x="80" y="590" as="geometry" />
        </mxCell>
        <mxCell id="mt-fc-store" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C8E6C9;strokeColor=#2E7D32;fontSize=8;align=left;spacingLeft=5;fontFamily=Courier New;labelBackgroundColor=none;" value="keystore.jks&#xa;(client cert + private key)&#xa;&#xa;truststore.jks&#xa;(CA cert to verify server)" vertex="1">
          <mxGeometry height="65" width="175" x="60" y="615" as="geometry" />
