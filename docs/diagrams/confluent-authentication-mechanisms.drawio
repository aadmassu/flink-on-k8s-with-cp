        <mxCell id="deleg-a3" edge="1" parent="1" source="deleg-worker" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#E65100;strokeWidth=2;labelBackgroundColor=none;" target="deleg-broker">
