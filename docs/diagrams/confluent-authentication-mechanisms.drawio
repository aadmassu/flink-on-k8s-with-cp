        <mxCell id="plain-a1-l" connectable="0" parent="plain-a1" style="edgeLabel;fontSize=8;fillColor=none;fontStyle=1;fontColor=#E65100;labelBackgroundColor=none;" value="username + password&#xa;(plaintext in SASL handshake)" vertex="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="-50" y="-35" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="plain-steps" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#E65100;fontSize=8;align=left;spacingLeft=8;shadow=1;labelBackgroundColor=none;arcSize=6;" value="Client sends username + password in the SASL handshake.&#xa;Broker checks against JAAS config (static file).&#xa;&#xa;&lt;b&gt;MUST use TLS (SASL_SSL)&lt;/b&gt; — credentials are in cleartext!&#xa;Simple to set up. Suitable for dev/test.&#xa;Confluent Cloud uses this for API key + secret." vertex="1">
          <mxGeometry height="80" width="290" x="560" y="330" as="geometry" />
        </mxCell>
