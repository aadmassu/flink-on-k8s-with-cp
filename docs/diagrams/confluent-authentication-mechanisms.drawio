        <mxCell id="ldap-a1" edge="1" parent="1" source="ldap-client" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#8E24AA;strokeWidth=2;labelBackgroundColor=none;" target="ldap-broker">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ldap-a1-l" connectable="0" parent="ldap-a1" style="edgeLabel;fontSize=10;fontStyle=1;fillColor=#8E24AA;fontColor=#000000;labelBackgroundColor=none;" value="1" vertex="1">
          <mxGeometry relative="1" as="geometry">
