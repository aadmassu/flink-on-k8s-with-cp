          <mxGeometry x="200" y="15" width="700" height="40" as="geometry" />
        </mxCell>
        <mxCell id="cmfl-subtitle" value="The Flink operator chart bundles its own Issuer + Certificate CR — fully automatic, no manual setup" style="text;html=1;fontSize=11;fontStyle=2;align=center;fontColor=#666;" vertex="1" parent="1">
