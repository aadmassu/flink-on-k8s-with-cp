        <mxCell id="adm-checks" parent="1" style="shape=mxgraph.gcp2.standard_rectangle;fillColor=#F3E5F5;strokeColor=#8E24AA;fontStyle=1;fontSize=13;verticalAlign=top;spacingTop=5;rounded=1;arcSize=8;" value="3. What CFK ValidatingWebhook Checks" vertex="1">
          <mxGeometry height="210" width="1500" x="40" y="610" as="geometry" />
        </mxCell>
        <mxCell id="adm-checks-table" parent="1" style="text;html=1;overflow=fill;rounded=1;whiteSpace=wrap;fillColor=#FAFAFA;strokeColor=#8E24AA;" value="&lt;table style=&#39;font-size:10px;border-collapse:collapse;width:100%&#39;&gt;&lt;tr style=&#39;background:#E1BEE7;font-weight:bold&#39;&gt;&lt;td style=&#39;padding:4px;border:1px solid #8E24AA&#39;&gt;CR Type&lt;/td&gt;&lt;td style=&#39;padding:4px;border:1px solid #8E24AA&#39;&gt;Validations Performed&lt;/td&gt;&lt;td style=&#39;padding:4px;border:1px solid #8E24AA&#39;&gt;Example Rejection&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#39;padding:4px;border:1px solid #ccc;font-weight:bold&#39;&gt;Kafka&lt;/td&gt;&lt;td style=&#39;padding:4px;border:1px solid #ccc&#39;&gt;Replica count, listener config, KRaft dependency, storage resize (up only)&lt;/td&gt;&lt;td style=&#39;padding:4px;border:1px solid #ccc;color:#C62828;font-style:italic&#39;&gt;&quot;authentication type &#39;plain&#39; not supported with OAuth&quot;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#39;padding:4px;border:1px solid #ccc;font-weight:bold&#39;&gt;KRaftController&lt;/td&gt;&lt;td style=&#39;padding:4px;border:1px solid #ccc&#39;&gt;Odd replica count (1,3,5), no scale-down, TLS consistency&lt;/td&gt;&lt;td style=&#39;padding:4px;border:1px solid #ccc;color:#C62828;font-style:italic&#39;&gt;&quot;replicas must be odd for quorum consensus&quot;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#39;padding:4px;border:1px solid #ccc;font-weight:bold&#39;&gt;SchemaRegistry&lt;/td&gt;&lt;td style=&#39;padding:4px;border:1px solid #ccc&#39;&gt;Kafka dependency configured, auth matches listener&lt;/td&gt;&lt;td style=&#39;padding:4px;border:1px solid #ccc;color:#C62828;font-style:italic&#39;&gt;&quot;dependencies.kafka.bootstrapEndpoint is required&quot;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#39;padding:4px;border:1px solid #ccc;font-weight:bold&#39;&gt;Connect&lt;/td&gt;&lt;td style=&#39;padding:4px;border:1px solid #ccc&#39;&gt;Kafka dependency, image specified for custom connectors&lt;/td&gt;&lt;td style=&#39;padding:4px;border:1px solid #ccc;color:#C62828;font-style:italic&#39;&gt;&quot;dependencies.kafka is required&quot;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#39;padding:4px;border:1px solid #ccc;font-weight:bold&#39;&gt;ControlCenter&lt;/td&gt;&lt;td style=&#39;padding:4px;border:1px solid #ccc&#39;&gt;Single replica only, Kafka + SR + Connect deps&lt;/td&gt;&lt;td style=&#39;padding:4px;border:1px solid #ccc;color:#C62828;font-style:italic&#39;&gt;&quot;replicas must be 1 for ControlCenter&quot;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#39;padding:4px;border:1px solid #ccc;font-weight:bold&#39;&gt;StatefulSet/Pod deletion&lt;/td&gt;&lt;td style=&#39;padding:4px;border:1px solid #ccc&#39;&gt;Prevents unsafe deletes and evictions of Kafka/KRaft pods&lt;/td&gt;&lt;td style=&#39;padding:4px;border:1px solid #ccc;color:#C62828;font-style:italic&#39;&gt;&quot;cannot evict pod kafka-0: under-replicated partitions&quot;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" vertex="1">
          <mxGeometry height="170" width="1470" x="55" y="640" as="geometry" />
        </mxCell>
        <mxCell id="adm-recon" parent="1" style="shape=mxgraph.gcp2.standard_rectangle;fillColor=#E8F5E9;strokeColor=#2E7D32;fontStyle=1;fontSize=13;verticalAlign=top;spacingTop=5;rounded=1;arcSize=8;" value="4. Reconciliation Loop — The Operator Never Stops Watching" vertex="1">
          <mxGeometry height="260" width="1500" x="40" y="840" as="geometry" />
        </mxCell>
