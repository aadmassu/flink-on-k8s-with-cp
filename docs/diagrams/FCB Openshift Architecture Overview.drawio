        <mxCell id="ly-sec" parent="1" style="shape=process;whiteSpace=wrap;html=1;fillColor=#FFCDD2;strokeColor=#C62828;fontSize=11;fontStyle=1;size=0.04;shadow=1;" value="Security &amp; Identity" vertex="1">
          <mxGeometry height="50" width="420" x="60" y="875" as="geometry" />
        </mxCell>
        <mxCell id="ly-sec-cfk" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE4EC;strokeColor=#C62828;fontSize=9;align=left;spacingLeft=8;verticalAlign=top;spacingTop=5;" value="&lt;b&gt;TLS:&lt;/b&gt; cert-manager (KeyFactor in prod, self-signed in dev) — PKCS12 for operator, PEM for components&lt;br&gt;&lt;b&gt;Auth:&lt;/b&gt; Okta OAuth2/OIDC — all components &amp; MDS RBAC | &lt;b&gt;SCC:&lt;/b&gt; confluent-scc (RunAsAny)" vertex="1">
          <mxGeometry height="50" width="500" x="560" y="875" as="geometry" />
        </mxCell>
