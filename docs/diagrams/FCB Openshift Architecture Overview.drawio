        <mxCell id="ly-ops" parent="1" style="shape=process;whiteSpace=wrap;html=1;fillColor=#E1BEE7;strokeColor=#7E57C2;fontSize=11;fontStyle=1;size=0.04;shadow=1;" value="Operators &amp; CRDs" vertex="1">
