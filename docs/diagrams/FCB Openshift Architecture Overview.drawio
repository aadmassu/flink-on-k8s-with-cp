        </mxCell>
        <mxCell id="tls-group" parent="1" style="shape=mxgraph.gcp2.standard_rectangle;fillColor=#FFF3E0;strokeColor=#E65100;fontStyle=1;fontSize=13;verticalAlign=top;spacingTop=5;rounded=1;arcSize=8;" value="1. Webhook TLS — How the API Server Trusts the Webhook" vertex="1">
