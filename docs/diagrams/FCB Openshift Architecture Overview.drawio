        <mxCell id="tls-vwc" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1BEE7;strokeColor=#8E24AA;fontSize=10;fontStyle=1;" value="ValidatingWebhookConfiguration" vertex="1">
          <mxGeometry height="40" width="230" x="80" y="220" as="geometry" />
        </mxCell>
        <mxCell id="tls-vwc-detail" parent="1" style="text;html=1;fontSize=9;align=left;spacingLeft=5;fontFamily=Courier New;" value="caBundle: &lt;base64 CA cert&gt;&#xa;← API server uses this to verify&#xa;   the webhook&#39;s TLS certificate" vertex="1">
          <mxGeometry height="40" width="250" x="80" y="265" as="geometry" />
