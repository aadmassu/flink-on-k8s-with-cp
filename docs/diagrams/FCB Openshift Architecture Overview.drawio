        <mxCell id="ly-ops-cfk" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE7F6;strokeColor=#7E57C2;fontSize=9;align=left;spacingLeft=8;verticalAlign=top;spacingTop=5;" value="&lt;b&gt;CFK Operator&lt;/b&gt; → manages Kafka, KRaft, SR, Connect, CC CRDs (validates + reconciles)&lt;br&gt;&lt;b&gt;Flink Operator&lt;/b&gt; → manages FlinkDeployment, FlinkSessionJob CRDs" vertex="1">
