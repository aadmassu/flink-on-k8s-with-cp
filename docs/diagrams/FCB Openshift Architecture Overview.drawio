  <diagram id="cfk-admission-ref" name="CFK Operator Admission">
    <mxGraphModel dx="2583" dy="1301" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0" />
