          <mxGeometry relative="1" as="geometry">
            <mxPoint y="-15" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="tls-webhook" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CE93D8;strokeColor=#8E24AA;fontSize=11;fontStyle=1;" value="CFK Operator Pod&#xa;(webhook server :8443)" vertex="1">
          <mxGeometry height="50" width="190" x="550" y="140" as="geometry" />
        </mxCell>
        <mxCell id="tls-secret" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;fontSize=9;align=left;spacingLeft=8;" value="Secret: confluent-operator-serving-cert&#xa;fullchain.pem | privkey.pem | cacerts.pem&#xa;(mounted via directoryPathInContainer)" vertex="1">
