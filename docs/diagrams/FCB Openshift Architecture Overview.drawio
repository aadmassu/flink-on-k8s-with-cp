        </mxCell>
        <mxCell id="st-bind-title" parent="1" style="text;html=1;fontSize=12;fontStyle=1;align=left;" value="Volume Binding Modes" vertex="1">
          <mxGeometry height="20" width="250" x="900" y="490" as="geometry" />
        </mxCell>
        <mxCell id="st-bind-imm" parent="1" style="text;html=1;fontSize=9;align=left;spacingLeft=5;" value="&lt;b&gt;Immediate&lt;/b&gt; — PV provisioned as soon as PVC created. Risk: PV may land in different zone than Pod." vertex="1">
          <mxGeometry height="15" width="499" x="900" y="515" as="geometry" />
        </mxCell>
        <mxCell id="st-bind-wait" parent="1" style="text;html=1;fontSize=9;align=left;spacingLeft=5;" value="&lt;b&gt;WaitForFirstConsumer&lt;/b&gt; — PV provisioned after Pod is scheduled. CSI creates storage in same zone. &lt;span style=&#39;color:#2E7D32;font-weight:bold&#39;&gt;Best practice.&lt;/span&gt;" vertex="1">
          <mxGeometry height="15" width="499" x="900" y="535" as="geometry" />
        </mxCell>
        <mxCell id="st-sts-title" parent="1" style="text;html=1;fontSize=12;fontStyle=1;align=left;" value="StatefulSet + volumeClaimTemplates" vertex="1">
          <mxGeometry height="20" width="350" x="900" y="565" as="geometry" />
        </mxCell>
        <mxCell id="st-sts-desc" parent="1" style="text;html=1;fontSize=9;align=left;spacingLeft=5;" value="StatefulSets define a &lt;b&gt;volumeClaimTemplate&lt;/b&gt; — K8s creates one PVC per replica:&lt;br&gt;&lt;br&gt;&lt;code&gt;kafka&lt;/code&gt; (3 replicas) →  PVC: &lt;code&gt;data-kafka-0&lt;/code&gt; (50Gi) → PV-0 → EBS vol-abc&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; →&amp;nbsp;PVC: &lt;code&gt;data-kafka-1&lt;/code&gt; (50Gi) → PV-1 → EBS vol-def&lt;br&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; →&amp;nbsp;PVC: &lt;code&gt;data-kafka-2&lt;/code&gt; (50Gi) → PV-2 → EBS vol-ghi&lt;br&gt;&lt;br&gt;If a Pod is rescheduled, it re-attaches to the &lt;b&gt;same PVC&lt;/b&gt; (stable identity)." vertex="1">
          <mxGeometry height="85" width="580" x="900" y="585" as="geometry" />
        </mxCell>
        <mxCell id="st-csi-title" parent="1" style="text;html=1;fontSize=12;fontStyle=1;align=left;" value="Common CSI Drivers" vertex="1">
          <mxGeometry height="20" width="250" x="900" y="680" as="geometry" />
        </mxCell>
        <mxCell id="st-csi-table" parent="1" style="text;html=1;overflow=fill;rounded=1;whiteSpace=wrap;fillColor=#FAFAFA;strokeColor=#9E9E9E;" value="&lt;table style=&#39;font-size:9px;border-collapse:collapse;width:100%&#39;&gt;&lt;tr style=&#39;background:#E3F2FD;font-weight:bold&#39;&gt;&lt;td style=&#39;padding:3px;border:1px solid #1565C0&#39;&gt;Provider&lt;/td&gt;&lt;td style=&#39;padding:3px;border:1px solid #1565C0&#39;&gt;CSI Driver&lt;/td&gt;&lt;td style=&#39;padding:3px;border:1px solid #1565C0&#39;&gt;Modes&lt;/td&gt;&lt;td style=&#39;padding:3px;border:1px solid #1565C0&#39;&gt;Type&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#39;padding:3px;border:1px solid #ccc&#39;&gt;AWS EBS&lt;/td&gt;&lt;td style=&#39;padding:3px;border:1px solid #ccc&#39;&gt;&lt;code&gt;ebs.csi.aws.com&lt;/code&gt;&lt;/td&gt;&lt;td style=&#39;padding:3px;border:1px solid #ccc&#39;&gt;RWO&lt;/td&gt;&lt;td style=&#39;padding:3px;border:1px solid #ccc&#39;&gt;Block&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#39;padding:3px;border:1px solid #ccc&#39;&gt;AWS EFS&lt;/td&gt;&lt;td style=&#39;padding:3px;border:1px solid #ccc&#39;&gt;&lt;code&gt;efs.csi.aws.com&lt;/code&gt;&lt;/td&gt;&lt;td style=&#39;padding:3px;border:1px solid #ccc&#39;&gt;RWX, ROX, RWO&lt;/td&gt;&lt;td style=&#39;padding:3px;border:1px solid #ccc&#39;&gt;NFS&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#39;padding:3px;border:1px solid #ccc&#39;&gt;NetApp Trident&lt;/td&gt;&lt;td style=&#39;padding:3px;border:1px solid #ccc&#39;&gt;&lt;code&gt;csi.trident.netapp.io&lt;/code&gt;&lt;/td&gt;&lt;td style=&#39;padding:3px;border:1px solid #ccc&#39;&gt;RWO, RWX, ROX&lt;/td&gt;&lt;td style=&#39;padding:3px;border:1px solid #ccc&#39;&gt;Block / NFS&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#39;padding:3px;border:1px solid #ccc&#39;&gt;Ceph (Rook)&lt;/td&gt;&lt;td style=&#39;padding:3px;border:1px solid #ccc&#39;&gt;&lt;code&gt;rook-ceph.rbd.csi.ceph.com&lt;/code&gt;&lt;/td&gt;&lt;td style=&#39;padding:3px;border:1px solid #ccc&#39;&gt;RWO, RWX&lt;/td&gt;&lt;td style=&#39;padding:3px;border:1px solid #ccc&#39;&gt;Block / FS&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#39;padding:3px;border:1px solid #ccc&#39;&gt;NFS (generic)&lt;/td&gt;&lt;td style=&#39;padding:3px;border:1px solid #ccc&#39;&gt;&lt;code&gt;nfs.csi.k8s.io&lt;/code&gt;&lt;/td&gt;&lt;td style=&#39;padding:3px;border:1px solid #ccc&#39;&gt;RWO, RWX, ROX&lt;/td&gt;&lt;td style=&#39;padding:3px;border:1px solid #ccc&#39;&gt;NFS&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" vertex="1">
          <mxGeometry height="150" width="580" x="900" y="715" as="geometry" />
        </mxCell>
