        </mxCell>
        <mxCell id="np-note" parent="1" style="text;html=1;fontSize=9;fontStyle=2;fontColor=#999;align=left;" value="Every node listens on the same NodePort, even if no target Pods run on that node." vertex="1">
          <mxGeometry height="15" width="340" x="50" y="500" as="geometry" />
        </mxCell>
        <mxCell id="np-rare" parent="1" style="text;html=1;fontSize=9;fontStyle=2;fontColor=#999;align=left;" value="Rarely used directly in production — usually a building block for LoadBalancer." vertex="1">
          <mxGeometry height="15" width="330" x="50" y="520" as="geometry" />
        </mxCell>
        <mxCell id="lb-group" parent="1" style="shape=mxgraph.gcp2.standard_rectangle;fillColor=#E8F5E9;strokeColor=#2E7D32;fontStyle=1;fontSize=13;verticalAlign=top;spacingTop=5;rounded=1;arcSize=8;" value="3. LoadBalancer" vertex="1">
          <mxGeometry height="220" width="720" x="40" y="580" as="geometry" />
        </mxCell>
        <mxCell id="lb-desc" parent="1" style="text;html=1;fontSize=10;align=left;spacingLeft=5;" value="Extends NodePort — provisions an &lt;b&gt;external cloud load balancer&lt;/b&gt; (AWS ELB/NLB, GCP LB).&lt;br&gt;Gives you a stable external IP or DNS name. &lt;b&gt;LoadBalancer = Cloud LB + NodePort + ClusterIP&lt;/b&gt;." vertex="1">
          <mxGeometry height="30" width="600" x="50" y="605" as="geometry" />
        </mxCell>
        <mxCell id="lb-internet" parent="1" style="shape=actor;whiteSpace=wrap;html=1;fillColor=#C8E6C9;strokeColor=#2E7D32;fontSize=9;" value="&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;External&lt;br&gt;Client" vertex="1">
          <mxGeometry height="50" width="50" x="60" y="660" as="geometry" />
        </mxCell>
        <mxCell id="lb-cloud" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#A5D6A7;strokeColor=#2E7D32;fontSize=9;fontStyle=1;" value="Cloud Load Balancer&#xa;(external IP: 34.x.x.x)&#xa;provisioned automatically" vertex="1">
          <mxGeometry height="50" width="170" x="180" y="660" as="geometry" />
        </mxCell>
        <mxCell id="lb-np" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;fontSize=9;" value="NodePort&#xa;(auto-allocated)" vertex="1">
          <mxGeometry height="30" width="100" x="412.5" y="670" as="geometry" />
        </mxCell>
        <mxCell id="lb-cip" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#1565C0;fontSize=9;" value="ClusterIP" vertex="1">
          <mxGeometry height="25" width="100" x="412.5" y="707" as="geometry" />
        </mxCell>
        <mxCell id="lb-pod1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#F9A825;fontSize=9;" value="Pod A" vertex="1">
          <mxGeometry height="25" width="80" x="582.5" y="672.5" as="geometry" />
        </mxCell>
        <mxCell id="lb-pod2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#F9A825;fontSize=9;" value="Pod B" vertex="1">
          <mxGeometry height="25" width="80" x="582.5" y="707" as="geometry" />
        </mxCell>
        <mxCell id="lb-a1" edge="1" parent="1" source="lb-internet" style="rounded=1;strokeColor=#2E7D32;strokeWidth=2;" target="lb-cloud">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="lb-a2" edge="1" parent="1" source="lb-cloud" style="rounded=1;strokeColor=#E65100;" target="lb-np">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="lb-a3a" edge="1" parent="1" source="lb-np" style="rounded=1;strokeColor=#1565C0;" target="lb-pod1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="lb-a3b" edge="1" parent="1" source="lb-cip" style="rounded=1;strokeColor=#1565C0;" target="lb-pod2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="lb-ocp-note" parent="1" style="text;html=1;fontSize=9;fontStyle=2;fontColor=#C62828;align=left;" value="&lt;b&gt;In OpenShift&lt;/b&gt;, Routes replace LoadBalancer Services. The HAProxy-based Router&#xa;watches Route objects and provides ingress with TLS termination and hostname-based routing." vertex="1">
          <mxGeometry height="30" width="500" x="60" y="750" as="geometry" />
        </mxCell>
        <mxCell id="hl-group" parent="1" style="shape=mxgraph.gcp2.standard_rectangle;fillColor=#F3E5F5;strokeColor=#8E24AA;fontStyle=1;fontSize=13;verticalAlign=top;spacingTop=5;rounded=1;arcSize=8;" value="4. Headless Service (clusterIP: None)" vertex="1">
          <mxGeometry height="280" width="720" x="40" y="820" as="geometry" />
        </mxCell>
        <mxCell id="hl-desc" parent="1" style="text;html=1;fontSize=10;align=left;spacingLeft=5;" value="No virtual IP. DNS returns &lt;b&gt;individual Pod IPs&lt;/b&gt; (A records). Each Pod gets a stable DNS name:&lt;br&gt;&lt;b&gt;&amp;lt;pod-name&amp;gt;.&amp;lt;svc&amp;gt;.&amp;lt;ns&amp;gt;.svc.cluster.local&lt;/b&gt; — essential for StatefulSets (Kafka, databases)." vertex="1">
          <mxGeometry height="35" width="600" x="50" y="848" as="geometry" />
        </mxCell>
        <mxCell id="hl-client" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C8E6C9;strokeColor=#2E7D32;fontSize=10;fontStyle=1;" value="Client Pod" vertex="1">
          <mxGeometry height="35" width="100" x="60" y="940" as="geometry" />
        </mxCell>
        <mxCell id="hl-dns" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1BEE7;strokeColor=#8E24AA;fontSize=10;fontStyle=1;" value="CoreDNS" vertex="1">
          <mxGeometry height="35" width="100" x="240" y="940" as="geometry" />
        </mxCell>
        <mxCell id="hl-nosvc" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#8E24AA;fontSize=8;fontStyle=2;dashed=1;" value="No ClusterIP!&#xa;(clusterIP: None)" vertex="1">
          <mxGeometry height="25" width="100" x="240" y="980" as="geometry" />
        </mxCell>
        <mxCell id="hl-pod0" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#F9A825;fontSize=8;align=left;spacingLeft=5;" value="kafka-0.kafka-headless&#xa;.ns.svc.cluster.local&#xa;→ 10.244.1.5" vertex="1">
          <mxGeometry height="40" width="175" x="430" y="893" as="geometry" />
        </mxCell>
        <mxCell id="hl-pod1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#F9A825;fontSize=8;align=left;spacingLeft=5;" value="kafka-1.kafka-headless&#xa;.ns.svc.cluster.local&#xa;→ 10.244.2.8" vertex="1">
          <mxGeometry height="40" width="175" x="430" y="940" as="geometry" />
        </mxCell>
        <mxCell id="hl-pod2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#F9A825;fontSize=8;align=left;spacingLeft=5;" value="kafka-2.kafka-headless&#xa;.ns.svc.cluster.local&#xa;→ 10.244.3.2" vertex="1">
          <mxGeometry height="40" width="175" x="430" y="987" as="geometry" />
        </mxCell>
        <mxCell id="hl-a1" edge="1" parent="1" source="hl-client" style="rounded=1;strokeColor=#8E24AA;strokeWidth=2;" target="hl-dns">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="hl-a1-l" connectable="0" parent="hl-a1" style="edgeLabel;fontSize=8;fillColor=none;labelBackgroundColor=none;" value="DNS query" vertex="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="-20" y="-17" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="hl-a2a" edge="1" parent="1" source="hl-dns" style="rounded=1;strokeColor=#8E24AA;dashed=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="hl-pod0">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="hl-a2b" edge="1" parent="1" source="hl-dns" style="rounded=1;strokeColor=#8E24AA;dashed=1;" target="hl-pod1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="hl-a2c" edge="1" parent="1" source="hl-dns" style="rounded=1;strokeColor=#8E24AA;dashed=1;entryX=-0.013;entryY=0.464;entryDx=0;entryDy=0;entryPerimeter=0;" target="hl-pod2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="hl-returns" parent="1" style="text;fontSize=8;fontStyle=2;fontColor=#8E24AA;align=center;" value="returns all Pod IPs&#xa;(client picks one)" vertex="1">
          <mxGeometry height="25" width="70" x="330" y="893" as="geometry" />
        </mxCell>
        <mxCell id="hl-direct" parent="1" style="text;html=1;fontSize=9;fontStyle=2;fontColor=#999;align=left;" value="Client connects directly to a specific Pod — no load balancing layer" vertex="1">
          <mxGeometry height="15" width="400" x="50" y="1050" as="geometry" />
        </mxCell>
        <mxCell id="svc-comparison" parent="1" style="text;html=1;overflow=fill;rounded=1;whiteSpace=wrap;fillColor=#FAFAFA;strokeColor=#9E9E9E;" value="&lt;table style=&#39;font-size:10px;border-collapse:collapse;width:100%&#39;&gt;&lt;tr style=&#39;background:#E3F2FD;font-weight:bold&#39;&gt;&lt;td style=&#39;padding:5px;border:1px solid #1565C0&#39;&gt;Type&lt;/td&gt;&lt;td style=&#39;padding:5px;border:1px solid #1565C0&#39;&gt;ClusterIP&lt;/td&gt;&lt;td style=&#39;padding:5px;border:1px solid #1565C0&#39;&gt;External IP&lt;/td&gt;&lt;td style=&#39;padding:5px;border:1px solid #1565C0&#39;&gt;Load Balanced&lt;/td&gt;&lt;td style=&#39;padding:5px;border:1px solid #1565C0&#39;&gt;Pod DNS&lt;/td&gt;&lt;td style=&#39;padding:5px;border:1px solid #1565C0&#39;&gt;Use Case&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#39;padding:5px;border:1px solid #ccc;font-weight:bold;background:#E3F2FD&#39;&gt;ClusterIP&lt;/td&gt;&lt;td style=&#39;padding:5px;border:1px solid #ccc&#39;&gt;Yes&lt;/td&gt;&lt;td style=&#39;padding:5px;border:1px solid #ccc&#39;&gt;No&lt;/td&gt;&lt;td style=&#39;padding:5px;border:1px solid #ccc&#39;&gt;Yes (internal)&lt;/td&gt;&lt;td style=&#39;padding:5px;border:1px solid #ccc&#39;&gt;No&lt;/td&gt;&lt;td style=&#39;padding:5px;border:1px solid #ccc&#39;&gt;Internal microservice communication&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#39;padding:5px;border:1px solid #ccc;font-weight:bold;background:#FFF3E0&#39;&gt;NodePort&lt;/td&gt;&lt;td style=&#39;padding:5px;border:1px solid #ccc&#39;&gt;Yes&lt;/td&gt;&lt;td style=&#39;padding:5px;border:1px solid #ccc&#39;&gt;NodeIP:Port&lt;/td&gt;&lt;td style=&#39;padding:5px;border:1px solid #ccc&#39;&gt;Yes&lt;/td&gt;&lt;td style=&#39;padding:5px;border:1px solid #ccc&#39;&gt;No&lt;/td&gt;&lt;td style=&#39;padding:5px;border:1px solid #ccc&#39;&gt;Dev/testing, non-cloud&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#39;padding:5px;border:1px solid #ccc;font-weight:bold;background:#E8F5E9&#39;&gt;LoadBalancer&lt;/td&gt;&lt;td style=&#39;padding:5px;border:1px solid #ccc&#39;&gt;Yes&lt;/td&gt;&lt;td style=&#39;padding:5px;border:1px solid #ccc&#39;&gt;Cloud LB IP&lt;/td&gt;&lt;td style=&#39;padding:5px;border:1px solid #ccc&#39;&gt;Yes (external)&lt;/td&gt;&lt;td style=&#39;padding:5px;border:1px solid #ccc&#39;&gt;No&lt;/td&gt;&lt;td style=&#39;padding:5px;border:1px solid #ccc&#39;&gt;Production external traffic&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#39;padding:5px;border:1px solid #ccc;font-weight:bold;background:#F3E5F5&#39;&gt;Headless&lt;/td&gt;&lt;td style=&#39;padding:5px;border:1px solid #ccc&#39;&gt;None&lt;/td&gt;&lt;td style=&#39;padding:5px;border:1px solid #ccc&#39;&gt;No&lt;/td&gt;&lt;td style=&#39;padding:5px;border:1px solid #ccc&#39;&gt;No (client picks)&lt;/td&gt;&lt;td style=&#39;padding:5px;border:1px solid #ccc&#39;&gt;Yes&lt;/td&gt;&lt;td style=&#39;padding:5px;border:1px solid #ccc&#39;&gt;StatefulSets (Kafka, DBs)&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" vertex="1">
          <mxGeometry height="160" width="700" x="800" y="90" as="geometry" />
        </mxCell>
        <mxCell id="svc-concepts" parent="1" style="shape=mxgraph.gcp2.standard_rectangle;fillColor=#FAFAFA;strokeColor=#9E9E9E;rounded=1;arcSize=10;" value="" vertex="1">
          <mxGeometry height="290" width="700" x="800" y="270" as="geometry" />
        </mxCell>
        <mxCell id="svc-concepts-title" parent="1" style="text;html=1;fontSize=13;fontStyle=1;align=left;" value="Key Concepts" vertex="1">
          <mxGeometry height="25" width="200" x="810" y="275" as="geometry" />
        </mxCell>
        <mxCell id="svc-c1" parent="1" style="text;html=1;fontSize=10;align=left;spacingLeft=5;" value="&lt;b&gt;Selector&lt;/b&gt; — Label query (e.g. app=kafka) that determines which Pods belong to the Service.&lt;br&gt;K8s watches for matching Pods and updates the Endpoints object automatically." vertex="1">
          <mxGeometry height="30" width="680" x="810" y="300" as="geometry" />
        </mxCell>
        <mxCell id="svc-c2" parent="1" style="text;html=1;fontSize=10;align=left;spacingLeft=5;" value="&lt;b&gt;Endpoints&lt;/b&gt; — Auto-managed object listing all Pod IPs matching the selector.&lt;br&gt;When a Pod starts/stops or fails readiness probes, its IP is added/removed." vertex="1">
          <mxGeometry height="30" width="680" x="810" y="335" as="geometry" />
        </mxCell>
        <mxCell id="svc-c3" parent="1" style="text;html=1;fontSize=10;align=left;spacingLeft=5;" value="&lt;b&gt;kube-proxy&lt;/b&gt; — Runs on every node. Programs iptables/IPVS rules to route ClusterIP traffic to Pod IPs." vertex="1">
          <mxGeometry height="20" width="680" x="810" y="370" as="geometry" />
        </mxCell>
        <mxCell id="svc-c4" parent="1" style="text;html=1;fontSize=10;align=left;spacingLeft=5;" value="&lt;b&gt;Port vs TargetPort&lt;/b&gt; — port is what the Service listens on; targetPort is the container port.&lt;br&gt;Example: Service port=80, targetPort=8080 → clients call :80, traffic hits Pod :8080." vertex="1">
          <mxGeometry height="30" width="680" x="810" y="395" as="geometry" />
        </mxCell>
        <mxCell id="svc-c5" parent="1" style="text;html=1;fontSize=10;align=left;spacingLeft=5;" value="&lt;b&gt;Session Affinity&lt;/b&gt; — sessionAffinity=ClientIP makes the same client always reach the same Pod. Default is None (round-robin)." vertex="1">
          <mxGeometry height="20" width="680" x="810" y="430" as="geometry" />
        </mxCell>
        <mxCell id="svc-c6" parent="1" style="text;html=1;fontSize=10;align=left;spacingLeft=5;" value="&lt;b&gt;ExternalName&lt;/b&gt; — 5th type (not shown): returns a CNAME pointing to an external DNS name. No proxying. Aliases external services." vertex="1">
          <mxGeometry height="20" width="680" x="810" y="455" as="geometry" />
        </mxCell>
        <mxCell id="svc-c7" parent="1" style="text;html=1;fontSize=10;align=left;spacingLeft=5;" value="&lt;b&gt;DNS Format&lt;/b&gt;:  Service → &lt;code&gt;&amp;lt;svc&amp;gt;.&amp;lt;ns&amp;gt;.svc.cluster.local&lt;/code&gt;  |  Headless Pod → &lt;code&gt;&amp;lt;pod&amp;gt;.&amp;lt;svc&amp;gt;.&amp;lt;ns&amp;gt;.svc.cluster.local&lt;/code&gt;" vertex="1">
          <mxGeometry height="20" width="680" x="810" y="480" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="k8s-storage-ref" name="Kubernetes Storage">
    <mxGraphModel dx="751" dy="379" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="st-title" parent="1" style="text;html=1;fontSize=22;fontStyle=1;align=center;verticalAlign=middle;" value="Kubernetes Storage — How It Works" vertex="1">
          <mxGeometry height="40" width="500" x="510" y="15" as="geometry" />
        </mxCell>
        <mxCell id="st-subtitle" parent="1" style="text;html=1;fontSize=11;fontStyle=2;align=center;fontColor=#666666;" value="Storage in K8s decouples what a Pod needs (PVC) from how it is provisioned (PV / StorageClass)." vertex="1">
          <mxGeometry height="25" width="560" x="480" y="55" as="geometry" />
        </mxCell>
        <mxCell id="st-chain" parent="1" style="shape=mxgraph.gcp2.standard_rectangle;fillColor=#E3F2FD;strokeColor=#1565C0;fontStyle=1;fontSize=13;verticalAlign=top;spacingTop=5;rounded=1;arcSize=8;" value="The Storage Chain" vertex="1">
          <mxGeometry height="190" width="1360" x="130" y="95" as="geometry" />
        </mxCell>
        <mxCell id="st-pod" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C8E6C9;strokeColor=#2E7D32;fontSize=11;fontStyle=1;" value="Pod&#xa;(container)" vertex="1">
          <mxGeometry height="45" width="150" x="160" y="132.5" as="geometry" />
        </mxCell>
        <mxCell id="st-pod-yaml" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;fontSize=8;align=left;spacingLeft=5;fontFamily=Courier New;" value="volumeMounts:&#xa;- mountPath: /data&#xa;  name: my-storage" vertex="1">
