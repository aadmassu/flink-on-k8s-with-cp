          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="dep-a3-l" parent="1" style="text;fontSize=8;fontStyle=2;fontColor=#2E7D32;align=center;" value="routes to&#xa;(label selector)" vertex="1">
          <mxGeometry height="25" width="65" x="800" y="155" as="geometry" />
        </mxCell>
        <mxCell id="dep-roll-title" parent="1" style="text;html=1;fontSize=11;fontStyle=1;align=left;" value="Rolling Update (what happens on config change)" vertex="1">
          <mxGeometry height="20" width="400" x="60" y="260" as="geometry" />
        </mxCell>
        <mxCell id="dep-rs-old" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFCDD2;strokeColor=#C62828;fontSize=9;fontStyle=2;" value="Old ReplicaSet&#xa;(scaling down)" vertex="1">
          <mxGeometry height="35" width="120" x="60" y="290" as="geometry" />
        </mxCell>
        <mxCell id="dep-rs-new" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C8E6C9;strokeColor=#2E7D32;fontSize=9;fontStyle=1;" value="New ReplicaSet&#xa;(scaling up)" vertex="1">
          <mxGeometry height="35" width="120" x="310" y="290" as="geometry" />
        </mxCell>
        <mxCell id="dep-roll-a" edge="1" parent="1" source="dep-rs-old" style="rounded=1;strokeColor=#333;strokeWidth=2;" target="dep-rs-new">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="dep-roll-a-l" connectable="0" parent="dep-roll-a" style="edgeLabel;fontSize=8;fillColor=none;labelBackgroundColor=none;" value="gradual" vertex="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="-25" y="-17" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="dep-roll-note" parent="1" style="text;html=1;fontSize=9;fontStyle=2;fontColor=#666;align=left;" value="Deployment creates a new ReplicaSet with updated pod spec, scales it up while scaling old one down.&#xa;Pods are replaced one by one. Service automatically routes to new Pods as they become ready." vertex="1">
          <mxGeometry height="25" width="600" x="60" y="335" as="geometry" />
        </mxCell>
        <mxCell id="dep-chars" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;fontSize=9;align=left;spacingLeft=8;verticalAlign=top;spacingTop=8;arcSize=8;" value="&lt;b&gt;Deployment characteristics:&lt;/b&gt;&lt;br&gt;• Pods are &lt;b&gt;interchangeable&lt;/b&gt; — random names (hash suffix)&lt;br&gt;• No stable network identity — Pod IPs change on restart&lt;br&gt;• No stable storage — PVCs are shared or ephemeral&lt;br&gt;• Scaling: add/remove any Pod, order doesn&#39;t matter&lt;br&gt;• Use for: stateless apps (Schema Registry, Connect, CMF, operators)" vertex="1">
          <mxGeometry height="110" width="350" x="590" y="280" as="geometry" />
        </mxCell>
        <mxCell id="sts-group" parent="1" style="shape=mxgraph.gcp2.standard_rectangle;fillColor=#F3E5F5;strokeColor=#8E24AA;fontStyle=1;fontSize=13;verticalAlign=top;spacingTop=5;rounded=1;arcSize=3;" value="StatefulSet + Headless Service + Pods + PVCs" vertex="1">
          <mxGeometry height="400" width="1260" x="40" y="470" as="geometry" />
        </mxCell>
        <mxCell id="sts-desc" parent="1" style="text;html=1;fontSize=10;align=left;spacingLeft=5;" value="A &lt;b&gt;StatefulSet&lt;/b&gt; gives each Pod a &lt;b&gt;stable identity&lt;/b&gt; (ordinal index), &lt;b&gt;stable network name&lt;/b&gt; (via headless Service),&#xa;and &lt;b&gt;stable storage&lt;/b&gt; (per-Pod PVC). Pods are created/deleted &lt;b&gt;in order&lt;/b&gt; (0, 1, 2...)." vertex="1">
          <mxGeometry height="30" width="700" x="50" y="495" as="geometry" />
        </mxCell>
        <mxCell id="sts-sts" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1BEE7;strokeColor=#8E24AA;fontSize=10;fontStyle=1;align=left;spacingLeft=8;" value="StatefulSet&#xa;(kafka)&#xa;replicas: 3&#xa;serviceName: kafka-headless" vertex="1">
          <mxGeometry height="70" width="180" x="60" y="575" as="geometry" />
        </mxCell>
        <mxCell id="sts-pod0" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#F9A825;fontSize=9;align=left;spacingLeft=5;" value="Pod: kafka-0&#xa;IP: 10.244.1.5&#xa;(stable ordinal)" vertex="1">
