        <mxCell id="cmfl-chart" value="Included in Flink Operator Helm Chart (automatic)" style="shape=mxgraph.gcp2.standard_rectangle;fillColor=#E8F5E9;strokeColor=#2E7D32;fontStyle=1;fontSize=12;verticalAlign=top;spacingTop=5;rounded=1;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="85" width="1000" height="200" as="geometry" />
        </mxCell>
        <mxCell id="cmfl-issuer" value="Issuer&#xa;flink-operator-selfsigned-issuer&#xa;spec: selfSigned: {}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#F9A825;fontSize=9;fontStyle=1;align=left;spacingLeft=8;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="60" y="120" width="240" height="45" as="geometry" />
        </mxCell>
        <mxCell id="cmfl-cert" value="Certificate&#xa;flink-operator-serving-cert&#xa;dnsNames:&#xa;  - flink-operator-webhook-service.&lt;ns&gt;.svc&#xa;  - flink-operator-webhook-service.&lt;ns&gt;.svc.cluster.local&#xa;keystores.pkcs12.create: true&#xa;secretName: webhook-server-cert" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#F9A825;fontSize=8;align=left;spacingLeft=8;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="360" y="105" width="370" height="95" as="geometry" />
        </mxCell>
        <mxCell id="cmfl-pwsecret" value="Secret: flink-operator-webhook-secret&#xa;└── password: (auto-generated or user-provided)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE4EC;strokeColor=#C62828;fontSize=8;align=left;spacingLeft=8;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="360" y="210" width="340" height="30" as="geometry" />
        </mxCell>
        <mxCell id="cmfl-secret" value="Secret: webhook-server-cert&#xa;├── tls.crt&#xa;├── tls.key&#xa;├── ca.crt&#xa;├── keystore.p12&#xa;└── truststore.p12" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE4EC;strokeColor=#C62828;fontSize=8;align=left;spacingLeft=8;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="790" y="105" width="200" height="90" as="geometry" />
        </mxCell>
        <!-- Arrows -->
        <mxCell id="cmfl-a1" style="rounded=1;strokeColor=#F9A825;strokeWidth=2;" edge="1" parent="1" source="cmfl-issuer" target="cmfl-cert">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="cmfl-a1-l" value="signs" style="edgeLabel;fontSize=8;fillColor=none;" connectable="0" vertex="1" parent="cmfl-a1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint y="-8" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="cmfl-a2" style="rounded=1;strokeColor=#C62828;strokeWidth=2;" edge="1" parent="1" source="cmfl-cert" target="cmfl-secret">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="cmfl-a2-l" value="creates" style="edgeLabel;fontSize=8;fillColor=none;" connectable="0" vertex="1" parent="cmfl-a2">
          <mxGeometry relative="1" as="geometry">
            <mxPoint y="-8" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="cmfl-a3" style="rounded=1;strokeColor=#C62828;dashed=1;" edge="1" parent="1" source="cmfl-cert" target="cmfl-pwsecret">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="cmfl-a3-l" value="reads password" style="edgeLabel;fontSize=7;fillColor=none;" connectable="0" vertex="1" parent="cmfl-a3">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="10" as="offset" />
          </mxGeometry>
        </mxCell>
        <!-- Operator pod -->
        <mxCell id="cmfl-pod" value="Flink Operator Pod&#xa;Mounts webhook-server-cert as volume&#xa;Webhook server on :9443" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C8E6C9;strokeColor=#2E7D32;fontSize=10;fontStyle=1;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="330" width="300" height="55" as="geometry" />
        </mxCell>
        <mxCell id="cmfl-pod-a" style="rounded=1;strokeColor=#2E7D32;strokeWidth=2;" edge="1" parent="1" source="cmfl-secret" target="cmfl-pod">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="cmfl-pod-a-l" value="mounted" style="edgeLabel;fontSize=8;fillColor=none;" connectable="0" vertex="1" parent="cmfl-pod-a">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- Webhooks -->
        <mxCell id="cmfl-wh" value="Webhooks (Flink Operator)" style="shape=mxgraph.gcp2.standard_rectangle;fillColor=#E3F2FD;strokeColor=#1565C0;fontStyle=1;fontSize=11;verticalAlign=top;spacingTop=5;rounded=1;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="440" y="310" width="400" height="90" as="geometry" />
        </mxCell>
        <mxCell id="cmfl-val" value="ValidatingWebhook&#xa;FlinkDeployment, FlinkSessionJob" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#1565C0;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="455" y="340" width="180" height="35" as="geometry" />
        </mxCell>
        <mxCell id="cmfl-mut" value="MutatingWebhook&#xa;FlinkDeployment (inject defaults)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#1565C0;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="645" y="340" width="180" height="35" as="geometry" />
        </mxCell>
        <!-- Comparison with CFK -->
        <mxCell id="cmfl-compare" value="&lt;table style=&#39;font-size:10px;border-collapse:collapse;width:100%&#39;&gt;&lt;tr style=&#39;background:#E3F2FD;font-weight:bold&#39;&gt;&lt;td style=&#39;padding:5px;border:1px solid #1565C0&#39;&gt;&lt;/td&gt;&lt;td style=&#39;padding:5px;border:1px solid #1565C0&#39;&gt;Flink Operator&lt;/td&gt;&lt;td style=&#39;padding:5px;border:1px solid #1565C0&#39;&gt;CFK Operator&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#39;padding:5px;border:1px solid #ccc;font-weight:bold&#39;&gt;Issuer + Certificate&lt;/td&gt;&lt;td style=&#39;padding:5px;border:1px solid #ccc;color:#2E7D32&#39;&gt;Bundled in Helm chart (automatic)&lt;/td&gt;&lt;td style=&#39;padding:5px;border:1px solid #ccc;color:#C62828&#39;&gt;Must be created manually&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#39;padding:5px;border:1px solid #ccc;font-weight:bold&#39;&gt;Keystore format&lt;/td&gt;&lt;td style=&#39;padding:5px;border:1px solid #ccc&#39;&gt;PKCS12 (native)&lt;/td&gt;&lt;td style=&#39;padding:5px;border:1px solid #ccc&#39;&gt;PKCS12 renamed to .jks&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#39;padding:5px;border:1px solid #ccc;font-weight:bold&#39;&gt;Volume projection&lt;/td&gt;&lt;td style=&#39;padding:5px;border:1px solid #ccc;color:#2E7D32&#39;&gt;Not needed&lt;/td&gt;&lt;td style=&#39;padding:5px;border:1px solid #ccc;color:#C62828&#39;&gt;Required (rename .p12 → .jks)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#39;padding:5px;border:1px solid #ccc;font-weight:bold&#39;&gt;Password file&lt;/td&gt;&lt;td style=&#39;padding:5px;border:1px solid #ccc;color:#2E7D32&#39;&gt;Handled by chart&lt;/td&gt;&lt;td style=&#39;padding:5px;border:1px solid #ccc;color:#C62828&#39;&gt;Separate secret needed&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#39;padding:5px;border:1px solid #ccc;font-weight:bold&#39;&gt;Webhook port&lt;/td&gt;&lt;td style=&#39;padding:5px;border:1px solid #ccc&#39;&gt;9443&lt;/td&gt;&lt;td style=&#39;padding:5px;border:1px solid #ccc&#39;&gt;8443&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;overflow=fill;rounded=1;whiteSpace=wrap;fillColor=#FAFAFA;strokeColor=#9E9E9E;" vertex="1" parent="1">
          <mxGeometry x="40" y="430" width="600" height="180" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="cm-cmf-flink-ref" name="Reference — cert-manager + CMF &amp; Flink Apps">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="cmfa-title" value="cert-manager Integration — CMF &amp; Flink Applications" style="text;html=1;fontSize=22;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="200" y="15" width="700" height="40" as="geometry" />
        </mxCell>
        <mxCell id="cmfa-subtitle" value="CMF uses OAuth (not TLS certs) for API auth. Flink jobs use Kafka&#39;s TLS certs for broker connections." style="text;html=1;fontSize=11;fontStyle=2;align=center;fontColor=#666;" vertex="1" parent="1">
          <mxGeometry x="150" y="50" width="800" height="20" as="geometry" />
        </mxCell>
        <!-- ===== CMF ===== -->
        <mxCell id="cmfa-cmf" value="CMF (Confluent Manager for Flink)" style="shape=mxgraph.gcp2.standard_rectangle;fillColor=#FFF8E1;strokeColor=#F9A825;fontStyle=1;fontSize=13;verticalAlign=top;spacingTop=5;rounded=1;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="85" width="1500" height="220" as="geometry" />
        </mxCell>
        <mxCell id="cmfa-cmf-pod" value="CMF Pod&#xa;REST API :8080 (HTTP)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#F9A825;fontSize=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="130" width="160" height="40" as="geometry" />
        </mxCell>
        <mxCell id="cmfa-cmf-okta" value="Okta&#xa;(OAuth2/OIDC)" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#1565C0;fontSize=10;fontStyle=1;size=0.15;" vertex="1" parent="1">
          <mxGeometry x="340" y="120" width="130" height="55" as="geometry" />
        </mxCell>
        <mxCell id="cmfa-cmf-mds" value="MDS on Kafka&#xa;:8090 (HTTPS)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C5CAE9;strokeColor=#3949AB;fontSize=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="340" y="195" width="130" height="40" as="geometry" />
        </mxCell>
        <mxCell id="cmfa-cmf-sql" value="SQL Server&#xa;:1433 (TLS)" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#CFD8DC;strokeColor=#546E7A;fontSize=10;fontStyle=1;size=8;" vertex="1" parent="1">
          <mxGeometry x="550" y="120" width="110" height="50" as="geometry" />
        </mxCell>
        <mxCell id="cmfa-cmf-a1" style="rounded=1;strokeColor=#1565C0;strokeWidth=2;" edge="1" parent="1" source="cmfa-cmf-pod" target="cmfa-cmf-okta">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="cmfa-cmf-a1-l" value="JWKS validation&#xa;(no cert needed)" style="edgeLabel;fontSize=8;fillColor=none;" connectable="0" vertex="1" parent="cmfa-cmf-a1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint y="-10" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="cmfa-cmf-a2" style="rounded=1;strokeColor=#3949AB;strokeWidth=2;" edge="1" parent="1" source="cmfa-cmf-pod" target="cmfa-cmf-mds">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="cmfa-cmf-a2-l" value="RBAC check&#xa;(uses Kafka&#39;s CA cert)" style="edgeLabel;fontSize=8;fillColor=none;" connectable="0" vertex="1" parent="cmfa-cmf-a2">
          <mxGeometry relative="1" as="geometry">
            <mxPoint y="12" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="cmfa-cmf-a3" style="rounded=1;strokeColor=#546E7A;strokeWidth=2;" edge="1" parent="1" source="cmfa-cmf-pod" target="cmfa-cmf-sql">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="cmfa-cmf-a3-l" value="JDBC + TLS&#xa;(password in K8s Secret)" style="edgeLabel;fontSize=8;fillColor=none;" connectable="0" vertex="1" parent="cmfa-cmf-a3">
          <mxGeometry relative="1" as="geometry">
            <mxPoint y="-10" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="cmfa-cmf-note" value="&lt;b&gt;CMF does not need its own TLS certificate from cert-manager.&lt;/b&gt;&lt;br&gt;It runs HTTP internally (:8080). Auth is via OAuth tokens, not mTLS.&lt;br&gt;It trusts Kafka&#39;s CA cert to connect to MDS over HTTPS." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#F9A825;fontSize=9;fontStyle=2;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="730" y="125" width="400" height="50" as="geometry" />
        </mxCell>
        <!-- ===== FLINK APPLICATIONS ===== -->
        <mxCell id="cmfa-flink" value="Flink Applications (Session &amp; Application Mode)" style="shape=mxgraph.gcp2.standard_rectangle;fillColor=#E8F5E9;strokeColor=#2E7D32;fontStyle=1;fontSize=13;verticalAlign=top;spacingTop=5;rounded=1;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="330" width="1500" height="300" as="geometry" />
        </mxCell>
        <mxCell id="cmfa-flink-desc" value="Flink jobs connect to Kafka (SASL_SSL + OAuth) and Schema Registry (HTTPS).&lt;br&gt;They need to &lt;b&gt;trust the CA&lt;/b&gt; that signed Kafka&#39;s and SR&#39;s TLS certs — not have their own server cert." style="text;html=1;fontSize=10;align=left;spacingLeft=5;" vertex="1" parent="1">
          <mxGeometry x="50" y="355" width="600" height="30" as="geometry" />
        </mxCell>
        <!-- Flink pods -->
        <mxCell id="cmfa-jm" value="JobManager" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#A5D6A7;strokeColor=#2E7D32;fontSize=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="410" width="110" height="35" as="geometry" />
        </mxCell>
        <mxCell id="cmfa-tm" value="TaskManagers" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#A5D6A7;strokeColor=#2E7D32;fontSize=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="460" width="110" height="35" as="geometry" />
        </mxCell>
        <!-- What they connect to -->
        <mxCell id="cmfa-kafka" value="Kafka Brokers&#xa;:9093 (SASL_SSL)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C5CAE9;strokeColor=#3949AB;fontSize=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="310" y="400" width="150" height="40" as="geometry" />
        </mxCell>
        <mxCell id="cmfa-sr" value="Schema Registry&#xa;:8081 (HTTPS)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C5CAE9;strokeColor=#3949AB;fontSize=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="310" y="455" width="150" height="40" as="geometry" />
        </mxCell>
        <mxCell id="cmfa-s3" value="S3 (NetApp)&#xa;Checkpoints" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#CFD8DC;strokeColor=#546E7A;fontSize=10;fontStyle=1;size=8;" vertex="1" parent="1">
          <mxGeometry x="310" y="510" width="110" height="45" as="geometry" />
        </mxCell>
        <mxCell id="cmfa-tm-kafka" style="rounded=1;strokeColor=#3949AB;strokeWidth=2;" edge="1" parent="1" source="cmfa-tm" target="cmfa-kafka">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="cmfa-tm-kafka-l" value="SASL_SSL + OAuth" style="edgeLabel;fontSize=8;fillColor=none;" connectable="0" vertex="1" parent="cmfa-tm-kafka">
          <mxGeometry relative="1" as="geometry">
            <mxPoint y="-8" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="cmfa-tm-sr" style="rounded=1;strokeColor=#3949AB;" edge="1" parent="1" source="cmfa-tm" target="cmfa-sr">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="cmfa-tm-sr-l" value="HTTPS" style="edgeLabel;fontSize=8;fillColor=none;" connectable="0" vertex="1" parent="cmfa-tm-sr">
          <mxGeometry relative="1" as="geometry">
            <mxPoint y="8" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="cmfa-tm-s3" style="rounded=1;strokeColor=#546E7A;" edge="1" parent="1" source="cmfa-tm" target="cmfa-s3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- How Flink trusts Kafka's cert -->
        <mxCell id="cmfa-trust" value="How Flink Trusts Kafka/SR Certificates" style="shape=mxgraph.gcp2.standard_rectangle;fillColor=#E3F2FD;strokeColor=#1565C0;fontStyle=1;fontSize=10;verticalAlign=top;spacingTop=3;rounded=1;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="550" y="390" width="500" height="150" as="geometry" />
        </mxCell>
        <mxCell id="cmfa-trust-desc" value="Flink jobs need the CA certificate that signed Kafka and SR&#39;s TLS certs.&#xa;This is provided via FlinkDeployment spec or environment configuration:" style="text;html=1;fontSize=9;align=left;spacingLeft=5;" vertex="1" parent="1">
          <mxGeometry x="560" y="415" width="480" height="25" as="geometry" />
        </mxCell>
        <mxCell id="cmfa-trust-opt1" value="Option 1: Mount ca.crt from Kafka&#39;s TLS secret&#xa;into Flink pods via flinkConfiguration&#xa;+ security.ssl.truststore" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#1565C0;fontSize=9;align=left;spacingLeft=5;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="560" y="445" width="310" height="40" as="geometry" />
        </mxCell>
        <mxCell id="cmfa-trust-opt2" value="Option 2: Add CA to JVM truststore&#xa;in custom Flink image" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#1565C0;fontSize=9;align=left;spacingLeft=5;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="560" y="495" width="230" height="30" as="geometry" />
        </mxCell>
        <!-- Summary -->
        <mxCell id="cmfa-summary" value="&lt;b&gt;Summary — What needs cert-manager certs:&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;table style=&#39;font-size:10px;border-collapse:collapse&#39;&gt;&lt;tr style=&#39;background:#E3F2FD;font-weight:bold&#39;&gt;&lt;td style=&#39;padding:4px;border:1px solid #1565C0&#39;&gt;Component&lt;/td&gt;&lt;td style=&#39;padding:4px;border:1px solid #1565C0&#39;&gt;Own TLS Cert?&lt;/td&gt;&lt;td style=&#39;padding:4px;border:1px solid #1565C0&#39;&gt;Trusts CA?&lt;/td&gt;&lt;td style=&#39;padding:4px;border:1px solid #1565C0&#39;&gt;Auth Method&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#39;padding:4px;border:1px solid #ccc&#39;&gt;CFK Operator webhook&lt;/td&gt;&lt;td style=&#39;padding:4px;border:1px solid #ccc;color:#2E7D32&#39;&gt;Yes (PKCS12)&lt;/td&gt;&lt;td style=&#39;padding:4px;border:1px solid #ccc&#39;&gt;API server via caBundle&lt;/td&gt;&lt;td style=&#39;padding:4px;border:1px solid #ccc&#39;&gt;TLS&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#39;padding:4px;border:1px solid #ccc&#39;&gt;Flink Operator webhook&lt;/td&gt;&lt;td style=&#39;padding:4px;border:1px solid #ccc;color:#2E7D32&#39;&gt;Yes (PKCS12, auto)&lt;/td&gt;&lt;td style=&#39;padding:4px;border:1px solid #ccc&#39;&gt;API server via caBundle&lt;/td&gt;&lt;td style=&#39;padding:4px;border:1px solid #ccc&#39;&gt;TLS&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#39;padding:4px;border:1px solid #ccc&#39;&gt;Kafka, KRaft, SR, Connect, CC&lt;/td&gt;&lt;td style=&#39;padding:4px;border:1px solid #ccc;color:#2E7D32&#39;&gt;Yes (PEM)&lt;/td&gt;&lt;td style=&#39;padding:4px;border:1px solid #ccc&#39;&gt;Each other&#39;s CA&lt;/td&gt;&lt;td style=&#39;padding:4px;border:1px solid #ccc&#39;&gt;TLS + OAuth&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#39;padding:4px;border:1px solid #ccc&#39;&gt;CMF&lt;/td&gt;&lt;td style=&#39;padding:4px;border:1px solid #ccc;color:#C62828&#39;&gt;No (HTTP internally)&lt;/td&gt;&lt;td style=&#39;padding:4px;border:1px solid #ccc&#39;&gt;Kafka&#39;s CA for MDS&lt;/td&gt;&lt;td style=&#39;padding:4px;border:1px solid #ccc&#39;&gt;OAuth&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#39;padding:4px;border:1px solid #ccc&#39;&gt;Flink jobs (JM/TM)&lt;/td&gt;&lt;td style=&#39;padding:4px;border:1px solid #ccc;color:#C62828&#39;&gt;No (clients only)&lt;/td&gt;&lt;td style=&#39;padding:4px;border:1px solid #ccc&#39;&gt;Kafka + SR CA&lt;/td&gt;&lt;td style=&#39;padding:4px;border:1px solid #ccc&#39;&gt;OAuth + TLS trust&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;overflow=fill;rounded=1;whiteSpace=wrap;fillColor=#FAFAFA;strokeColor=#9E9E9E;" vertex="1" parent="1">
          <mxGeometry x="40" y="660" width="700" height="200" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
