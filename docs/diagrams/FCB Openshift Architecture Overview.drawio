        <mxCell id="st-reclaim" parent="1" style="shape=mxgraph.gcp2.standard_rectangle;fillColor=#FCE4EC;strokeColor=#C62828;fontStyle=1;fontSize=13;verticalAlign=top;spacingTop=5;rounded=1;arcSize=8;" value="Reclaim Policies (what happens when PVC is deleted)" vertex="1">
          <mxGeometry height="140" width="730" x="130" y="735" as="geometry" />
        </mxCell>
        <mxCell id="st-reclaim-table" parent="1" style="text;html=1;overflow=fill;rounded=1;whiteSpace=wrap;fillColor=#FAFAFA;strokeColor=#C62828;" value="&lt;table style=&#39;font-size:10px;border-collapse:collapse;width:100%&#39;&gt;&lt;tr style=&#39;background:#FCE4EC;font-weight:bold&#39;&gt;&lt;td style=&#39;padding:4px;border:1px solid #C62828&#39;&gt;Policy&lt;/td&gt;&lt;td style=&#39;padding:4px;border:1px solid #C62828&#39;&gt;PV After PVC Deletion&lt;/td&gt;&lt;td style=&#39;padding:4px;border:1px solid #C62828&#39;&gt;Data&lt;/td&gt;&lt;td style=&#39;padding:4px;border:1px solid #C62828&#39;&gt;When to Use&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#39;padding:4px;border:1px solid #ccc;font-weight:bold&#39;&gt;Delete&lt;/td&gt;&lt;td style=&#39;padding:4px;border:1px solid #ccc&#39;&gt;PV and storage deleted&lt;/td&gt;&lt;td style=&#39;padding:4px;border:1px solid #ccc;color:red&#39;&gt;LOST&lt;/td&gt;&lt;td style=&#39;padding:4px;border:1px solid #ccc&#39;&gt;Ephemeral data (default for dynamic provisioning)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#39;padding:4px;border:1px solid #ccc;font-weight:bold&#39;&gt;Retain&lt;/td&gt;&lt;td style=&#39;padding:4px;border:1px solid #ccc&#39;&gt;PV becomes &quot;Released&quot; — manual cleanup&lt;/td&gt;&lt;td style=&#39;padding:4px;border:1px solid #ccc;color:green&#39;&gt;KEPT&lt;/td&gt;&lt;td style=&#39;padding:4px;border:1px solid #ccc&#39;&gt;Important data (Kafka logs, databases)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&#39;padding:4px;border:1px solid #ccc;font-weight:bold&#39;&gt;Recycle&lt;/td&gt;&lt;td style=&#39;padding:4px;border:1px solid #ccc&#39;&gt;Data wiped (rm -rf), PV available again&lt;/td&gt;&lt;td style=&#39;padding:4px;border:1px solid #ccc;color:orange&#39;&gt;WIPED&lt;/td&gt;&lt;td style=&#39;padding:4px;border:1px solid #ccc&#39;&gt;Deprecated — use dynamic provisioning&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" vertex="1">
          <mxGeometry height="100" width="700" x="145" y="765" as="geometry" />
        </mxCell>
        <mxCell id="st-right" parent="1" style="shape=mxgraph.gcp2.standard_rectangle;fillColor=#FAFAFA;strokeColor=#9E9E9E;rounded=1;arcSize=3;" value="" vertex="1">
