        </mxCell>
        <mxCell id="adm-subtitle" parent="1" style="text;html=1;fontSize=11;fontStyle=2;align=center;fontColor=#666666;" value="How CFK validates custom resources, secures the webhook with TLS, and reconciles desired state" vertex="1">
