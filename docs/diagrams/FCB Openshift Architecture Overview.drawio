        <mxCell id="cip-a2c" edge="1" parent="1" source="cip-svc" style="rounded=1;strokeColor=#1565C0;" target="cip-pod3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="cip-lb" parent="1" style="text;fontSize=8;fontStyle=2;fontColor=#1565C0;align=center;" value="round-robin" vertex="1">
          <mxGeometry height="15" width="70" x="440" y="185" as="geometry" />
        </mxCell>
        <mxCell id="cip-ep" parent="1" style="text;html=1;fontSize=8;fontStyle=2;fontColor=#999;align=center;" value="Endpoints object auto-updated&#xa;as Pods come and go" vertex="1">
          <mxGeometry height="25" width="110" x="520" y="125" as="geometry" />
        </mxCell>
        <mxCell id="np-group" parent="1" style="shape=mxgraph.gcp2.standard_rectangle;fillColor=#FFF3E0;strokeColor=#E65100;fontStyle=1;fontSize=13;verticalAlign=top;spacingTop=5;rounded=1;arcSize=8;" value="2. NodePort" vertex="1">
          <mxGeometry height="220" width="720" x="40" y="340" as="geometry" />
        </mxCell>
        <mxCell id="np-desc" parent="1" style="text;html=1;fontSize=10;align=left;spacingLeft=5;" value="Extends ClusterIP — opens a static port (30000–32767) on &lt;b&gt;every Node&lt;/b&gt;.&lt;br&gt;External traffic hits &lt;b&gt;NodeIP:NodePort&lt;/b&gt; → forwarded to ClusterIP → Pods." vertex="1">
          <mxGeometry height="30" width="500" x="50" y="365" as="geometry" />
        </mxCell>
        <mxCell id="np-ext" parent="1" style="shape=actor;whiteSpace=wrap;html=1;fillColor=#FFCCBC;strokeColor=#E65100;fontSize=9;" value="&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;External&lt;br&gt;Client" vertex="1">
          <mxGeometry height="50" width="50" x="50" y="430" as="geometry" />
        </mxCell>
        <mxCell id="np-node" parent="1" style="shape=mxgraph.gcp2.standard_rectangle;fillColor=#FFE0B2;strokeColor=#E65100;fontStyle=1;fontSize=10;verticalAlign=top;spacingTop=3;rounded=1;arcSize=10;" value="Node (any)" vertex="1">
          <mxGeometry height="65" width="180" x="180" y="415" as="geometry" />
        </mxCell>
        <mxCell id="np-nodeport" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;fontSize=9;" value="NodePort :31000&#xa;(open on 0.0.0.0)" vertex="1">
          <mxGeometry height="30" width="130" x="195" y="440" as="geometry" />
        </mxCell>
        <mxCell id="np-svc" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#1565C0;fontSize=9;fontStyle=1;" value="Service&#xa;(NodePort type)" vertex="1">
          <mxGeometry height="40" width="110" x="420" y="435" as="geometry" />
        </mxCell>
        <mxCell id="np-pod1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#F9A825;fontSize=9;" value="Pod A" vertex="1">
          <mxGeometry height="25" width="80" x="600" y="415" as="geometry" />
        </mxCell>
        <mxCell id="np-pod2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#F9A825;fontSize=9;" value="Pod B" vertex="1">
