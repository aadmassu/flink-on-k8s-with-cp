        <mxCell id="ly-title" parent="1" style="text;html=1;fontSize=22;fontStyle=1;align=center;verticalAlign=middle;" value="Kubernetes Stack Layers → Confluent Platform Mapping" vertex="1">
          <mxGeometry height="40" width="800" x="150" y="15" as="geometry" />
        </mxCell>
        <mxCell id="ly-subtitle" parent="1" style="text;html=1;fontSize=11;fontStyle=2;align=center;fontColor=#666;" value="Each K8s abstraction layer maps to a concrete Confluent Platform component" vertex="1">
          <mxGeometry height="20" width="600" x="250" y="50" as="geometry" />
        </mxCell>
        <mxCell id="ly-header-k8s" parent="1" style="text;html=1;fontSize=14;fontStyle=1;align=center;" value="Kubernetes Layer" vertex="1">
          <mxGeometry height="25" width="420" x="100" y="80" as="geometry" />
        </mxCell>
        <mxCell id="ly-header-cfk" parent="1" style="text;html=1;fontSize=14;fontStyle=1;align=center;" value="CFK / Confluent Platform" vertex="1">
          <mxGeometry height="25" width="500" x="620" y="80" as="geometry" />
        </mxCell>
        <mxCell id="ly7" parent="1" style="shape=process;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#1565C0;fontSize=12;fontStyle=1;size=0.04;shadow=1;" value="Client Application / External Access" vertex="1">
          <mxGeometry height="55" width="420" x="60" y="120" as="geometry" />
        </mxCell>
        <mxCell id="ly7-cfk" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;fontSize=9;align=left;spacingLeft=8;verticalAlign=top;spacingTop=5;" value="&lt;b&gt;Users / Developers&lt;/b&gt; → Control Center UI (HTTPS)&lt;br&gt;&lt;b&gt;Azure DevOps CI/CD&lt;/b&gt; → CMF REST API (deploy Flink SQL jobs)&lt;br&gt;&lt;b&gt;External producers/consumers&lt;/b&gt; → Kafka brokers (SASL_SSL)" vertex="1">
          <mxGeometry height="55" width="500" x="560" y="120" as="geometry" />
        </mxCell>
        <mxCell id="ly7-arrow" edge="1" parent="1" source="ly7" style="rounded=1;strokeColor=#1565C0;strokeWidth=2;dashed=1;" target="ly7-cfk">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ly6" parent="1" style="shape=process;whiteSpace=wrap;html=1;fillColor=#C8E6C9;strokeColor=#2E7D32;fontSize=12;fontStyle=1;size=0.04;shadow=1;" value="Ingress / Route / LoadBalancer" vertex="1">
          <mxGeometry height="55" width="420" x="60" y="195" as="geometry" />
        </mxCell>
        <mxCell id="ly6-cfk" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;fontSize=9;align=left;spacingLeft=8;verticalAlign=top;spacingTop=5;" value="&lt;b&gt;OpenShift Routes&lt;/b&gt; (TLS edge termination)&lt;br&gt;→ schemaregistry.{env}.confluent.fcbint.net&lt;br&gt;→ controlcenter.{env}.confluent.fcbint.net&lt;br&gt;→ kafka broker-0/1/2 routes" vertex="1">
          <mxGeometry height="55" width="500" x="560" y="195" as="geometry" />
        </mxCell>
        <mxCell id="ly6-arrow" edge="1" parent="1" source="ly6" style="rounded=1;strokeColor=#2E7D32;strokeWidth=2;dashed=1;" target="ly6-cfk">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ly5" parent="1" style="shape=process;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#F9A825;fontSize=12;fontStyle=1;size=0.04;shadow=1;" value="Service (ClusterIP / Headless)" vertex="1">
          <mxGeometry height="55" width="420" x="60" y="270" as="geometry" />
        </mxCell>
        <mxCell id="ly5-cfk" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#F9A825;fontSize=9;align=left;spacingLeft=8;verticalAlign=top;spacingTop=5;" value="&lt;b&gt;ClusterIP:&lt;/b&gt; kafka:9071, schemaregistry:8081, connect:8083, controlcenter:9021, cmf-service:80&lt;br&gt;&lt;b&gt;Headless:&lt;/b&gt; kafka-headless, kraftcontroller-headless (per-Pod DNS for StatefulSets)" vertex="1">
          <mxGeometry height="55" width="500" x="560" y="270" as="geometry" />
        </mxCell>
        <mxCell id="ly5-arrow" edge="1" parent="1" source="ly5" style="rounded=1;strokeColor=#F9A825;strokeWidth=2;dashed=1;" target="ly5-cfk">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ly4" parent="1" style="shape=process;whiteSpace=wrap;html=1;fillColor=#CE93D8;strokeColor=#8E24AA;fontSize=12;fontStyle=1;size=0.04;shadow=1;" value="Deployment / StatefulSet" vertex="1">
          <mxGeometry height="70" width="420" x="60" y="345" as="geometry" />
        </mxCell>
        <mxCell id="ly4-cfk" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#8E24AA;fontSize=9;align=left;spacingLeft=8;verticalAlign=top;spacingTop=5;" value="&lt;b&gt;StatefulSets:&lt;/b&gt; Kafka (3), KRaftController (3) — stable identity, per-Pod PVC&lt;br&gt;&lt;b&gt;Deployments:&lt;/b&gt; SchemaRegistry, Connect, ControlCenter, CMF,&lt;br&gt;    CFK Operator (2 HA), Flink Operator (2 HA),&lt;br&gt;    Flink JobManager, Flink TaskManagers" vertex="1">
          <mxGeometry height="70" width="500" x="560" y="345" as="geometry" />
        </mxCell>
        <mxCell id="ly4-arrow" edge="1" parent="1" source="ly4" style="rounded=1;strokeColor=#8E24AA;strokeWidth=2;dashed=1;" target="ly4-cfk">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ly3" parent="1" style="shape=process;whiteSpace=wrap;html=1;fillColor=#FFCCBC;strokeColor=#E65100;fontSize=12;fontStyle=1;size=0.04;shadow=1;" value="Pod (Container Runtime)" vertex="1">
          <mxGeometry height="70" width="420" x="60" y="435" as="geometry" />
        </mxCell>
        <mxCell id="ly3-cfk" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#E65100;fontSize=9;align=left;spacingLeft=8;verticalAlign=top;spacingTop=5;" value="&lt;b&gt;kafka-0, kafka-1, kafka-2&lt;/b&gt; — Confluent Server 8.1.1 (broker + MDS :8090)&lt;br&gt;&lt;b&gt;kraftcontroller-0/1/2&lt;/b&gt; — KRaft metadata quorum&lt;br&gt;&lt;b&gt;schemaregistry-*&lt;/b&gt;, &lt;b&gt;connect-*&lt;/b&gt;, &lt;b&gt;controlcenter-*&lt;/b&gt;, &lt;b&gt;cmf-*&lt;/b&gt;&lt;br&gt;&lt;b&gt;flink-session-dispatcher&lt;/b&gt; (JM), &lt;b&gt;flink-session-taskmanager&lt;/b&gt; (TMs)" vertex="1">
          <mxGeometry height="70" width="500" x="560" y="435" as="geometry" />
        </mxCell>
        <mxCell id="ly3-arrow" edge="1" parent="1" source="ly3" style="rounded=1;strokeColor=#E65100;strokeWidth=2;dashed=1;" target="ly3-cfk">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ly2" parent="1" style="shape=process;whiteSpace=wrap;html=1;fillColor=#D7CCC8;strokeColor=#6D4C41;fontSize=12;fontStyle=1;size=0.04;shadow=1;" value="Node (Worker Machine)" vertex="1">
          <mxGeometry height="55" width="420" x="60" y="525" as="geometry" />
        </mxCell>
        <mxCell id="ly2-cfk" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFEBE9;strokeColor=#6D4C41;fontSize=9;align=left;spacingLeft=8;verticalAlign=top;spacingTop=5;" value="&lt;b&gt;Worker nodes&lt;/b&gt; (xlworker pool at FCB)&lt;br&gt;Pod anti-affinity spreads Kafka/KRaft across zones (topology.kubernetes.io/zone)&lt;br&gt;Tolerations allow scheduling on dedicated xlworker tainted nodes" vertex="1">
          <mxGeometry height="55" width="500" x="560" y="525" as="geometry" />
        </mxCell>
        <mxCell id="ly2-arrow" edge="1" parent="1" source="ly2" style="rounded=1;strokeColor=#6D4C41;strokeWidth=2;dashed=1;" target="ly2-cfk">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ly1" parent="1" style="shape=process;whiteSpace=wrap;html=1;fillColor=#CFD8DC;strokeColor=#546E7A;fontSize=12;fontStyle=1;size=0.04;shadow=1;" value="Storage (PVC → PV → Physical)" vertex="1">
          <mxGeometry height="70" width="420" x="60" y="600" as="geometry" />
        </mxCell>
        <mxCell id="ly1-cfk" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECEFF1;strokeColor=#546E7A;fontSize=9;align=left;spacingLeft=8;verticalAlign=top;spacingTop=5;" value="&lt;b&gt;RWO (block):&lt;/b&gt; datadir-kafka-* (3×50Gi), datadir-kraftcontroller-* (3×10Gi), controlcenter (10Gi)&lt;br&gt;&lt;b&gt;RWX (NFS/NetApp):&lt;/b&gt; flink-pvc (10Gi) — shared across Flink TMs&lt;br&gt;&lt;b&gt;External S3 (NetApp):&lt;/b&gt; Flink checkpoints &amp; savepoints&lt;br&gt;&lt;b&gt;External SQL Server:&lt;/b&gt; CMF catalog database" vertex="1">
          <mxGeometry height="70" width="500" x="560" y="600" as="geometry" />
        </mxCell>
        <mxCell id="ly1-arrow" edge="1" parent="1" source="ly1" style="rounded=1;strokeColor=#546E7A;strokeWidth=2;dashed=1;" target="ly1-cfk">
