        <!-- ===== 5. CR STATUS ===== -->
        <mxCell id="adm-status" value="5. CR Status Phases" style="shape=mxgraph.gcp2.standard_rectangle;fillColor=#FFF8E1;strokeColor=#F9A825;fontStyle=1;fontSize=13;verticalAlign=top;spacingTop=5;rounded=1;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="1120" width="1500" height="130" as="geometry" />
        </mxCell>
        <mxCell id="adm-phase-prov" value="PROVISIONING" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#1565C0;fontSize=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="1160" width="120" height="30" as="geometry" />
        </mxCell>
        <mxCell id="adm-phase-run" value="RUNNING" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C8E6C9;strokeColor=#2E7D32;fontSize=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="260" y="1160" width="100" height="30" as="geometry" />
        </mxCell>
        <mxCell id="adm-phase-roll" value="ROLLING UPDATE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;fontSize=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="420" y="1160" width="130" height="30" as="geometry" />
        </mxCell>
        <mxCell id="adm-phase-err" value="ERROR" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFCDD2;strokeColor=#C62828;fontSize=10;fontStyle=1;" vertex="1" parent="1">
