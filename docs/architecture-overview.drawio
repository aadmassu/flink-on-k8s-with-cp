  <!-- ==================== TAB 3: Kubernetes Services ==================== -->
  <diagram id="k8s-services-ref" name="Reference — Kubernetes Services">
    <mxGraphModel dx="1600" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="svc-title" value="Kubernetes Services — How They Work" style="text;html=1;fontSize=22;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="300" y="15" width="500" height="40" as="geometry" />
        </mxCell>
        <mxCell id="svc-subtitle" value="A Service provides a stable network endpoint that routes traffic to a dynamic set of Pods selected by labels." style="text;html=1;fontSize=11;fontStyle=2;align=center;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="200" y="50" width="700" height="25" as="geometry" />
        </mxCell>

        <!-- ==================== 1. ClusterIP ==================== -->
        <mxCell id="cip-group" value="1. ClusterIP (default)" style="shape=mxgraph.gcp2.standard_rectangle;fillColor=#E3F2FD;strokeColor=#1565C0;fontStyle=1;fontSize=13;verticalAlign=top;spacingTop=5;rounded=1;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="90" width="720" height="230" as="geometry" />
        </mxCell>
        <mxCell id="cip-desc" value="Internal-only virtual IP reachable from within the cluster.&lt;br&gt;Other Pods reach it via DNS: &lt;b&gt;&amp;lt;svc&amp;gt;.&amp;lt;ns&amp;gt;.svc.cluster.local&lt;/b&gt;" style="text;html=1;fontSize=10;align=left;spacingLeft=5;" vertex="1" parent="1">
          <mxGeometry x="50" y="115" width="400" height="35" as="geometry" />
        </mxCell>
        <mxCell id="cip-client" value="Client Pod" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C8E6C9;strokeColor=#2E7D32;fontSize=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="175" width="100" height="40" as="geometry" />
        </mxCell>
        <mxCell id="cip-svc" value="Service (ClusterIP)&#xa;10.96.x.x:8080&#xa;selector: app=myapp" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#1565C0;fontSize=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="250" y="165" width="170" height="55" as="geometry" />
        </mxCell>
        <mxCell id="cip-kproxy" value="kube-proxy (iptables/IPVS rules)" style="text;html=1;fontSize=8;fontStyle=2;fontColor=#666;align=center;" vertex="1" parent="1">
          <mxGeometry x="260" y="225" width="155" height="15" as="geometry" />
        </mxCell>
        <mxCell id="cip-pod1" value="Pod A&#xa;10.244.1.5:8080" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#F9A825;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="520" y="155" width="110" height="30" as="geometry" />
        </mxCell>
        <mxCell id="cip-pod2" value="Pod B&#xa;10.244.2.8:8080" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#F9A825;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="520" y="190" width="110" height="30" as="geometry" />
        </mxCell>
        <mxCell id="cip-pod3" value="Pod C&#xa;10.244.3.2:8080" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#F9A825;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="520" y="225" width="110" height="30" as="geometry" />
        </mxCell>
        <mxCell id="cip-a1" style="rounded=1;strokeColor=#1565C0;strokeWidth=2;" edge="1" parent="1" source="cip-client" target="cip-svc">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="cip-a1-l" value="DNS →&#xa;ClusterIP:port" style="edgeLabel;fontSize=8;fillColor=none;" connectable="0" vertex="1" parent="cip-a1">
          <mxGeometry relative="1" as="geometry"><mxPoint y="-10" as="offset" /></mxGeometry>
        </mxCell>
        <mxCell id="cip-a2a" style="rounded=1;strokeColor=#1565C0;" edge="1" parent="1" source="cip-svc" target="cip-pod1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="cip-a2b" style="rounded=1;strokeColor=#1565C0;" edge="1" parent="1" source="cip-svc" target="cip-pod2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="cip-a2c" style="rounded=1;strokeColor=#1565C0;" edge="1" parent="1" source="cip-svc" target="cip-pod3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="cip-lb" value="round-robin" style="text;fontSize=8;fontStyle=2;fontColor=#1565C0;align=center;" vertex="1" parent="1">
          <mxGeometry x="440" y="185" width="70" height="15" as="geometry" />
        </mxCell>
        <mxCell id="cip-ep" value="Endpoints object auto-updated&#xa;as Pods come and go" style="text;html=1;fontSize=8;fontStyle=2;fontColor=#999;align=left;" vertex="1" parent="1">
          <mxGeometry x="640" y="200" width="110" height="25" as="geometry" />
        </mxCell>

        <!-- ==================== 2. NodePort ==================== -->
        <mxCell id="np-group" value="2. NodePort" style="shape=mxgraph.gcp2.standard_rectangle;fillColor=#FFF3E0;strokeColor=#E65100;fontStyle=1;fontSize=13;verticalAlign=top;spacingTop=5;rounded=1;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="340" width="720" height="220" as="geometry" />
        </mxCell>
        <mxCell id="np-desc" value="Extends ClusterIP — opens a static port (30000–32767) on &lt;b&gt;every Node&lt;/b&gt;.&lt;br&gt;External traffic hits &lt;b&gt;NodeIP:NodePort&lt;/b&gt; → forwarded to ClusterIP → Pods." style="text;html=1;fontSize=10;align=left;spacingLeft=5;" vertex="1" parent="1">
          <mxGeometry x="50" y="365" width="500" height="30" as="geometry" />
        </mxCell>
        <mxCell id="np-ext" value="External&#xa;Client" style="shape=actor;whiteSpace=wrap;html=1;fillColor=#FFCCBC;strokeColor=#E65100;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="60" y="420" width="50" height="50" as="geometry" />
        </mxCell>
        <mxCell id="np-node" value="Node (any)" style="shape=mxgraph.gcp2.standard_rectangle;fillColor=#FFE0B2;strokeColor=#E65100;fontStyle=1;fontSize=10;verticalAlign=top;spacingTop=3;rounded=1;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="180" y="415" width="180" height="65" as="geometry" />
        </mxCell>
        <mxCell id="np-nodeport" value="NodePort :31000&#xa;(open on 0.0.0.0)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="195" y="440" width="130" height="30" as="geometry" />
        </mxCell>
        <mxCell id="np-svc" value="Service&#xa;(NodePort type)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#1565C0;fontSize=9;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="420" y="425" width="110" height="40" as="geometry" />
        </mxCell>
        <mxCell id="np-pod1" value="Pod A" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#F9A825;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="600" y="415" width="80" height="25" as="geometry" />
        </mxCell>
        <mxCell id="np-pod2" value="Pod B" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#F9A825;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="600" y="448" width="80" height="25" as="geometry" />
        </mxCell>
        <mxCell id="np-a1" style="rounded=1;strokeColor=#E65100;strokeWidth=2;" edge="1" parent="1" source="np-ext" target="np-nodeport">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="np-a1-l" value="NodeIP:31000" style="edgeLabel;fontSize=8;fillColor=none;" connectable="0" vertex="1" parent="np-a1">
          <mxGeometry relative="1" as="geometry"><mxPoint y="-10" as="offset" /></mxGeometry>
        </mxCell>
        <mxCell id="np-a2" style="rounded=1;strokeColor=#1565C0;" edge="1" parent="1" source="np-nodeport" target="np-svc">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="np-a3a" style="rounded=1;strokeColor=#1565C0;" edge="1" parent="1" source="np-svc" target="np-pod1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="np-a3b" style="rounded=1;strokeColor=#1565C0;" edge="1" parent="1" source="np-svc" target="np-pod2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="np-note" value="Every node listens on the same NodePort, even if no target Pods run on that node." style="text;html=1;fontSize=9;fontStyle=2;fontColor=#999;align=left;" vertex="1" parent="1">
          <mxGeometry x="50" y="500" width="400" height="15" as="geometry" />
        </mxCell>
        <mxCell id="np-rare" value="Rarely used directly in production — usually a building block for LoadBalancer." style="text;html=1;fontSize=9;fontStyle=2;fontColor=#999;align=left;" vertex="1" parent="1">
          <mxGeometry x="50" y="520" width="400" height="15" as="geometry" />
        </mxCell>

        <!-- ==================== 3. LoadBalancer ==================== -->
        <mxCell id="lb-group" value="3. LoadBalancer" style="shape=mxgraph.gcp2.standard_rectangle;fillColor=#E8F5E9;strokeColor=#2E7D32;fontStyle=1;fontSize=13;verticalAlign=top;spacingTop=5;rounded=1;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="580" width="720" height="220" as="geometry" />
        </mxCell>
        <mxCell id="lb-desc" value="Extends NodePort — provisions an &lt;b&gt;external cloud load balancer&lt;/b&gt; (AWS ELB/NLB, GCP LB).&lt;br&gt;Gives you a stable external IP or DNS name. &lt;b&gt;LoadBalancer = Cloud LB + NodePort + ClusterIP&lt;/b&gt;." style="text;html=1;fontSize=10;align=left;spacingLeft=5;" vertex="1" parent="1">
          <mxGeometry x="50" y="605" width="600" height="30" as="geometry" />
        </mxCell>
        <mxCell id="lb-internet" value="External&#xa;Client" style="shape=actor;whiteSpace=wrap;html=1;fillColor=#C8E6C9;strokeColor=#2E7D32;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="60" y="665" width="50" height="50" as="geometry" />
        </mxCell>
        <mxCell id="lb-cloud" value="Cloud Load Balancer&#xa;(external IP: 34.x.x.x)&#xa;provisioned automatically" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#A5D6A7;strokeColor=#2E7D32;fontSize=9;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="180" y="660" width="170" height="50" as="geometry" />
        </mxCell>
        <mxCell id="lb-np" value="NodePort&#xa;(auto-allocated)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="410" y="655" width="100" height="30" as="geometry" />
        </mxCell>
        <mxCell id="lb-cip" value="ClusterIP" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#1565C0;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="410" y="692" width="100" height="25" as="geometry" />
        </mxCell>
        <mxCell id="lb-pod1" value="Pod A" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#F9A825;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="580" y="655" width="80" height="25" as="geometry" />
        </mxCell>
        <mxCell id="lb-pod2" value="Pod B" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#F9A825;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="580" y="690" width="80" height="25" as="geometry" />
        </mxCell>
        <mxCell id="lb-a1" style="rounded=1;strokeColor=#2E7D32;strokeWidth=2;" edge="1" parent="1" source="lb-internet" target="lb-cloud">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="lb-a2" style="rounded=1;strokeColor=#E65100;" edge="1" parent="1" source="lb-cloud" target="lb-np">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="lb-a3a" style="rounded=1;strokeColor=#1565C0;" edge="1" parent="1" source="lb-np" target="lb-pod1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="lb-a3b" style="rounded=1;strokeColor=#1565C0;" edge="1" parent="1" source="lb-cip" target="lb-pod2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="lb-ocp-note" value="&lt;b&gt;In OpenShift&lt;/b&gt;, Routes replace LoadBalancer Services. The HAProxy-based Router&#xa;watches Route objects and provides ingress with TLS termination and hostname-based routing." style="text;html=1;fontSize=9;fontStyle=2;fontColor=#C62828;align=left;" vertex="1" parent="1">
          <mxGeometry x="50" y="740" width="500" height="30" as="geometry" />
        </mxCell>

        <!-- ==================== 4. Headless ==================== -->
        <mxCell id="hl-group" value="4. Headless Service (clusterIP: None)" style="shape=mxgraph.gcp2.standard_rectangle;fillColor=#F3E5F5;strokeColor=#8E24AA;fontStyle=1;fontSize=13;verticalAlign=top;spacingTop=5;rounded=1;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="820" width="720" height="280" as="geometry" />
        </mxCell>
        <mxCell id="hl-desc" value="No virtual IP. DNS returns &lt;b&gt;individual Pod IPs&lt;/b&gt; (A records). Each Pod gets a stable DNS name:&lt;br&gt;&lt;b&gt;&amp;lt;pod-name&amp;gt;.&amp;lt;svc&amp;gt;.&amp;lt;ns&amp;gt;.svc.cluster.local&lt;/b&gt; — essential for StatefulSets (Kafka, databases)." style="text;html=1;fontSize=10;align=left;spacingLeft=5;" vertex="1" parent="1">
          <mxGeometry x="50" y="848" width="600" height="35" as="geometry" />
        </mxCell>
        <mxCell id="hl-client" value="Client Pod" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C8E6C9;strokeColor=#2E7D32;fontSize=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="910" width="100" height="35" as="geometry" />
        </mxCell>
        <mxCell id="hl-dns" value="CoreDNS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1BEE7;strokeColor=#8E24AA;fontSize=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="240" y="910" width="100" height="35" as="geometry" />
        </mxCell>
        <mxCell id="hl-nosvc" value="No ClusterIP!&#xa;(clusterIP: None)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#8E24AA;fontSize=8;fontStyle=2;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="240" y="950" width="100" height="25" as="geometry" />
        </mxCell>
        <mxCell id="hl-pod0" value="kafka-0.kafka-headless&#xa;.ns.svc.cluster.local&#xa;→ 10.244.1.5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#F9A825;fontSize=8;align=left;spacingLeft=5;" vertex="1" parent="1">
          <mxGeometry x="430" y="893" width="175" height="40" as="geometry" />
        </mxCell>
        <mxCell id="hl-pod1" value="kafka-1.kafka-headless&#xa;.ns.svc.cluster.local&#xa;→ 10.244.2.8" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#F9A825;fontSize=8;align=left;spacingLeft=5;" vertex="1" parent="1">
          <mxGeometry x="430" y="940" width="175" height="40" as="geometry" />
        </mxCell>
        <mxCell id="hl-pod2" value="kafka-2.kafka-headless&#xa;.ns.svc.cluster.local&#xa;→ 10.244.3.2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#F9A825;fontSize=8;align=left;spacingLeft=5;" vertex="1" parent="1">
          <mxGeometry x="430" y="987" width="175" height="40" as="geometry" />
        </mxCell>
        <mxCell id="hl-a1" style="rounded=1;strokeColor=#8E24AA;strokeWidth=2;" edge="1" parent="1" source="hl-client" target="hl-dns">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="hl-a1-l" value="DNS query" style="edgeLabel;fontSize=8;fillColor=none;" connectable="0" vertex="1" parent="hl-a1">
          <mxGeometry relative="1" as="geometry"><mxPoint y="-10" as="offset" /></mxGeometry>
        </mxCell>
        <mxCell id="hl-a2a" style="rounded=1;strokeColor=#8E24AA;dashed=1;" edge="1" parent="1" source="hl-dns" target="hl-pod0">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="hl-a2b" style="rounded=1;strokeColor=#8E24AA;dashed=1;" edge="1" parent="1" source="hl-dns" target="hl-pod1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="hl-a2c" style="rounded=1;strokeColor=#8E24AA;dashed=1;" edge="1" parent="1" source="hl-dns" target="hl-pod2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="hl-returns" value="returns all Pod IPs&#xa;(client picks one)" style="text;fontSize=8;fontStyle=2;fontColor=#8E24AA;align=center;" vertex="1" parent="1">
          <mxGeometry x="355" y="910" width="70" height="25" as="geometry" />
        </mxCell>
        <mxCell id="hl-direct" value="Client connects directly to a specific Pod — no load balancing layer" style="text;html=1;fontSize=9;fontStyle=2;fontColor=#999;align=left;" vertex="1" parent="1">
          <mxGeometry x="50" y="1050" width="400" height="15" as="geometry" />
        </mxCell>

        <!-- ==================== COMPARISON TABLE ==================== -->
        <mxCell id="svc-comparison" value="&lt;table style='font-size:10px;border-collapse:collapse;width:100%'&gt;&lt;tr style='background:#E3F2FD;font-weight:bold'&gt;&lt;td style='padding:5px;border:1px solid #1565C0'&gt;Type&lt;/td&gt;&lt;td style='padding:5px;border:1px solid #1565C0'&gt;ClusterIP&lt;/td&gt;&lt;td style='padding:5px;border:1px solid #1565C0'&gt;External IP&lt;/td&gt;&lt;td style='padding:5px;border:1px solid #1565C0'&gt;Load Balanced&lt;/td&gt;&lt;td style='padding:5px;border:1px solid #1565C0'&gt;Pod DNS&lt;/td&gt;&lt;td style='padding:5px;border:1px solid #1565C0'&gt;Use Case&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:5px;border:1px solid #ccc;font-weight:bold;background:#E3F2FD'&gt;ClusterIP&lt;/td&gt;&lt;td style='padding:5px;border:1px solid #ccc'&gt;Yes&lt;/td&gt;&lt;td style='padding:5px;border:1px solid #ccc'&gt;No&lt;/td&gt;&lt;td style='padding:5px;border:1px solid #ccc'&gt;Yes (internal)&lt;/td&gt;&lt;td style='padding:5px;border:1px solid #ccc'&gt;No&lt;/td&gt;&lt;td style='padding:5px;border:1px solid #ccc'&gt;Internal microservice communication&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:5px;border:1px solid #ccc;font-weight:bold;background:#FFF3E0'&gt;NodePort&lt;/td&gt;&lt;td style='padding:5px;border:1px solid #ccc'&gt;Yes&lt;/td&gt;&lt;td style='padding:5px;border:1px solid #ccc'&gt;NodeIP:Port&lt;/td&gt;&lt;td style='padding:5px;border:1px solid #ccc'&gt;Yes&lt;/td&gt;&lt;td style='padding:5px;border:1px solid #ccc'&gt;No&lt;/td&gt;&lt;td style='padding:5px;border:1px solid #ccc'&gt;Dev/testing, non-cloud&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:5px;border:1px solid #ccc;font-weight:bold;background:#E8F5E9'&gt;LoadBalancer&lt;/td&gt;&lt;td style='padding:5px;border:1px solid #ccc'&gt;Yes&lt;/td&gt;&lt;td style='padding:5px;border:1px solid #ccc'&gt;Cloud LB IP&lt;/td&gt;&lt;td style='padding:5px;border:1px solid #ccc'&gt;Yes (external)&lt;/td&gt;&lt;td style='padding:5px;border:1px solid #ccc'&gt;No&lt;/td&gt;&lt;td style='padding:5px;border:1px solid #ccc'&gt;Production external traffic&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:5px;border:1px solid #ccc;font-weight:bold;background:#F3E5F5'&gt;Headless&lt;/td&gt;&lt;td style='padding:5px;border:1px solid #ccc'&gt;None&lt;/td&gt;&lt;td style='padding:5px;border:1px solid #ccc'&gt;No&lt;/td&gt;&lt;td style='padding:5px;border:1px solid #ccc'&gt;No (client picks)&lt;/td&gt;&lt;td style='padding:5px;border:1px solid #ccc'&gt;Yes&lt;/td&gt;&lt;td style='padding:5px;border:1px solid #ccc'&gt;StatefulSets (Kafka, DBs)&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;overflow=fill;rounded=1;whiteSpace=wrap;fillColor=#FAFAFA;strokeColor=#9E9E9E;" vertex="1" parent="1">
          <mxGeometry x="800" y="90" width="700" height="160" as="geometry" />
        </mxCell>

        <!-- Key Concepts -->
        <mxCell id="svc-concepts" value="" style="shape=mxgraph.gcp2.standard_rectangle;fillColor=#FAFAFA;strokeColor=#9E9E9E;rounded=1;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="800" y="270" width="700" height="300" as="geometry" />
        </mxCell>
        <mxCell id="svc-concepts-title" value="Key Concepts" style="text;html=1;fontSize=13;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="810" y="275" width="200" height="25" as="geometry" />
        </mxCell>
        <mxCell id="svc-c1" value="&lt;b&gt;Selector&lt;/b&gt; — Label query (e.g. app=kafka) that determines which Pods belong to the Service.&lt;br&gt;K8s watches for matching Pods and updates the Endpoints object automatically." style="text;html=1;fontSize=10;align=left;spacingLeft=5;" vertex="1" parent="1">
          <mxGeometry x="810" y="300" width="680" height="30" as="geometry" />
        </mxCell>
        <mxCell id="svc-c2" value="&lt;b&gt;Endpoints&lt;/b&gt; — Auto-managed object listing all Pod IPs matching the selector.&lt;br&gt;When a Pod starts/stops or fails readiness probes, its IP is added/removed." style="text;html=1;fontSize=10;align=left;spacingLeft=5;" vertex="1" parent="1">
          <mxGeometry x="810" y="335" width="680" height="30" as="geometry" />
        </mxCell>
        <mxCell id="svc-c3" value="&lt;b&gt;kube-proxy&lt;/b&gt; — Runs on every node. Programs iptables/IPVS rules to route ClusterIP traffic to Pod IPs." style="text;html=1;fontSize=10;align=left;spacingLeft=5;" vertex="1" parent="1">
          <mxGeometry x="810" y="370" width="680" height="20" as="geometry" />
        </mxCell>
        <mxCell id="svc-c4" value="&lt;b&gt;Port vs TargetPort&lt;/b&gt; — port is what the Service listens on; targetPort is the container port.&lt;br&gt;Example: Service port=80, targetPort=8080 → clients call :80, traffic hits Pod :8080." style="text;html=1;fontSize=10;align=left;spacingLeft=5;" vertex="1" parent="1">
          <mxGeometry x="810" y="395" width="680" height="30" as="geometry" />
        </mxCell>
        <mxCell id="svc-c5" value="&lt;b&gt;Session Affinity&lt;/b&gt; — sessionAffinity=ClientIP makes the same client always reach the same Pod. Default is None (round-robin)." style="text;html=1;fontSize=10;align=left;spacingLeft=5;" vertex="1" parent="1">
          <mxGeometry x="810" y="430" width="680" height="20" as="geometry" />
        </mxCell>
        <mxCell id="svc-c6" value="&lt;b&gt;ExternalName&lt;/b&gt; — 5th type (not shown): returns a CNAME pointing to an external DNS name. No proxying. Aliases external services." style="text;html=1;fontSize=10;align=left;spacingLeft=5;" vertex="1" parent="1">
          <mxGeometry x="810" y="455" width="680" height="20" as="geometry" />
        </mxCell>
        <mxCell id="svc-c7" value="&lt;b&gt;DNS Format&lt;/b&gt;:  Service → &lt;code&gt;&amp;lt;svc&amp;gt;.&amp;lt;ns&amp;gt;.svc.cluster.local&lt;/code&gt;  |  Headless Pod → &lt;code&gt;&amp;lt;pod&amp;gt;.&amp;lt;svc&amp;gt;.&amp;lt;ns&amp;gt;.svc.cluster.local&lt;/code&gt;" style="text;html=1;fontSize=10;align=left;spacingLeft=5;" vertex="1" parent="1">
          <mxGeometry x="810" y="480" width="680" height="20" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>

  <!-- ==================== TAB 4: Kubernetes Storage ==================== -->
  <diagram id="k8s-storage-ref" name="Reference — Kubernetes Storage">
    <mxGraphModel dx="1600" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="st-title" value="Kubernetes Storage — How It Works" style="text;html=1;fontSize=22;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="300" y="15" width="500" height="40" as="geometry" />
        </mxCell>
        <mxCell id="st-subtitle" value="Storage in K8s decouples what a Pod needs (PVC) from how it is provisioned (PV / StorageClass)." style="text;html=1;fontSize=11;fontStyle=2;align=center;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="150" y="50" width="800" height="25" as="geometry" />
        </mxCell>

        <!-- ===== THE CHAIN ===== -->
        <mxCell id="st-chain" value="The Storage Chain" style="shape=mxgraph.gcp2.standard_rectangle;fillColor=#E3F2FD;strokeColor=#1565C0;fontStyle=1;fontSize=13;verticalAlign=top;spacingTop=5;rounded=1;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="90" width="1500" height="190" as="geometry" />
        </mxCell>
        <mxCell id="st-pod" value="Pod&#xa;(container)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C8E6C9;strokeColor=#2E7D32;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="70" y="130" width="110" height="45" as="geometry" />
        </mxCell>
        <mxCell id="st-pod-yaml" value="volumeMounts:&#xa;- mountPath: /data&#xa;  name: my-storage" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;fontSize=8;align=left;spacingLeft=5;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="70" y="180" width="145" height="40" as="geometry" />
        </mxCell>
        <mxCell id="st-pvc" value="PersistentVolumeClaim&#xa;(PVC)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1BEE7;strokeColor=#8E24AA;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="320" y="125" width="180" height="50" as="geometry" />
        </mxCell>
        <mxCell id="st-pvc-yaml" value="accessModes: [ReadWriteOnce]&#xa;resources.requests.storage: 50Gi&#xa;storageClassName: gp3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#8E24AA;fontSize=8;align=left;spacingLeft=5;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="320" y="180" width="200" height="40" as="geometry" />
        </mxCell>
        <mxCell id="st-pv" value="PersistentVolume&#xa;(PV)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#1565C0;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="630" y="125" width="160" height="50" as="geometry" />
        </mxCell>
        <mxCell id="st-pv-note" value="Cluster-scoped.&#xa;Pre-created (static) or&#xa;auto-created (dynamic)." style="text;html=1;fontSize=9;fontStyle=2;fontColor=#666;align=left;spacingLeft=5;" vertex="1" parent="1">
          <mxGeometry x="630" y="180" width="160" height="35" as="geometry" />
        </mxCell>
        <mxCell id="st-sc" value="StorageClass" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#F9A825;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="910" y="125" width="140" height="50" as="geometry" />
        </mxCell>
        <mxCell id="st-sc-yaml" value="provisioner: ebs.csi.aws.com&#xa;reclaimPolicy: Delete&#xa;volumeBindingMode:&#xa;  WaitForFirstConsumer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#F9A825;fontSize=8;align=left;spacingLeft=5;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="910" y="180" width="185" height="50" as="geometry" />
        </mxCell>
        <mxCell id="st-phys" value="Physical Storage" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#CFD8DC;strokeColor=#546E7A;fontSize=11;fontStyle=1;size=10;" vertex="1" parent="1">
          <mxGeometry x="1200" y="120" width="140" height="60" as="geometry" />
        </mxCell>
        <mxCell id="st-phys-eg" value="EBS, NFS, NetApp,&#xa;Ceph, Local Disk" style="text;html=1;fontSize=9;fontStyle=2;fontColor=#666;align=center;" vertex="1" parent="1">
          <mxGeometry x="1200" y="185" width="140" height="25" as="geometry" />
        </mxCell>
        <!-- Chain arrows -->
        <mxCell id="st-ca1" style="rounded=1;strokeColor=#2E7D32;strokeWidth=2;" edge="1" parent="1" source="st-pod" target="st-pvc">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="st-ca1-l" value="references&#xa;by name" style="edgeLabel;fontSize=8;fillColor=none;" connectable="0" vertex="1" parent="st-ca1">
          <mxGeometry relative="1" as="geometry"><mxPoint y="-10" as="offset" /></mxGeometry>
        </mxCell>
        <mxCell id="st-ca2" style="rounded=1;strokeColor=#8E24AA;strokeWidth=2;" edge="1" parent="1" source="st-pvc" target="st-pv">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="st-ca2-l" value="bound 1:1" style="edgeLabel;fontSize=8;fillColor=none;" connectable="0" vertex="1" parent="st-ca2">
          <mxGeometry relative="1" as="geometry"><mxPoint y="-10" as="offset" /></mxGeometry>
        </mxCell>
        <mxCell id="st-ca3" style="rounded=1;strokeColor=#F9A825;strokeWidth=2;dashed=1;" edge="1" parent="1" source="st-sc" target="st-pv">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="st-ca3-l" value="dynamically&#xa;provisions" style="edgeLabel;fontSize=8;fillColor=none;" connectable="0" vertex="1" parent="st-ca3">
          <mxGeometry relative="1" as="geometry"><mxPoint y="-10" as="offset" /></mxGeometry>
        </mxCell>
        <mxCell id="st-ca4" style="rounded=1;strokeColor=#546E7A;strokeWidth=2;" edge="1" parent="1" source="st-pv" target="st-phys">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="st-ca4-l" value="maps to" style="edgeLabel;fontSize=8;fillColor=none;" connectable="0" vertex="1" parent="st-ca4">
          <mxGeometry relative="1" as="geometry"><mxPoint y="-10" as="offset" /></mxGeometry>
        </mxCell>

        <!-- ===== ACCESS MODES ===== -->
        <mxCell id="st-access" value="Access Modes" style="shape=mxgraph.gcp2.standard_rectangle;fillColor=#FFF3E0;strokeColor=#E65100;fontStyle=1;fontSize=13;verticalAlign=top;spacingTop=5;rounded=1;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="300" width="1500" height="160" as="geometry" />
        </mxCell>
        <!-- RWO -->
        <mxCell id="st-rwo" value="&lt;b&gt;ReadWriteOnce (RWO)&lt;/b&gt;&lt;br&gt;Mounted read-write by a &lt;b&gt;single node&lt;/b&gt;.&lt;br&gt;Use: Kafka logs, DB data, single-writer workloads.&lt;br&gt;Backed by: block storage (EBS, GCE PD, Azure Disk)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;fontSize=9;align=left;spacingLeft=8;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="330" width="380" height="80" as="geometry" />
        </mxCell>
        <!-- ROX -->
        <mxCell id="st-rox" value="&lt;b&gt;ReadOnlyMany (ROX)&lt;/b&gt;&lt;br&gt;Mounted &lt;b&gt;read-only&lt;/b&gt; by many nodes.&lt;br&gt;Use: Config data, ML models, shared assets.&lt;br&gt;Backed by: NFS, CephFS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;fontSize=9;align=left;spacingLeft=8;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="460" y="330" width="340" height="80" as="geometry" />
        </mxCell>
        <!-- RWX -->
        <mxCell id="st-rwx" value="&lt;b&gt;ReadWriteMany (RWX)&lt;/b&gt;&lt;br&gt;Mounted &lt;b&gt;read-write&lt;/b&gt; by many nodes simultaneously.&lt;br&gt;Use: Flink checkpoints, shared logs, CMS uploads.&lt;br&gt;Backed by: NFS, CephFS, NetApp Trident" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;fontSize=9;align=left;spacingLeft=8;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="820" y="330" width="380" height="80" as="geometry" />
        </mxCell>
        <mxCell id="st-rwonce-pod" value="&lt;b&gt;ReadWriteOncePod (RWOP)&lt;/b&gt; — K8s 1.27+. Like RWO but strictly one Pod, not one node." style="text;html=1;fontSize=9;fontStyle=2;fontColor=#666;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="420" width="500" height="15" as="geometry" />
        </mxCell>

        <!-- ===== STATIC vs DYNAMIC ===== -->
        <mxCell id="st-prov" value="Provisioning" style="shape=mxgraph.gcp2.standard_rectangle;fillColor=#E8F5E9;strokeColor=#2E7D32;fontStyle=1;fontSize=13;verticalAlign=top;spacingTop=5;rounded=1;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="480" width="730" height="230" as="geometry" />
        </mxCell>
        <!-- Static -->
        <mxCell id="st-stat-title" value="Static Provisioning" style="text;html=1;fontSize=11;fontStyle=1;fontColor=#2E7D32;align=left;" vertex="1" parent="1">
          <mxGeometry x="55" y="510" width="200" height="20" as="geometry" />
        </mxCell>
        <mxCell id="st-stat-desc" value="Admin pre-creates PVs. PVCs bind to existing PVs that match size + access mode." style="text;html=1;fontSize=9;align=left;" vertex="1" parent="1">
          <mxGeometry x="55" y="530" width="350" height="15" as="geometry" />
        </mxCell>
        <mxCell id="st-stat-admin" value="Admin" style="shape=actor;whiteSpace=wrap;html=1;fillColor=#A5D6A7;strokeColor=#2E7D32;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="65" y="560" width="40" height="40" as="geometry" />
        </mxCell>
        <mxCell id="st-stat-pv" value="PV (pre-created)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#1565C0;fontSize=9;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="150" y="565" width="110" height="30" as="geometry" />
        </mxCell>
        <mxCell id="st-stat-pvc" value="PVC (user creates)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1BEE7;strokeColor=#8E24AA;fontSize=9;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="310" y="565" width="110" height="30" as="geometry" />
        </mxCell>
        <mxCell id="st-stat-a1" style="rounded=1;strokeColor=#2E7D32;" edge="1" parent="1" source="st-stat-admin" target="st-stat-pv">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="st-stat-a1-l" value="creates" style="edgeLabel;fontSize=7;fillColor=none;" connectable="0" vertex="1" parent="st-stat-a1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="st-stat-a2" style="rounded=1;strokeColor=#8E24AA;dashed=1;" edge="1" parent="1" source="st-stat-pvc" target="st-stat-pv">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="st-stat-a2-l" value="binds" style="edgeLabel;fontSize=7;fillColor=none;" connectable="0" vertex="1" parent="st-stat-a2">
          <mxGeometry relative="1" as="geometry"><mxPoint y="-8" as="offset" /></mxGeometry>
        </mxCell>
        <!-- Dynamic -->
        <mxCell id="st-dyn-title" value="Dynamic Provisioning (most common)" style="text;html=1;fontSize=11;fontStyle=1;fontColor=#2E7D32;align=left;" vertex="1" parent="1">
          <mxGeometry x="55" y="620" width="300" height="20" as="geometry" />
        </mxCell>
        <mxCell id="st-dyn-desc" value="PVC references a StorageClass → K8s invokes the CSI driver → PV created automatically." style="text;html=1;fontSize=9;align=left;" vertex="1" parent="1">
          <mxGeometry x="55" y="640" width="450" height="15" as="geometry" />
        </mxCell>
        <mxCell id="st-dyn-pvc" value="PVC&#xa;storageClassName: gp3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1BEE7;strokeColor=#8E24AA;fontSize=9;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="65" y="665" width="120" height="30" as="geometry" />
        </mxCell>
        <mxCell id="st-dyn-sc" value="StorageClass: gp3&#xa;provisioner: ebs.csi" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#F9A825;fontSize=9;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="230" y="665" width="120" height="30" as="geometry" />
        </mxCell>
        <mxCell id="st-dyn-csi" value="CSI Driver&#xa;(ebs.csi.aws.com)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CFD8DC;strokeColor=#546E7A;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="400" y="665" width="110" height="30" as="geometry" />
        </mxCell>
        <mxCell id="st-dyn-pv" value="PV (auto-created)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#1565C0;fontSize=9;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="560" y="665" width="110" height="30" as="geometry" />
        </mxCell>
        <mxCell id="st-dyn-a1" style="rounded=1;strokeColor=#8E24AA;" edge="1" parent="1" source="st-dyn-pvc" target="st-dyn-sc">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="st-dyn-a2" style="rounded=1;strokeColor=#F9A825;" edge="1" parent="1" source="st-dyn-sc" target="st-dyn-csi">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="st-dyn-a3" style="rounded=1;strokeColor=#546E7A;" edge="1" parent="1" source="st-dyn-csi" target="st-dyn-pv">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ===== RECLAIM POLICIES ===== -->
        <mxCell id="st-reclaim" value="Reclaim Policies (what happens when PVC is deleted)" style="shape=mxgraph.gcp2.standard_rectangle;fillColor=#FCE4EC;strokeColor=#C62828;fontStyle=1;fontSize=13;verticalAlign=top;spacingTop=5;rounded=1;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="730" width="730" height="140" as="geometry" />
        </mxCell>
        <mxCell id="st-reclaim-table" value="&lt;table style='font-size:10px;border-collapse:collapse;width:100%'&gt;&lt;tr style='background:#FCE4EC;font-weight:bold'&gt;&lt;td style='padding:4px;border:1px solid #C62828'&gt;Policy&lt;/td&gt;&lt;td style='padding:4px;border:1px solid #C62828'&gt;PV After PVC Deletion&lt;/td&gt;&lt;td style='padding:4px;border:1px solid #C62828'&gt;Data&lt;/td&gt;&lt;td style='padding:4px;border:1px solid #C62828'&gt;When to Use&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:4px;border:1px solid #ccc;font-weight:bold'&gt;Delete&lt;/td&gt;&lt;td style='padding:4px;border:1px solid #ccc'&gt;PV and storage deleted&lt;/td&gt;&lt;td style='padding:4px;border:1px solid #ccc;color:red'&gt;LOST&lt;/td&gt;&lt;td style='padding:4px;border:1px solid #ccc'&gt;Ephemeral data (default for dynamic provisioning)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:4px;border:1px solid #ccc;font-weight:bold'&gt;Retain&lt;/td&gt;&lt;td style='padding:4px;border:1px solid #ccc'&gt;PV becomes &quot;Released&quot; — manual cleanup&lt;/td&gt;&lt;td style='padding:4px;border:1px solid #ccc;color:green'&gt;KEPT&lt;/td&gt;&lt;td style='padding:4px;border:1px solid #ccc'&gt;Important data (Kafka logs, databases)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:4px;border:1px solid #ccc;font-weight:bold'&gt;Recycle&lt;/td&gt;&lt;td style='padding:4px;border:1px solid #ccc'&gt;Data wiped (rm -rf), PV available again&lt;/td&gt;&lt;td style='padding:4px;border:1px solid #ccc;color:orange'&gt;WIPED&lt;/td&gt;&lt;td style='padding:4px;border:1px solid #ccc'&gt;Deprecated — use dynamic provisioning&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;overflow=fill;rounded=1;whiteSpace=wrap;fillColor=#FAFAFA;strokeColor=#C62828;" vertex="1" parent="1">
          <mxGeometry x="55" y="760" width="700" height="100" as="geometry" />
        </mxCell>

        <!-- ===== RIGHT SIDE: Binding, StatefulSet, CSI, Lifecycle ===== -->
        <mxCell id="st-right" value="" style="shape=mxgraph.gcp2.standard_rectangle;fillColor=#FAFAFA;strokeColor=#9E9E9E;rounded=1;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="800" y="480" width="740" height="390" as="geometry" />
        </mxCell>
        <mxCell id="st-bind-title" value="Volume Binding Modes" style="text;html=1;fontSize=12;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="810" y="485" width="250" height="20" as="geometry" />
        </mxCell>
        <mxCell id="st-bind-imm" value="&lt;b&gt;Immediate&lt;/b&gt; — PV provisioned as soon as PVC created. Risk: PV may land in different zone than Pod." style="text;html=1;fontSize=9;align=left;spacingLeft=5;" vertex="1" parent="1">
          <mxGeometry x="810" y="510" width="710" height="15" as="geometry" />
        </mxCell>
        <mxCell id="st-bind-wait" value="&lt;b&gt;WaitForFirstConsumer&lt;/b&gt; — PV provisioned after Pod is scheduled. CSI creates storage in same zone. &lt;span style='color:#2E7D32;font-weight:bold'&gt;Best practice.&lt;/span&gt;" style="text;html=1;fontSize=9;align=left;spacingLeft=5;" vertex="1" parent="1">
          <mxGeometry x="810" y="530" width="710" height="15" as="geometry" />
        </mxCell>
        <mxCell id="st-sts-title" value="StatefulSet + volumeClaimTemplates" style="text;html=1;fontSize=12;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="810" y="560" width="350" height="20" as="geometry" />
        </mxCell>
        <mxCell id="st-sts-desc" value="StatefulSets define a &lt;b&gt;volumeClaimTemplate&lt;/b&gt; — K8s creates one PVC per replica:&lt;br&gt;&lt;br&gt;&lt;code&gt;kafka&lt;/code&gt; (3 replicas) →  PVC: &lt;code&gt;data-kafka-0&lt;/code&gt; (50Gi) → PV-0 → EBS vol-abc&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;PVC: &lt;code&gt;data-kafka-1&lt;/code&gt; (50Gi) → PV-1 → EBS vol-def&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;PVC: &lt;code&gt;data-kafka-2&lt;/code&gt; (50Gi) → PV-2 → EBS vol-ghi&lt;br&gt;&lt;br&gt;If a Pod is rescheduled, it re-attaches to the &lt;b&gt;same PVC&lt;/b&gt; (stable identity)." style="text;html=1;fontSize=9;align=left;spacingLeft=5;" vertex="1" parent="1">
          <mxGeometry x="810" y="580" width="710" height="85" as="geometry" />
        </mxCell>
        <mxCell id="st-csi-title" value="Common CSI Drivers" style="text;html=1;fontSize=12;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="810" y="675" width="250" height="20" as="geometry" />
        </mxCell>
        <mxCell id="st-csi-table" value="&lt;table style='font-size:9px;border-collapse:collapse;width:100%'&gt;&lt;tr style='background:#E3F2FD;font-weight:bold'&gt;&lt;td style='padding:3px;border:1px solid #1565C0'&gt;Provider&lt;/td&gt;&lt;td style='padding:3px;border:1px solid #1565C0'&gt;CSI Driver&lt;/td&gt;&lt;td style='padding:3px;border:1px solid #1565C0'&gt;Modes&lt;/td&gt;&lt;td style='padding:3px;border:1px solid #1565C0'&gt;Type&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:3px;border:1px solid #ccc'&gt;AWS EBS&lt;/td&gt;&lt;td style='padding:3px;border:1px solid #ccc'&gt;&lt;code&gt;ebs.csi.aws.com&lt;/code&gt;&lt;/td&gt;&lt;td style='padding:3px;border:1px solid #ccc'&gt;RWO&lt;/td&gt;&lt;td style='padding:3px;border:1px solid #ccc'&gt;Block&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:3px;border:1px solid #ccc'&gt;AWS EFS&lt;/td&gt;&lt;td style='padding:3px;border:1px solid #ccc'&gt;&lt;code&gt;efs.csi.aws.com&lt;/code&gt;&lt;/td&gt;&lt;td style='padding:3px;border:1px solid #ccc'&gt;RWX, ROX, RWO&lt;/td&gt;&lt;td style='padding:3px;border:1px solid #ccc'&gt;NFS&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:3px;border:1px solid #ccc'&gt;NetApp Trident&lt;/td&gt;&lt;td style='padding:3px;border:1px solid #ccc'&gt;&lt;code&gt;csi.trident.netapp.io&lt;/code&gt;&lt;/td&gt;&lt;td style='padding:3px;border:1px solid #ccc'&gt;RWO, RWX, ROX&lt;/td&gt;&lt;td style='padding:3px;border:1px solid #ccc'&gt;Block / NFS&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:3px;border:1px solid #ccc'&gt;Ceph (Rook)&lt;/td&gt;&lt;td style='padding:3px;border:1px solid #ccc'&gt;&lt;code&gt;rook-ceph.rbd.csi.ceph.com&lt;/code&gt;&lt;/td&gt;&lt;td style='padding:3px;border:1px solid #ccc'&gt;RWO, RWX&lt;/td&gt;&lt;td style='padding:3px;border:1px solid #ccc'&gt;Block / FS&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='padding:3px;border:1px solid #ccc'&gt;NFS (generic)&lt;/td&gt;&lt;td style='padding:3px;border:1px solid #ccc'&gt;&lt;code&gt;nfs.csi.k8s.io&lt;/code&gt;&lt;/td&gt;&lt;td style='padding:3px;border:1px solid #ccc'&gt;RWO, RWX, ROX&lt;/td&gt;&lt;td style='padding:3px;border:1px solid #ccc'&gt;NFS&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;overflow=fill;rounded=1;whiteSpace=wrap;fillColor=#FAFAFA;strokeColor=#9E9E9E;" vertex="1" parent="1">
          <mxGeometry x="810" y="700" width="710" height="150" as="geometry" />
        </mxCell>

        <!-- ===== PV LIFECYCLE ===== -->
        <mxCell id="st-lc-title" value="PV Lifecycle" style="text;html=1;fontSize=12;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="890" width="200" height="20" as="geometry" />
        </mxCell>
        <mxCell id="st-lc-avail" value="Available" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C8E6C9;strokeColor=#2E7D32;fontSize=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="920" width="90" height="30" as="geometry" />
        </mxCell>
        <mxCell id="st-lc-bound" value="Bound" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#1565C0;fontSize=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="200" y="920" width="90" height="30" as="geometry" />
        </mxCell>
        <mxCell id="st-lc-released" value="Released" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#F9A825;fontSize=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="360" y="920" width="90" height="30" as="geometry" />
        </mxCell>
        <mxCell id="st-lc-failed" value="Failed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFCDD2;strokeColor=#C62828;fontSize=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="520" y="920" width="90" height="30" as="geometry" />
        </mxCell>
        <mxCell id="st-lc-a1" style="rounded=1;strokeColor=#333;" edge="1" parent="1" source="st-lc-avail" target="st-lc-bound">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="st-lc-a1-l" value="PVC binds" style="edgeLabel;fontSize=7;fillColor=none;" connectable="0" vertex="1" parent="st-lc-a1">
          <mxGeometry relative="1" as="geometry"><mxPoint y="-8" as="offset" /></mxGeometry>
        </mxCell>
        <mxCell id="st-lc-a2" style="rounded=1;strokeColor=#333;" edge="1" parent="1" source="st-lc-bound" target="st-lc-released">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="st-lc-a2-l" value="PVC deleted&#xa;(Retain)" style="edgeLabel;fontSize=7;fillColor=none;" connectable="0" vertex="1" parent="st-lc-a2">
          <mxGeometry relative="1" as="geometry"><mxPoint y="-8" as="offset" /></mxGeometry>
        </mxCell>
        <mxCell id="st-lc-a3" style="rounded=1;strokeColor=#333;" edge="1" parent="1" source="st-lc-released" target="st-lc-failed">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="st-lc-a3-l" value="cleanup fails" style="edgeLabel;fontSize=7;fillColor=none;" connectable="0" vertex="1" parent="st-lc-a3">
          <mxGeometry relative="1" as="geometry"><mxPoint y="-8" as="offset" /></mxGeometry>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>

  <!-- ==================== TAB 5: CFK Operator Admission ==================== -->
  <diagram id="cfk-admission-ref" name="Reference — CFK Operator Admission">
    <mxGraphModel dx="1600" dy="1400" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="adm-title" value="CFK Operator — Admission, TLS &amp; Reconciliation" style="text;html=1;fontSize=22;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="250" y="15" width="600" height="40" as="geometry" />
        </mxCell>
        <mxCell id="adm-subtitle" value="How CFK validates custom resources, secures the webhook with TLS, and reconciles desired state" style="text;html=1;fontSize=11;fontStyle=2;align=center;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="200" y="50" width="700" height="25" as="geometry" />
        </mxCell>

        <!-- ===== 1. TLS BETWEEN API SERVER AND WEBHOOK ===== -->
        <mxCell id="tls-group" value="1. Webhook TLS — How the API Server Trusts the Webhook" style="shape=mxgraph.gcp2.standard_rectangle;fillColor=#FFF3E0;strokeColor=#E65100;fontStyle=1;fontSize=13;verticalAlign=top;spacingTop=5;rounded=1;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="90" width="1500" height="250" as="geometry" />
        </mxCell>
        <mxCell id="tls-api" value="kube-apiserver" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#1565C0;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="140" width="150" height="50" as="geometry" />
        </mxCell>
        <mxCell id="tls-arrow" style="rounded=1;strokeColor=#E65100;strokeWidth=3;" edge="1" parent="1" source="tls-api" target="tls-webhook">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="tls-arrow-l" value="HTTPS POST /confluent-operator/validate&#xa;(mutual trust via caBundle)" style="edgeLabel;fontSize=9;fillColor=none;fontStyle=1;labelBackgroundColor=none;" connectable="0" vertex="1" parent="tls-arrow">
          <mxGeometry relative="1" as="geometry"><mxPoint y="-15" as="offset" /></mxGeometry>
        </mxCell>
        <mxCell id="tls-webhook" value="CFK Operator Pod&#xa;(webhook server :8443)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CE93D8;strokeColor=#8E24AA;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="550" y="140" width="190" height="50" as="geometry" />
        </mxCell>
        <mxCell id="tls-secret" value="Secret: confluent-operator-serving-cert&#xa;fullchain.pem | privkey.pem | cacerts.pem&#xa;(mounted via directoryPathInContainer)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;fontSize=9;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="550" y="200" width="280" height="45" as="geometry" />
        </mxCell>
        <mxCell id="tls-certmgr" value="cert-manager&#xa;Certificate CR" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#F9A825;fontSize=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="550" y="260" width="120" height="40" as="geometry" />
        </mxCell>
        <mxCell id="tls-issuer" value="Self-Signed&#xa;Issuer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#F9A825;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="700" y="260" width="90" height="40" as="geometry" />
        </mxCell>
        <mxCell id="tls-cm-secret" style="rounded=1;strokeColor=#F9A825;strokeWidth=1;" edge="1" parent="1" source="tls-certmgr" target="tls-secret">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="tls-cm-secret-l" value="creates &amp;&#xa;auto-renews" style="edgeLabel;fontSize=7;fillColor=none;" connectable="0" vertex="1" parent="tls-cm-secret">
          <mxGeometry relative="1" as="geometry"><mxPoint x="-30" as="offset" /></mxGeometry>
        </mxCell>
        <mxCell id="tls-cm-issuer" style="rounded=1;strokeColor=#F9A825;" edge="1" parent="1" source="tls-certmgr" target="tls-issuer">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="tls-cm-issuer-l" value="signs with" style="edgeLabel;fontSize=7;fillColor=none;" connectable="0" vertex="1" parent="tls-cm-issuer">
          <mxGeometry relative="1" as="geometry"><mxPoint y="-8" as="offset" /></mxGeometry>
        </mxCell>
        <!-- caBundle explanation -->
        <mxCell id="tls-vwc" value="ValidatingWebhookConfiguration" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1BEE7;strokeColor=#8E24AA;fontSize=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="220" width="230" height="40" as="geometry" />
        </mxCell>
        <mxCell id="tls-vwc-detail" value="caBundle: &lt;base64 CA cert&gt;&#xa;← API server uses this to verify&#xa;   the webhook's TLS certificate" style="text;html=1;fontSize=9;align=left;spacingLeft=5;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="80" y="265" width="250" height="40" as="geometry" />
        </mxCell>
        <mxCell id="tls-vwc-arrow" style="rounded=1;strokeColor=#8E24AA;dashed=1;" edge="1" parent="1" source="tls-api" target="tls-vwc">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="tls-vwc-arrow-l" value="reads caBundle" style="edgeLabel;fontSize=7;fillColor=none;" connectable="0" vertex="1" parent="tls-vwc-arrow">
          <mxGeometry relative="1" as="geometry"><mxPoint x="-15" as="offset" /></mxGeometry>
        </mxCell>
        <!-- TLS flow explanation -->
        <mxCell id="tls-explain" value="&lt;b&gt;How it works:&lt;/b&gt;&lt;br&gt;1. cert-manager creates the TLS secret (auto-renewed)&lt;br&gt;2. Volume projection mounts it as fullchain.pem / privkey.pem / cacerts.pem into the operator pod&lt;br&gt;3. The operator starts an HTTPS server on :8443 using those certs&lt;br&gt;4. The ValidatingWebhookConfiguration contains the &lt;b&gt;caBundle&lt;/b&gt; (CA cert, base64-encoded)&lt;br&gt;5. When API server receives a Kafka/KRaft/SR/etc. CR, it POSTs to the webhook over HTTPS&lt;br&gt;6. API server validates the webhook's TLS cert against the caBundle — if it matches, trust is established" style="text;html=1;fontSize=9;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="880" y="130" width="620" height="100" as="geometry" />
        </mxCell>
        <mxCell id="tls-san-note" value="&lt;b&gt;SAN requirement:&lt;/b&gt; The cert must include &lt;code&gt;confluent-operator.&amp;lt;namespace&amp;gt;.svc&lt;/code&gt; as a DNS SAN,&#xa;because that's the service name the API server connects to." style="text;html=1;fontSize=9;fontStyle=2;fontColor=#C62828;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="880" y="240" width="580" height="25" as="geometry" />
        </mxCell>

        <!-- ===== 2. ADMISSION FLOW ===== -->
        <mxCell id="adm-flow" value="2. Admission Flow — What Happens When You Apply a CR" style="shape=mxgraph.gcp2.standard_rectangle;fillColor=#E3F2FD;strokeColor=#1565C0;fontStyle=1;fontSize=13;verticalAlign=top;spacingTop=5;rounded=1;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="360" width="1500" height="230" as="geometry" />
        </mxCell>

        <!-- Steps -->
        <mxCell id="adm-user" value="User / ArgoCD" style="shape=actor;whiteSpace=wrap;html=1;fillColor=#C8E6C9;strokeColor=#2E7D32;fontSize=9;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="70" y="410" width="50" height="45" as="geometry" />
        </mxCell>
        <mxCell id="adm-user-cmd" value="kubectl apply -f&#xa;kafka.yaml" style="text;html=1;fontSize=8;fontStyle=2;fontFamily=Courier New;align=center;" vertex="1" parent="1">
          <mxGeometry x="50" y="460" width="100" height="20" as="geometry" />
        </mxCell>
        <mxCell id="adm-api" value="kube-apiserver" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#1565C0;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="200" y="405" width="140" height="45" as="geometry" />
        </mxCell>
        <mxCell id="adm-mutate" value="Mutating&#xa;Admission" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0E0E0;strokeColor=#9E9E9E;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="420" y="405" width="110" height="45" as="geometry" />
        </mxCell>
        <mxCell id="adm-mutate-note" value="(CFK does not use&#xa;a MutatingWebhook)" style="text;html=1;fontSize=8;fontStyle=2;fontColor=#999;align=center;" vertex="1" parent="1">
          <mxGeometry x="415" y="455" width="120" height="20" as="geometry" />
        </mxCell>
        <mxCell id="adm-validate" value="ValidatingWebhook&#xa;confluent-operator&#xa;(:8443 HTTPS)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CE93D8;strokeColor=#8E24AA;fontSize=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="610" y="395" width="160" height="60" as="geometry" />
        </mxCell>
        <mxCell id="adm-reject" value="REJECT&#xa;(error to user)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFCDD2;strokeColor=#C62828;fontSize=9;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="660" y="500" width="100" height="35" as="geometry" />
        </mxCell>
        <mxCell id="adm-etcd" value="etcd&#xa;(CR stored)" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#CFD8DC;strokeColor=#546E7A;fontSize=10;fontStyle=1;size=8;" vertex="1" parent="1">
          <mxGeometry x="860" y="400" width="100" height="55" as="geometry" />
        </mxCell>
        <mxCell id="adm-watch" value="CFK Operator&#xa;(controller loop)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CE93D8;strokeColor=#8E24AA;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1050" y="405" width="150" height="45" as="geometry" />
        </mxCell>
        <mxCell id="adm-resources" value="K8s Resources&#xa;Created" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#BBDEFB;strokeColor=#1565C0;fontSize=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1290" y="405" width="120" height="45" as="geometry" />
        </mxCell>
        <mxCell id="adm-resources-detail" value="StatefulSet, Pods,&#xa;Services, ConfigMaps,&#xa;PVCs, Routes..." style="text;html=1;fontSize=8;fontStyle=2;fontColor=#666;align=center;" vertex="1" parent="1">
          <mxGeometry x="1280" y="455" width="140" height="30" as="geometry" />
        </mxCell>

        <!-- Flow arrows -->
        <mxCell id="adm-fa1" style="rounded=1;strokeColor=#333;strokeWidth=2;" edge="1" parent="1" source="adm-user" target="adm-api">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
