        </mxCell>
        <mxCell id="adm-ra4" style="rounded=1;strokeColor=#C62828;strokeWidth=2;" edge="1" parent="1" source="adm-compare" target="adm-drift-yes">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
