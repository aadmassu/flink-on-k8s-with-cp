olid #ccc&#39;&gt;flink-pvc&lt;/td&gt;&lt;td style=&#39;padding:3px;border:1px solid #ccc&#39;&gt;10Gi&lt;/td&gt;&lt;td style=&#39;padding:3px;border:1px solid #ccc&#39;&gt;RWX&lt;/td&gt;&lt;td style=&#39;padding:3px;border:1px solid #ccc&#39;&gt;1&lt;/td&gt;&lt;td style=&#39;padding:3px;border:1px solid #ccc&#39;&gt;NFS / NetApp Trident&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&#39;background:#E1BEE7;font-weight:bold&#39;&gt;&lt;td style=&#39;padding:3px;border:1px solid #8E24AA&#39;&gt;Total&lt;/td&gt;&lt;td style=&#39;padding:3px;border:1px solid #8E24AA&#39; colspan=&#39;4&#39;&gt;8 PVCs — 210Gi (3×10 + 3×50 + 10 + 10)&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" vertex="1">
