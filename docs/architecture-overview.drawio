        <mxCell id="adm-act2" value="Rolling&#xa;restart" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="1015" y="893" width="75" height="35" as="geometry" />
        </mxCell>
        <mxCell id="adm-act3" value="Update&#xa;ConfigMap" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="1100" y="893" width="80" height="35" as="geometry" />
        </mxCell>
        <mxCell id="adm-act4" value="Create/update&#xa;Service/Route" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="1190" y="893" width="95" height="35" as="geometry" />
        </mxCell>
        <mxCell id="adm-act5" value="Update CR&#xa;status" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="1295" y="893" width="80" height="35" as="geometry" />
        </mxCell>
        <mxCell id="adm-act6" value="Create/update&#xa;Secrets" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#E65100;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="1385" y="893" width="90" height="35" as="geometry" />
        </mxCell>

        <!-- Reconciliation arrows -->
        <mxCell id="adm-ra1" style="rounded=1;strokeColor=#2E7D32;strokeWidth=2;" edge="1" parent="1" source="adm-desired" target="adm-op">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="adm-ra1-l" value="read spec" style="edgeLabel;fontSize=8;fillColor=none;" connectable="0" vertex="1" parent="adm-ra1">
          <mxGeometry relative="1" as="geometry"><mxPoint y="-10" as="offset" /></mxGeometry>
        </mxCell>
        <mxCell id="adm-ra2" style="rounded=1;strokeColor=#8E24AA;strokeWidth=2;" edge="1" parent="1" source="adm-op" target="adm-compare">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
