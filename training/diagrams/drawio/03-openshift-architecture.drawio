        <mxCell id="key_title" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontStyle=1;fontSize=12;" value="OpenShift-specific Component Roles (one-liner each)" vertex="1">
          <mxGeometry height="20" width="1000" x="40" y="910" as="geometry" />
        </mxCell>
        <mxCell id="key_oas" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontStyle=1" value="oas     — openshift-apiserver: aggregated API server in front of kube-apiserver; serves OpenShift-only resource kinds (Route, BuildConfig, ImageStream, Project, DeploymentConfig, ...)" vertex="1">
          <mxGeometry height="20" width="1000" x="40" y="935" as="geometry" />
        </mxCell>
        <mxCell id="key_ocm" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontStyle=1" value="ocm     — openshift-controller-manager: control loops for OpenShift-specific resources (BuildConfig → Build → image; DeploymentConfig → ReplicationController; ImageStream tag updates)." vertex="1">
          <mxGeometry height="20" width="1000" x="40" y="955" as="geometry" />
        </mxCell>
        <mxCell id="key_oauth" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontStyle=1" value="oauth   — integrated OAuth2 server; pluggable identity providers (htpasswd, LDAP, OIDC, GitHub, Keystone, BasicAuth); issues tokens that the api-server accepts." vertex="1">
          <mxGeometry height="20" width="1000" x="40" y="975" as="geometry" />
        </mxCell>
        <mxCell id="key_olm" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontStyle=1" value="olm     — Operator Lifecycle Manager: installs, upgrades, and removes Operators from OperatorHub (Subscription / ClusterServiceVersion CRs); manages operator dependency graph." vertex="1">
          <mxGeometry height="20" width="1000" x="40" y="995" as="geometry" />
        </mxCell>
        <mxCell id="key_cvo" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontStyle=1" value="cvo     — Cluster Version Operator: reconciles the ClusterVersion CR against a Red Hat-signed release manifest; owns and updates ALL the platform-level operators above and below it." vertex="1">
          <mxGeometry height="20" width="1000" x="40" y="1015" as="geometry" />
        </mxCell>
        <mxCell id="key_mco" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontStyle=1" value="mco     — Machine Config Operator: owns the desired node OS state (kernel args, kubelet config, registry mirrors, files via Ignition). Pushes MachineConfig → per-node mcd to apply + reboot." vertex="1">
          <mxGeometry height="20" width="1000" x="40" y="1035" as="geometry" />
        </mxCell>
        <mxCell id="key_router" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontStyle=1" value="router  — default Ingress Controller (HAProxy-based) that converts OpenShift Route resources into HAProxy frontends; supports edge / passthrough / reencrypt TLS termination." vertex="1">
          <mxGeometry height="20" width="1000" x="40" y="1055" as="geometry" />
        </mxCell>
        <mxCell id="key_registry" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontStyle=1" value="registry — integrated container image registry (image-registry.openshift-image-registry.svc); backs ImageStreams; pulls happen via the cluster pull secret automatically." vertex="1">
          <mxGeometry height="20" width="1000" x="40" y="1075" as="geometry" />
        </mxCell>
        <mxCell id="key_console" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontStyle=1" value="console — Web UI for cluster admins (cluster perspective: nodes, operators, monitoring) and developers (developer perspective: Pipelines, BuildConfigs, Topology view)." vertex="1">
          <mxGeometry height="20" width="1000" x="40" y="1095" as="geometry" />
        </mxCell>
        <mxCell id="key_crio" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontStyle=3;" value="CRI-O — OpenShift&#39;s default container runtime (not containerd); shipped + lifecycle-managed by MCO; runs containers via the OCI spec under the kubelet&#39;s CRI gRPC interface." vertex="1">
          <mxGeometry height="20" width="1000" x="40" y="1115" as="geometry" />
        </mxCell>
        <mxCell id="key_legend" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontStyle=3;" value="Colors — BLUE heptagons = standard Kubernetes (same as kubernetes.io diagram).  RED heptagons = OpenShift-specific additions.  Solid edges = required at runtime; dashed = HTTPS/HTTP via api-server proxy." vertex="1">
          <mxGeometry height="20" width="1000" x="40" y="1135" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
