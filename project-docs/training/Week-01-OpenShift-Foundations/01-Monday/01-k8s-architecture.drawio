        <mxCell id="key_title" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontStyle=1;fontSize=12;" value="Component Roles (one-liner each)" vertex="1">
          <mxGeometry height="20" width="500" x="80" y="900" as="geometry" />
        </mxCell>
        <mxCell id="key_api" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=1" value="api    — kube-api-server: the front door; only component that reads/writes etcd; everything goes through it." vertex="1">
          <mxGeometry height="20" width="1000" x="79" y="925" as="geometry" />
        </mxCell>
        <mxCell id="key_etcd" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=1" value="etcd   — distributed Raft k/v store; the single source of truth for cluster state." vertex="1">
          <mxGeometry height="20" width="1000" x="79" y="945" as="geometry" />
        </mxCell>
        <mxCell id="key_sched" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=1" value="sched  — kube-scheduler: watches unscheduled Pods; picks a Node based on resource fit, affinity, taints; writes the Pod-Node binding back via the api-server." vertex="1">
          <mxGeometry height="20" width="1000" x="79" y="965" as="geometry" />
        </mxCell>
        <mxCell id="key_cm" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=1" value="c-m    — kube-controller-manager: hosts built-in control loops (Deployment, ReplicaSet, Node, Endpoint, ServiceAccount-token, ...) — each reconciles current → desired state." vertex="1">
          <mxGeometry height="20" width="1000" x="79" y="985" as="geometry" />
        </mxCell>
        <mxCell id="key_ccm" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=1" value="c-c-m  — cloud-controller-manager: cloud-provider-specific control loops (Node lifecycle, LoadBalancer Services, Routes, Volumes); empty/absent on bare-metal." vertex="1">
          <mxGeometry height="20" width="1000" x="79" y="1005" as="geometry" />
        </mxCell>
        <mxCell id="key_kubelet" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=1" value="kubelet — node agent on every Node; watches for Pods assigned to its Node, talks to the container runtime via CRI gRPC, reports Pod/Node status back." vertex="1">
          <mxGeometry height="20" width="1000" x="79" y="1025" as="geometry" />
        </mxCell>
        <mxCell id="key_kproxy" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=1" value="k-proxy — kube-proxy: programs the Node&#39;s iptables/IPVS/eBPF rules so Service ClusterIPs are load-balanced to backing Pods; no traffic passes through kube-proxy itself." vertex="1">
          <mxGeometry height="20" width="1000" x="79" y="1045" as="geometry" />
        </mxCell>
        <mxCell id="key_runtime" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=1" value="Container Runtime (containerd / CRI-O) — actually runs containers via the CRI interface; pulls images; not a K8s binary, swappable." vertex="1">
          <mxGeometry height="20" width="1000" x="79" y="1065" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
