        <mxCell id="note_wffc" value="&lt;i&gt;WaitForFirstConsumer: PV is provisioned only after&lt;br&gt;Pod is scheduled — ensures PV and Pod land in same AZ&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;" parent="1" vertex="1">
          <mxGeometry x="46" y="566" width="370" height="50" as="geometry" />
        </mxCell>
        <mxCell id="note_rwo" value="&lt;i&gt;RWO (ReadWriteOnce): each PVC bound to exactly&lt;br&gt;one node — correct for Kafka (no shared disk)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;" parent="1" vertex="1">
          <mxGeometry x="656" y="566" width="330" height="50" as="geometry" />
        </mxCell>
        <mxCell id="note_retain" value="&lt;i&gt;reclaimPolicy: Retain — PV and backing disk survive&lt;br&gt;Pod or PVC deletion. Manual reclaim required.&lt;br&gt;Critical for Kafka: prevents accidental data loss.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d6b656;fontSize=11;align=left;" parent="1" vertex="1">
          <mxGeometry x="46" y="911" width="370" height="60" as="geometry" />
        </mxCell>
        <mxCell id="note_vct" value="&lt;i&gt;volumeClaimTemplate in the StatefulSet spec is the&lt;br&gt;blueprint: it names PVCs data-kafka-{N}, sets size,&lt;br&gt;accessMode, and StorageClass for every replica.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=left;" parent="1" vertex="1">
          <mxGeometry x="656" y="911" width="370" height="60" as="geometry" />
        </mxCell>
