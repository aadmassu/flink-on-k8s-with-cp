        </mxCell>
        <mxCell id="es" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d4e1f5;strokeColor=#5b87b9;align=center;fontSize=10;" value="EndpointSlice&#xa;(maintained by EndpointSlice controller; kept in sync with Ready Pods matching the selector)" vertex="1">
          <mxGeometry height="60" width="380" x="380" y="800" as="geometry" />
        </mxCell>
        <mxCell id="proxy" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d4e1f5;strokeColor=#5b87b9;align=center;fontSize=10;fontStyle=2;" value="kube-proxy on each node watches the EndpointSlice and writes&#xa;iptables/IPVS DNAT rules: ClusterIP:443 → one of the Pod IPs:8080" vertex="1">
