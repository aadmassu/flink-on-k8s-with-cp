        <mxCell id="failnotes_title" parent="1" style="text;html=1;align=left;fontStyle=1;fontSize=12;" value="Where each layer can break:" vertex="1">
          <mxGeometry height="20" width="500" x="80" y="1010" as="geometry" />
        </mxCell>
        <mxCell id="fn1" parent="1" style="text;html=1;align=left;fontSize=10;" value="• Firewall closed → connection refused / timeout from the user&#39;s browser" vertex="1">
          <mxGeometry height="20" width="1000" x="80" y="1035" as="geometry" />
        </mxCell>
        <mxCell id="fn2" parent="1" style="text;html=1;align=left;fontSize=10;" value="• Route doesn&#39;t match Host: header → HAProxy returns 503 / 404; check `oc get routes` for the right hostname" vertex="1">
          <mxGeometry height="20" width="1000" x="80" y="1055" as="geometry" />
        </mxCell>
        <mxCell id="fn3" parent="1" style="text;html=1;align=left;fontSize=10;" value="• Service has no Ready endpoints → HAProxy returns 503; check `oc get endpoints` — is it empty? Selector mismatch or probe failure" vertex="1">
          <mxGeometry height="20" width="1000" x="80" y="1075" as="geometry" />
        </mxCell>
        <mxCell id="fn4" parent="1" style="text;html=1;align=left;fontSize=10;" value="• Pod not Ready → endpoint dropped; HAProxy returns 503; check `oc describe pod` Events" vertex="1">
          <mxGeometry height="20" width="1000" x="80" y="1095" as="geometry" />
        </mxCell>
        <mxCell id="fn5" parent="1" style="text;html=1;align=left;fontSize=10;" value="• TLS cert mismatch between HAProxy edge and backend → reencrypt fails; HAProxy returns 502" vertex="1">
          <mxGeometry height="20" width="1000" x="80" y="1115" as="geometry" />
        </mxCell>
      </root>
