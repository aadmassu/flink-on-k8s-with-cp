<mxfile host="app.diagrams.net" agent="manual">
  <diagram name="Services-Routes Traffic Flow" id="services-routes">
    <mxGraphModel dx="1422" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="1654" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" parent="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=16;fontStyle=1;" value="One HTTPS request — user browser to Pod, in OpenShift" vertex="1">
          <mxGeometry x="80" y="20" width="1000" height="40" as="geometry"/>
        </mxCell>

        <mxCell id="user" parent="1" style="ellipse;shape=cloud;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=center;fontSize=11;" value="User browser&#10;https://myapp.apps.&lt;env&gt;.ocp.example.com" vertex="1">
          <mxGeometry x="380" y="90" width="380" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="fw" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;align=center;fontSize=12;" value="enterprise perimeter firewall — TCP/443 from User Zone to OCP LB IP" vertex="1">
          <mxGeometry x="80" y="220" width="1000" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="lb" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=center;fontSize=11;" value="OCP cluster Load Balancer IP&#10;(DEV: 10.7.72.209  ·  QA: 10.7.72.212  ·  ...)" vertex="1">
          <mxGeometry x="280" y="320" width="580" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="haproxy" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;align=center;fontSize=11;" value="HAProxy Ingress Router pod (on a dedicated Core Zone router node)&#10;Reads the Host: header; matches a Route; performs TLS termination (reencrypt mode for the platform)" vertex="1">
          <mxGeometry x="100" y="430" width="970" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="route" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=center;fontSize=11;" value="Route&#10;host: myapp.apps.&lt;env&gt;.ocp.example.com&#10;to: Service myapp&#10;tls.termination: reencrypt" vertex="1">
          <mxGeometry x="380" y="560" width="380" height="100" as="geometry"/>
        </mxCell>

        <mxCell id="svc" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=center;fontSize=11;" value="Service myapp (ClusterIP)&#10;ClusterIP: 10.x.x.x  ·  port: 443  ·  targetPort: 8080&#10;selector: app=myapp" vertex="1">
          <mxGeometry x="380" y="700" width="380" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="es" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d4e1f5;strokeColor=#5b87b9;align=center;fontSize=10;" value="EndpointSlice&#10;(maintained by EndpointSlice controller; kept in sync with Ready Pods matching the selector)" vertex="1">
          <mxGeometry x="380" y="800" width="380" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="proxy" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d4e1f5;strokeColor=#5b87b9;align=center;fontSize=10;fontStyle=2;" value="kube-proxy on each node watches the EndpointSlice and writes&#10;iptables/IPVS DNAT rules: ClusterIP:443 → one of the Pod IPs:8080" vertex="1">
          <mxGeometry x="780" y="800" width="380" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="pod1" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=center;fontSize=11;" value="Pod myapp-abc&#10;10.y.y.y:8080" vertex="1">
          <mxGeometry x="240" y="900" width="200" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="pod2" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=center;fontSize=11;" value="Pod myapp-def&#10;10.y.y.z:8080" vertex="1">
          <mxGeometry x="470" y="900" width="200" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="pod3" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=center;fontSize=11;" value="Pod myapp-xyz&#10;10.y.y.w:8080" vertex="1">
          <mxGeometry x="700" y="900" width="200" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="e_user_fw" parent="1" edge="1" source="user" target="fw" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;endArrow=classic;strokeColor=#b85450;strokeWidth=2;fontColor=#b85450;fontSize=10;fontStyle=1;" value="HTTPS over TCP/443"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_fw_lb" parent="1" edge="1" source="fw" target="lb" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;endArrow=classic;strokeColor=#b85450;strokeWidth=2;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_lb_haproxy" parent="1" edge="1" source="lb" target="haproxy" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;endArrow=classic;strokeColor=#9673a6;strokeWidth=2;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_haproxy_route" parent="1" edge="1" source="haproxy" target="route" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;endArrow=classic;strokeColor=#9673a6;strokeWidth=2;fontColor=#9673a6;fontSize=10;fontStyle=1;" value="match by Host:"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_route_svc" parent="1" edge="1" source="route" target="svc" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;endArrow=classic;strokeColor=#9673a6;strokeWidth=2;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_svc_es" parent="1" edge="1" source="svc" target="es" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;endArrow=classic;strokeColor=#5b87b9;strokeWidth=2;fontColor=#5b87b9;fontSize=10;" value="selector resolves to Endpoints"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_es_pod1" parent="1" edge="1" source="es" target="pod1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;endArrow=classic;strokeColor=#82b366;strokeWidth=2;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_es_pod2" parent="1" edge="1" source="es" target="pod2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;endArrow=classic;strokeColor=#82b366;strokeWidth=2;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_es_pod3" parent="1" edge="1" source="es" target="pod3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;endArrow=classic;strokeColor=#82b366;strokeWidth=2;"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="failnotes_title" parent="1" style="text;html=1;align=left;fontStyle=1;fontSize=12;" value="Where each layer can break:" vertex="1">
          <mxGeometry x="80" y="1010" width="500" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="fn1" parent="1" style="text;html=1;align=left;fontSize=10;" value="• Firewall closed → connection refused / timeout from the user's browser" vertex="1">
          <mxGeometry x="80" y="1035" width="1000" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="fn2" parent="1" style="text;html=1;align=left;fontSize=10;" value="• Route doesn't match Host: header → HAProxy returns 503 / 404; check `oc get routes` for the right hostname" vertex="1">
          <mxGeometry x="80" y="1055" width="1000" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="fn3" parent="1" style="text;html=1;align=left;fontSize=10;" value="• Service has no Ready endpoints → HAProxy returns 503; check `oc get endpoints` — is it empty? Selector mismatch or probe failure" vertex="1">
          <mxGeometry x="80" y="1075" width="1000" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="fn4" parent="1" style="text;html=1;align=left;fontSize=10;" value="• Pod not Ready → endpoint dropped; HAProxy returns 503; check `oc describe pod` Events" vertex="1">
          <mxGeometry x="80" y="1095" width="1000" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="fn5" parent="1" style="text;html=1;align=left;fontSize=10;" value="• TLS cert mismatch between HAProxy edge and backend → reencrypt fails; HAProxy returns 502" vertex="1">
          <mxGeometry x="80" y="1115" width="1000" height="20" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
