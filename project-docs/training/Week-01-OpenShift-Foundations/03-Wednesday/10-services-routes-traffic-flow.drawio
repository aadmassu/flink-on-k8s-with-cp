        <mxCell id="title" parent="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=16;fontStyle=1;" value="One HTTPS request — user browser to Pod, in OpenShift" vertex="1">
          <mxGeometry height="40" width="1000" x="80" y="20" as="geometry" />
        </mxCell>
        <mxCell id="user" parent="1" style="ellipse;shape=cloud;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=center;fontSize=11;" value="User browser&#xa;https://myapp.apps.&lt;env&gt;.ocp.example.com" vertex="1">
          <mxGeometry height="80" width="380" x="380" y="90" as="geometry" />
        </mxCell>
        <mxCell id="fw" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;align=center;fontSize=12;" value="enterprise perimeter firewall — TCP/443 from User Zone to OCP LB IP" vertex="1">
          <mxGeometry height="50" width="554" x="293" y="223" as="geometry" />
        </mxCell>
        <mxCell id="lb" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=center;fontSize=11;" value="OCP cluster Load Balancer IP&#xa;(DEV: 10.7.72.209  ·  QA: 10.7.72.212  ·  ...)" vertex="1">
          <mxGeometry height="60" width="553" x="294" y="323" as="geometry" />
        </mxCell>
        <mxCell id="haproxy" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;align=center;fontSize=11;" value="HAProxy Ingress Router pod (on a dedicated Core Zone router node)&#xa;Reads the Host: header; matches a Route; performs TLS termination (reencrypt mode for the platform)" vertex="1">
          <mxGeometry height="80" width="557" x="292" y="430" as="geometry" />
        </mxCell>
        <mxCell id="route" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=center;fontSize=11;" value="Route&#xa;host: myapp.apps.&lt;env&gt;.ocp.example.com&#xa;to: Service myapp&#xa;tls.termination: reencrypt" vertex="1">
          <mxGeometry height="100" width="380" x="381" y="560" as="geometry" />
        </mxCell>
        <mxCell id="svc" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=center;fontSize=11;" value="Service myapp (ClusterIP)&#xa;ClusterIP: 10.x.x.x  ·  port: 443  ·  targetPort: 8080&#xa;selector: app=myapp" vertex="1">
