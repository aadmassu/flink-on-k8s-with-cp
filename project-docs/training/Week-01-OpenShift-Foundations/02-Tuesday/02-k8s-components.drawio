        </mxCell>
        <mxCell id="l4_node_3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EE0000;strokeColor=#FFFFFF;strokeWidth=2;fontStyle=1;fontSize=12;fontColor=#FFFFFF;verticalAlign=top;align=left;spacingLeft=15;spacingTop=8;arcSize=7;" value="Node-3 (GPU)" vertex="1">
          <mxGeometry height="100" width="480" x="1070" y="393" as="geometry" />
        </mxCell>
        <mxCell id="l4_node_3_taint" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Courier New;fontSize=10;fontColor=#FFFFFF;" value="taints: nvidia.com/gpu=true:NoSchedule" vertex="1">
          <mxGeometry height="20" width="450" x="1085" y="460" as="geometry" />
        </mxCell>
        <mxCell id="l4_e_a" edge="1" parent="1" source="l4_pod_a_tol" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;endArrow=classic;strokeColor=#326CE5;strokeWidth=2;fontColor=#326CE5;fontSize=10;fontStyle=1;" target="l4_node_1" value="✓ schedules">
