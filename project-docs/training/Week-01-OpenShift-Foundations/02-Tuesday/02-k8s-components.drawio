        </mxCell>
        <mxCell id="l2_flink" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#EE0000;align=left;verticalAlign=middle;fontSize=11;fontColor=#EE0000;spacingLeft=10;" value="Flink rescaling — parallelism is a job property:&#xa;  1. stop job with savepoint&#xa;  2. submit new job with new parallelism&#xa;  3. restore from savepoint (state repartitions)" vertex="1">
          <mxGeometry height="100" width="680" x="880" y="500" as="geometry" />
        </mxCell>
        <mxCell id="l2_flink_note" parent="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#EE0000;fontStyle=2;" value="Don&#39;t HPA stateful workloads — terminating Pods can lose ISR / partition leadership" vertex="1">
          <mxGeometry height="20" width="680" x="880" y="630" as="geometry" />
        </mxCell>
        <mxCell id="l2_key_title" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontStyle=1;fontSize=12;" value="Component Roles (one-liner each)" vertex="1">
          <mxGeometry height="20" width="500" x="70" y="800" as="geometry" />
        </mxCell>
        <mxCell id="l2_key_hpa" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=1" value="HPA          — HorizontalPodAutoscaler; watches CPU / memory / custom metric, updates .spec.replicas of a Deployment within min/max bounds." vertex="1">
          <mxGeometry height="20" width="1500" x="70" y="825" as="geometry" />
        </mxCell>
        <mxCell id="l2_key_vpa" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=1" value="VPA          — VerticalPodAutoscaler; resizes requests/limits per Pod (bigger Pods, not more of them); requires Pod restart; less common in production." vertex="1">
          <mxGeometry height="20" width="1500" x="70" y="845" as="geometry" />
        </mxCell>
        <mxCell id="l2_key_ca" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=1" value="Cluster Autoscaler — adds/removes Nodes (not Pods) when Pods are unschedulable or nodes are underutilized; runs at the cloud/infrastructure layer." vertex="1">
          <mxGeometry height="20" width="1500" x="70" y="865" as="geometry" />
        </mxCell>
        <mxCell id="l2_key_kafka" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=1" value="Kafka scaling — partition count is fixed at topic creation; adding brokers requires manual partition reassignment; throughput scales with partitions, not brokers." vertex="1">
          <mxGeometry height="20" width="1500" x="70" y="885" as="geometry" />
        </mxCell>
        <mxCell id="l2_key_flink" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=1" value="Flink scaling — parallelism baked into job submission; rescale = stop with savepoint + restart with new parallelism + state repartition; reactive mode auto-scales TMs (not used here yet)." vertex="1">
          <mxGeometry height="20" width="1500" x="70" y="905" as="geometry" />
        </mxCell>
        <mxCell id="l2_key_legend" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontStyle=3;" value="Colors — BLUE = stateless (HPA-friendly).  RED = stateful (manual + planned).  Dashed Pod = new replica with no partitions assigned." vertex="1">
          <mxGeometry height="20" width="1500" x="70" y="930" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
