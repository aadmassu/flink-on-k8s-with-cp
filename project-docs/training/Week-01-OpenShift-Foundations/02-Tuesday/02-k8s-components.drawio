        <mxCell id="l4_node_1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#9bb3dd;strokeColor=#326CE5;strokeWidth=2;fontStyle=1;fontSize=12;fontColor=#FFFFFF;verticalAlign=top;align=left;spacingLeft=15;spacingTop=8;arcSize=7;" value="Node-1 (generic)" vertex="1">
          <mxGeometry height="100" width="480" x="1070" y="160" as="geometry" />
        </mxCell>
        <mxCell id="l4_node_1_taint" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Courier New;fontSize=10;fontColor=#FFFFFF;" value="taints: []" vertex="1">
          <mxGeometry height="20" width="450" x="1085" y="230" as="geometry" />
        </mxCell>
        <mxCell id="l4_node_2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EE0000;strokeColor=#FFFFFF;strokeWidth=2;fontStyle=1;fontSize=12;fontColor=#FFFFFF;verticalAlign=top;align=left;spacingLeft=15;spacingTop=8;arcSize=7;" value="Node-2 (Kafka-dedicated)" vertex="1">
          <mxGeometry height="100" width="480" x="1070" y="272" as="geometry" />
        </mxCell>
        <mxCell id="l4_node_2_taint" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Courier New;fontSize=10;fontColor=#FFFFFF;" value="taints: dedicated=kafka:NoSchedule" vertex="1">
