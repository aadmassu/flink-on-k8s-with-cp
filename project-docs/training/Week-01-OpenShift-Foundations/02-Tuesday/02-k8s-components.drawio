          <mxGeometry height="32" width="140" x="1155" y="490" as="geometry" />
        </mxCell>
        <mxCell id="l3_good_fail_n3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#9bb3dd;strokeColor=#326CE5;strokeWidth=2;fontStyle=1;fontSize=11;fontColor=#FFFFFF;verticalAlign=top;align=left;spacingLeft=10;spacingTop=8;arcSize=7;" value="Node-3" vertex="1">
          <mxGeometry height="100" width="180" x="1355" y="450" as="geometry" />
        </mxCell>
        <mxCell id="l3_good_alive2" parent="1" style="rounded=20;whiteSpace=wrap;html=1;fillColor=#326CE5;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontSize=11;fontStyle=1;align=center;" value="broker-2 ✓" vertex="1">
          <mxGeometry height="32" width="140" x="1375" y="490" as="geometry" />
        </mxCell>
        <mxCell id="l3_good_result" parent="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontColor=#82b366;fontStyle=1;" value="ISR = 2 · producer writes continue · only 1 broker affected" vertex="1">
          <mxGeometry height="20" width="640" x="900" y="595" as="geometry" />
        </mxCell>
        <mxCell id="l3_good_yaml" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#326CE5;align=left;verticalAlign=middle;fontFamily=Courier New;fontSize=10;fontColor=#326CE5;spacingLeft=10;" value="podAntiAffinity:&#xa;  requiredDuringSchedulingIgnoredDuringExecution:&#xa;    - labelSelector: { matchLabels: { app: kafka } }&#xa;      topologyKey: kubernetes.io/hostname" vertex="1">
          <mxGeometry height="80" width="640" x="900" y="650" as="geometry" />
        </mxCell>
        <mxCell id="l3_key_title" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontStyle=1;fontSize=12;" value="Component Roles (one-liner each)" vertex="1">
          <mxGeometry height="20" width="500" x="70" y="800" as="geometry" />
        </mxCell>
        <mxCell id="l3_key_aff" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=1" value="podAffinity        — schedule Pod A near (or on the same Node as) Pods matching a label; e.g. cache near app." vertex="1">
          <mxGeometry height="20" width="1500" x="70" y="825" as="geometry" />
        </mxCell>
        <mxCell id="l3_key_anti" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=1" value="podAntiAffinity    — schedule Pod A AWAY from Pods matching a label; the Kafka pattern: no two brokers on the same node (topologyKey=hostname)." vertex="1">
          <mxGeometry height="20" width="1500" x="70" y="845" as="geometry" />
        </mxCell>
        <mxCell id="l3_key_node" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=1" value="nodeAffinity       — schedule Pod onto specific Nodes (by label, e.g. zone, instance type, SSD); pairs naturally with taints + tolerations (Lesson 4)." vertex="1">
          <mxGeometry height="20" width="1500" x="70" y="865" as="geometry" />
        </mxCell>
        <mxCell id="l3_key_topo" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=1" value="topologyKey        — the label on Nodes used to define a &quot;topology domain&quot; — hostname (per-node), zone (per-AZ), region; choose based on the failure boundary you protect against." vertex="1">
          <mxGeometry height="20" width="1500" x="70" y="885" as="geometry" />
        </mxCell>
        <mxCell id="l3_key_req" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=1" value="required vs preferred — &quot;requiredDuringScheduling&quot; is a hard rule (Pod can&#39;t schedule if it can&#39;t satisfy); &quot;preferredDuringScheduling&quot; is a soft hint (best-effort)." vertex="1">
          <mxGeometry height="20" width="1500" x="70" y="905" as="geometry" />
        </mxCell>
        <mxCell id="l3_key_legend" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontStyle=3;" value="Colors — RED box (left) = without anti-affinity (single-node failure = cluster down).  BLUE box (right) = with anti-affinity (single-node failure = 1 broker lost, ISR holds)." vertex="1">
          <mxGeometry height="20" width="1500" x="70" y="930" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
