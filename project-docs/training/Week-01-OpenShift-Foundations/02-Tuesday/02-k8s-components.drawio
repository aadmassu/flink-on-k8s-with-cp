        <mxCell id="key_pod" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=1" value="Pod         — smallest deployable unit; 1+ containers sharing network namespace + volumes; ephemeral by default; no stable identity on its own." vertex="1">
          <mxGeometry height="20" width="1500" x="70" y="1157" as="geometry" />
        </mxCell>
        <mxCell id="key_dep" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=1" value="Deployment  — declares N interchangeable Pods; wraps a ReplicaSet; Pod restart = new name + new IP; ideal for stateless workloads (CMF, Connect, SR, REST APIs)." vertex="1">
          <mxGeometry height="20" width="1500" x="70" y="1177" as="geometry" />
        </mxCell>
        <mxCell id="key_rs" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=1" value="ReplicaSet  — owned by Deployment; the actual replica-count enforcer; rarely managed directly — Deployments rotate ReplicaSets during rollouts." vertex="1">
          <mxGeometry height="20" width="1500" x="70" y="1197" as="geometry" />
        </mxCell>
        <mxCell id="key_sts" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=1" value="StatefulSet — Pods with stable names (kafka-0, kafka-1, ...), stable DNS, and per-Pod PVC that follows the Pod across restarts; ordered lifecycle; required for Kafka brokers." vertex="1">
          <mxGeometry height="20" width="1500" x="70" y="1217" as="geometry" />
        </mxCell>
        <mxCell id="key_pvc" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=1" value="PVC         — PersistentVolumeClaim. StatefulSet creates one per Pod ordinal and reattaches it on Pod recreation — that&#39;s why kafka-0&#39;s log data survives a Pod delete." vertex="1">
          <mxGeometry height="20" width="1500" x="70" y="1237" as="geometry" />
        </mxCell>
        <mxCell id="key_cr" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=1" value="CR / Operator — a Custom Resource (rhombus) is watched by an Operator (controller Pod) that creates/updates underlying Deployment or StatefulSet (Week 2 Tuesday pattern)." vertex="1">
          <mxGeometry height="20" width="1500" x="70" y="1257" as="geometry" />
        </mxCell>
        <mxCell id="key_legend" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontStyle=3;" value="Colors — BLUE heptagons + boxes = stateless / interchangeable (Deployment world).  RED heptagons + boxes = stateful / identity-preserving (StatefulSet world).  Dashed edges = operator-driven creation." vertex="1">
          <mxGeometry height="20" width="1500" x="70" y="1280" as="geometry" />
        </mxCell>
