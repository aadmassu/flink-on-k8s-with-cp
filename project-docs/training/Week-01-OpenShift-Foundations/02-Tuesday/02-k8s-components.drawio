        <mxCell id="l4_nodes_box" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdecec;strokeColor=#EE0000;strokeWidth=2;fontStyle=1;fontSize=14;fontColor=#EE0000;verticalAlign=top;align=left;spacingLeft=20;spacingTop=10;arcSize=4;" value="Nodes (with their taints)" vertex="1">
