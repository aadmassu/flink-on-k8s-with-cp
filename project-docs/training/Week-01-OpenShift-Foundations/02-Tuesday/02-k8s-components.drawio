        </mxCell>
        <mxCell id="l4_pod_c" parent="1" style="rounded=20;whiteSpace=wrap;html=1;fillColor=#326CE5;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontSize=12;fontStyle=1;align=center;" value="Pod C&#xa;ML training" vertex="1">
          <mxGeometry height="60" width="160" x="110" y="410" as="geometry" />
        </mxCell>
        <mxCell id="l4_pod_c_tol" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#326CE5;align=left;verticalAlign=middle;fontFamily=Courier New;fontSize=10;fontColor=#326CE5;spacingLeft=10;" value="tolerations:&#xa;  - key: nvidia.com/gpu&#xa;    value: &quot;true&quot;&#xa;    effect: NoSchedule" vertex="1">
          <mxGeometry height="80" width="320" x="280" y="400" as="geometry" />
        </mxCell>
        <mxCell id="l4_pod_d" parent="1" style="rounded=20;whiteSpace=wrap;html=1;fillColor=#b85450;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontSize=12;fontStyle=1;align=center;dashed=1;" value="Pod D&#xa;random job" vertex="1">
