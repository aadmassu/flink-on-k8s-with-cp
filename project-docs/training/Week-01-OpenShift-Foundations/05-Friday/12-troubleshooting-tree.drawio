<mxfile host="app.diagrams.net" agent="manual">
  <diagram name="Troubleshooting Decision Tree" id="troubleshooting-tree">
    <mxGraphModel dx="1422" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" parent="1" style="text;html=1;align=center;fontSize=16;fontStyle=1;" value="OpenShift troubleshooting tree — top-down, in this order" vertex="1">
          <mxGeometry x="80" y="20" width="1500" height="40" as="geometry"/>
        </mxCell>

        <mxCell id="symptom" parent="1" style="ellipse;shape=cloud;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=center;fontSize=12;fontStyle=1;" value="App is broken on OpenShift" vertex="1">
          <mxGeometry x="700" y="90" width="260" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="l1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;align=center;fontSize=12;" value="Level 1 — does the Pod even exist?&#10;oc get pod &lt;name&gt;     ·     oc describe deployment &lt;name&gt;" vertex="1">
          <mxGeometry x="280" y="220" width="1100" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="l1_no" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=center;fontSize=10;" value="If NO Pod:&#10;controller couldn't create it.&#10;Quota? Admission policy? SA missing?&#10;Look at the Deployment's Events." vertex="1">
          <mxGeometry x="100" y="310" width="220" height="100" as="geometry"/>
        </mxCell>

        <mxCell id="l2" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;align=center;fontSize=12;" value="Level 2 — is the Pod scheduled to a node?&#10;oc get pod &lt;name&gt; -o wide     ·     oc describe pod &lt;name&gt;" vertex="1">
          <mxGeometry x="380" y="450" width="900" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="l2_no" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=center;fontSize=10;" value="If Pending, no NODE:&#10;scheduler couldn't bind.&#10;0/N nodes available · taints · PVC unbound&#10;→ check StorageClass, PV, resources" vertex="1">
          <mxGeometry x="100" y="540" width="220" height="100" as="geometry"/>
        </mxCell>

        <mxCell id="l3" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;align=center;fontSize=12;" value="Level 3 — is the container running?&#10;oc describe pod &lt;name&gt;     ·     check container.state" vertex="1">
          <mxGeometry x="380" y="680" width="900" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="l3_no" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=center;fontSize=10;" value="If ImagePullBackOff / CrashLoopBackOff:&#10;image not pullable (auth, name, registry) · OOMKilled · probe failing · crashed app&#10;→ logs (current) · logs --previous" vertex="1">
          <mxGeometry x="100" y="770" width="220" height="120" as="geometry"/>
        </mxCell>

        <mxCell id="l4" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;align=center;fontSize=12;" value="Level 4 — is the application working?&#10;oc logs &lt;name&gt; [--previous] [-c &lt;container&gt;]     ·     oc exec     ·     oc port-forward" vertex="1">
          <mxGeometry x="380" y="910" width="900" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="l4_no" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=center;fontSize=10;" value="If container Ready but app broken:&#10;bad config · missing env var · can't reach dependency&#10;→ exec in &amp; curl from inside · port-forward from your laptop · check ConfigMap/Secret content" vertex="1">
          <mxGeometry x="100" y="1000" width="220" height="120" as="geometry"/>
        </mxCell>

        <mxCell id="route_branch" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=center;fontSize=11;fontStyle=1;" value="Auxiliary: if reported as &quot;the URL returns 503&quot;&#10;Pod might be fine — check the Route &amp; Service first:&#10;oc get routes · oc get endpoints &lt;svc&gt; (empty?)&#10;Selector mismatch · ProbeReady failing · Route hostname typo" vertex="1">
          <mxGeometry x="1320" y="450" width="280" height="160" as="geometry"/>
        </mxCell>

        <mxCell id="always" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=center;fontSize=11;fontStyle=1;" value="Always useful, at any level:&#10;oc get events --sort-by=.lastTimestamp | tail -50&#10;oc top pod &lt;name&gt;&#10;oc get all -l &lt;label&gt;&#10;oc describe project &lt;you&gt;-training (Quota? LimitRange?)" vertex="1">
          <mxGeometry x="1320" y="680" width="280" height="160" as="geometry"/>
        </mxCell>

        <mxCell id="e_symptom_l1" parent="1" edge="1" source="symptom" target="l1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;endArrow=classic;strokeColor=#6c8ebf;strokeWidth=2;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_l1_yes_l2" parent="1" edge="1" source="l1" target="l2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;endArrow=classic;strokeColor=#6c8ebf;strokeWidth=2;fontSize=10;fontStyle=2;" value="Pod exists →"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_l1_no_l1no" parent="1" edge="1" source="l1" target="l1_no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0;entryDx=0;entryDy=0;endArrow=classic;strokeColor=#b85450;strokeWidth=2;fontSize=10;fontStyle=2;" value="No Pod"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_l2_yes_l3" parent="1" edge="1" source="l2" target="l3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;endArrow=classic;strokeColor=#6c8ebf;strokeWidth=2;fontSize=10;fontStyle=2;" value="scheduled →"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_l2_no_l2no" parent="1" edge="1" source="l2" target="l2_no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0;entryDx=0;entryDy=0;endArrow=classic;strokeColor=#b85450;strokeWidth=2;fontSize=10;fontStyle=2;" value="Pending"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_l3_yes_l4" parent="1" edge="1" source="l3" target="l4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;endArrow=classic;strokeColor=#6c8ebf;strokeWidth=2;fontSize=10;fontStyle=2;" value="container Running →"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_l3_no_l3no" parent="1" edge="1" source="l3" target="l3_no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0;entryDx=0;entryDy=0;endArrow=classic;strokeColor=#b85450;strokeWidth=2;fontSize=10;fontStyle=2;" value="Crash / Backoff"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_l4_no_l4no" parent="1" edge="1" source="l4" target="l4_no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0;entryDx=0;entryDy=0;endArrow=classic;strokeColor=#b85450;strokeWidth=2;fontSize=10;fontStyle=2;" value="App broken"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="footer" parent="1" style="text;html=1;align=center;fontSize=10;fontStyle=2;" value="Rule of thumb: never skip a level. Most wasted hours are spent reading logs (Level 4) when the failure is at Level 1, 2, or 3." vertex="1">
          <mxGeometry x="80" y="1130" width="1500" height="20" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
