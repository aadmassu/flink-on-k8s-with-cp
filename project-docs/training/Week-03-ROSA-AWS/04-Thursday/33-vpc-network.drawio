        </mxCell>
        <mxCell id="rt_pub" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;align=left;verticalAlign=middle;fontSize=10;spacingLeft=10;" value="Route table:&#10;0.0.0.0/0 → IGW" vertex="1">
          <mxGeometry x="720" y="310" width="200" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="priv" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=center;verticalAlign=top;fontStyle=1;fontSize=12;spacingTop=10;" value="Private subnets 10.0.2.0/24, 10.0.3.0/24, 10.0.4.0/24 (multi-AZ)" vertex="1">
          <mxGeometry x="120" y="460" width="820" height="500" as="geometry"/>
        </mxCell>
        <mxCell id="worker" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#9bb3dd;strokeColor=#326CE5;align=center;fontSize=11;" value="Worker node (EC2)" vertex="1">
