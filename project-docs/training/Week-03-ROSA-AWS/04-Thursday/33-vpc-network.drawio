<mxfile host="app.diagrams.net" agent="manual">
  <diagram name="VPC Network" id="vpc-network">
    <mxGraphModel dx="1422" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" parent="1" style="text;html=1;align=center;fontSize=16;fontStyle=1;" value="VPC Network — Pod egress paths + how external clients reach the cluster" vertex="1">
          <mxGeometry x="80" y="20" width="1500" height="40" as="geometry"/>
        </mxCell>

        <mxCell id="vpc" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;verticalAlign=top;fontStyle=1;fontSize=14;spacingTop=10;" value="VPC (10.0.0.0/16)" vertex="1">
          <mxGeometry x="80" y="100" width="900" height="900" as="geometry"/>
        </mxCell>

        <mxCell id="igw" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=center;fontSize=11;fontStyle=1;" value="Internet Gateway&#10;(IGW)" vertex="1">
          <mxGeometry x="380" y="160" width="200" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="pub" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=center;verticalAlign=top;fontStyle=1;fontSize=12;spacingTop=10;" value="Public subnet 10.0.1.0/24" vertex="1">
          <mxGeometry x="120" y="260" width="820" height="160" as="geometry"/>
        </mxCell>
        <mxCell id="nlb" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;align=center;fontSize=11;" value="NLB / ALB&#10;(public IP; serves Routes' external endpoint)" vertex="1">
          <mxGeometry x="160" y="310" width="280" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="nat" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;align=center;fontSize=11;" value="NAT Gateway&#10;(elastic IP)" vertex="1">
