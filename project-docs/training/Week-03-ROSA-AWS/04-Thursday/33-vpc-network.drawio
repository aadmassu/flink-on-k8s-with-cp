        <mxCell id="sg" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;align=left;verticalAlign=middle;fontSize=10;spacingLeft=10;" value="Security Group on worker:&#10;ingress 6443 from masters&#10;ingress 9092/9094 from VPN CIDR (for cluster-link)&#10;egress: ALL" vertex="1">
          <mxGeometry x="160" y="680" width="320" height="100" as="geometry"/>
