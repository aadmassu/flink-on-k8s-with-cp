<mxfile host="app.diagrams.net" agent="manual">
  <diagram name="GitOps Flow" id="gitops">
    <mxGraphModel dx="1422" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" parent="1" style="text;html=1;align=center;fontSize=16;fontStyle=1;" value="GitOps with ArgoCD — Git is the source of truth; ArgoCD reconciles" vertex="1">
          <mxGeometry x="80" y="20" width="1500" height="40" as="geometry"/>
        </mxCell>

        <mxCell id="eng" parent="1" style="ellipse;shape=cloud;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=center;fontSize=11;" value="Engineer&#10;writes YAML in a feature branch, opens a PR, merges" vertex="1">
          <mxGeometry x="80" y="120" width="320" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="git" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;fontSize=14;fontStyle=1;" value="Git repository (source of truth)&#10;e.g. apps/confluent-platform/dev/kafka.yaml" vertex="1">
          <mxGeometry x="600" y="120" width="400" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="argo" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=center;verticalAlign=top;fontStyle=1;fontSize=13;spacingTop=10;" value="ArgoCD (in openshift-gitops namespace)" vertex="1">
          <mxGeometry x="1140" y="100" width="440" height="380" as="geometry"/>
        </mxCell>
        <mxCell id="repo_server" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;align=center;fontSize=11;" value="Repo Server&#10;polls Git every ~3 min&#10;clones + renders manifests" vertex="1">
          <mxGeometry x="1160" y="160" width="200" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="app_ctl" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;align=center;fontSize=11;" value="Application Controller&#10;reconcile loop (Week 2 Tue pattern)&#10;compares Git vs cluster&#10;applies the diff" vertex="1">
          <mxGeometry x="1380" y="160" width="180" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="api_in_argo" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;align=center;fontSize=11;" value="API Server + Web UI&#10;engineers see sync status,&#10;click 'Sync Now', view live diffs" vertex="1">
          <mxGeometry x="1160" y="280" width="400" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="argo_note" parent="1" style="text;html=1;align=center;fontSize=10;fontStyle=2;" value="Application CR: name + repo + path + revision + destination namespace" vertex="1">
          <mxGeometry x="1160" y="390" width="400" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="api" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#326CE5;strokeColor=#FFFFFF;strokeWidth=2;align=center;fontColor=#FFFFFF;fontSize=14;fontStyle=1;" value="OCP kube-apiserver" vertex="1">
          <mxGeometry x="700" y="540" width="240" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="ocp" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=center;verticalAlign=top;fontStyle=1;fontSize=12;spacingTop=10;" value="OpenShift cluster" vertex="1">
          <mxGeometry x="80" y="660" width="1500" height="180" as="geometry"/>
        </mxCell>
        <mxCell id="ns" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;dashed=1;align=center;fontSize=11;" value="confluent-operator namespace&#10;(CFK Operator + CRDs)" vertex="1">
          <mxGeometry x="120" y="710" width="280" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="ns2" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;dashed=1;align=center;fontSize=11;" value="dah-flink-* namespaces&#10;(platform-security ArgoCD chart: SA + Role + RB)" vertex="1">
          <mxGeometry x="440" y="710" width="320" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="ns3" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;dashed=1;align=center;fontSize=11;" value="cert-manager namespace&#10;(cert-manager Operator + ClusterIssuer)" vertex="1">
          <mxGeometry x="800" y="710" width="320" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="argonote" parent="1" style="text;html=1;align=center;fontSize=10;fontStyle=2;" value="In production, ArgoCD owns OPERATORS + cluster services (left).&#10;Azure DevOps owns WORKLOADS (right) — see Tushar&apos;s pipeline, not on this diagram." vertex="1">
          <mxGeometry x="1160" y="710" width="380" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="signals" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=center;verticalAlign=top;fontStyle=1;fontSize=12;spacingTop=10;" value="Two signals — read BOTH" vertex="1">
          <mxGeometry x="80" y="880" width="1500" height="180" as="geometry"/>
        </mxCell>
        <mxCell id="sync_signal" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;align=left;verticalAlign=middle;fontSize=11;spacingLeft=12;" value="Sync — does the cluster match Git?&#10;  Synced     ✓ cluster reflects Git exactly&#10;  OutOfSync  ✗ drift exists (manual oc apply OR engineer pushed but ArgoCD hasn&apos;t polled)&#10;  Unknown    ?  ArgoCD can&apos;t read the repo (auth, branch missing)" vertex="1">
          <mxGeometry x="100" y="930" width="720" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="health_signal" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;align=left;verticalAlign=middle;fontSize=11;spacingLeft=12;" value="Health — is the workload actually working?&#10;  Healthy      ✓ all owned objects Ready&#10;  Degraded     ✗ a Pod CrashLoopBackOff, a PVC stuck, etc.&#10;  Progressing  ⏳ a Deployment rollout in flight&#10;  Missing      ? the manifest is in Git but no live cluster object found" vertex="1">
          <mxGeometry x="840" y="930" width="720" height="120" as="geometry"/>
        </mxCell>

        <mxCell id="e_eng_git" parent="1" edge="1" source="eng" target="git" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;endArrow=classic;strokeColor=#6c8ebf;strokeWidth=2;fontSize=10;" value="git push"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_git_argo" parent="1" edge="1" source="git" target="repo_server" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;endArrow=classic;strokeColor=#d79b00;strokeWidth=2;fontSize=10;" value="poll"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_argo_api" parent="1" edge="1" source="app_ctl" target="api" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;endArrow=classic;strokeColor=#d79b00;strokeWidth=2;fontSize=10;" value="oc apply"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_api_ocp" parent="1" edge="1" source="api" target="ocp" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;endArrow=classic;strokeColor=#326CE5;strokeWidth=2;"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
