        <mxCell id="key_title" parent="1" style="text;html=1;align=left;fontStyle=1;fontSize=12;" value="Key takeaway — each Pod gets its own PVC, its own PV, its own RBD image. No sharing." vertex="1">
          <mxGeometry x="80" y="860" width="1000" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="key_note" parent="1" style="text;html=1;align=left;fontSize=10;" value="On Pod restart: same Pod name → same PVC → same PV → same disk. The broker resumes with its log directory intact.&#10;If the PVC's PV is lost (reclaim Delete + GC): the broker can never come back with the same identity. Critical for Kafka." vertex="1">
          <mxGeometry x="80" y="885" width="1000" height="50" as="geometry"/>
        </mxCell>
