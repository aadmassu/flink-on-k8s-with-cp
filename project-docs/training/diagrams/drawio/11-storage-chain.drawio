      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" parent="1" style="text;html=1;align=center;fontSize=16;fontStyle=1;" value="Storage chain — Pod → PVC → PV → StorageClass → backing storage" vertex="1">
          <mxGeometry x="80" y="20" width="1000" height="40" as="geometry"/>
        </mxCell>

        <mxCell id="sts" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;align=center;fontSize=12;" value="StatefulSet (e.g. Kafka)&#10;volumeClaimTemplates → one PVC per Pod" vertex="1">
