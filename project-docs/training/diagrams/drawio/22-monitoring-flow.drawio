<mxfile host="app.diagrams.net" agent="manual">
  <diagram name="Monitoring Flow" id="monitoring-flow">
    <mxGraphModel dx="1422" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" parent="1" style="text;html=1;align=center;fontSize=16;fontStyle=1;" value="Monitoring flow — Pod /metrics → Prometheus → PromQL → Grafana → engineer" vertex="1">
          <mxGeometry x="80" y="20" width="1500" height="40" as="geometry"/>
        </mxCell>

        <mxCell id="pod" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;align=center;verticalAlign=top;fontSize=12;spacingTop=10;" value="Kafka broker Pod  (kafka-0)" vertex="1">
          <mxGeometry x="80" y="100" width="400" height="220" as="geometry"/>
        </mxCell>
        <mxCell id="broker_c" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;align=center;fontSize=11;" value="kafka container&#10;emits JVM MBeans on JMX :9999" vertex="1">
          <mxGeometry x="110" y="150" width="170" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="exporter_c" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;align=center;fontSize=11;" value="jmx-exporter sidecar&#10;:7071/metrics&#10;(translates MBeans → Prom text)" vertex="1">
          <mxGeometry x="290" y="150" width="180" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="pod_note" parent="1" style="text;html=1;align=center;fontSize=10;fontStyle=2;" value="Same Pod, shared network namespace — sidecar can scrape :9999 over localhost" vertex="1">
          <mxGeometry x="100" y="270" width="360" height="40" as="geometry"/>
        </mxCell>

        <mxCell id="sm" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d4e1f5;strokeColor=#5b87b9;align=center;fontSize=11;fontStyle=1;" value="ServiceMonitor / PodMonitor&#10;tells Prometheus WHAT to scrape&#10;(selector + endpoints + interval)" vertex="1">
          <mxGeometry x="560" y="160" width="280" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="prom" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=center;fontSize=14;fontStyle=1;" value="Prometheus" vertex="1">
          <mxGeometry x="940" y="160" width="200" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="prom_note" parent="1" style="text;html=1;align=center;fontSize=10;fontStyle=2;" value="HTTP GET /metrics every 30s (default)&#10;Stores samples in local TSDB" vertex="1">
          <mxGeometry x="900" y="250" width="280" height="40" as="geometry"/>
        </mxCell>

        <mxCell id="tsdb" parent="1" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=center;fontSize=11;" value="TSDB&#10;time-series:&#10;{metric, labels} → samples" vertex="1">
          <mxGeometry x="940" y="320" width="200" height="100" as="geometry"/>
        </mxCell>

        <mxCell id="grafana" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=center;fontSize=14;fontStyle=1;" value="Grafana&#10;Dashboard panel runs PromQL&#10;sum by (pod) (kafka_..._under_replicated)" vertex="1">
          <mxGeometry x="1240" y="160" width="320" height="100" as="geometry"/>
        </mxCell>

        <mxCell id="amgr" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=center;fontSize=11;fontStyle=1;" value="Alertmanager&#10;evaluates PromQL alert rules&#10;routes alerts to Slack / email / PagerDuty" vertex="1">
          <mxGeometry x="1240" y="320" width="320" height="100" as="geometry"/>
        </mxCell>

        <mxCell id="eye" parent="1" style="ellipse;shape=cloud;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=center;fontSize=11;" value="Engineer's eyeball / Slack" vertex="1">
          <mxGeometry x="1300" y="490" width="200" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="metrics_anchor" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;verticalAlign=top;fontStyle=1;fontSize=12;spacingTop=10;" value="Three CFK-side metrics that answer &quot;is Kafka healthy?&quot;" vertex="1">
          <mxGeometry x="80" y="620" width="1500" height="180" as="geometry"/>
        </mxCell>
        <mxCell id="m1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;align=left;verticalAlign=middle;fontSize=11;spacingLeft=10;" value="kafka_server_replicamanager_underreplicatedpartitions&#10;&#9;&#9;&#9;&#9;→ &gt; 0 means a replica is behind. THE single most important alert." vertex="1">
          <mxGeometry x="100" y="670" width="700" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="m2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;align=left;verticalAlign=middle;fontSize=11;spacingLeft=10;" value="kafka_controller_kafkacontroller_activecontrollercount&#10;&#9;&#9;&#9;&#9;→ exactly 1 cluster-wide; if 0, the cluster has no controller." vertex="1">
          <mxGeometry x="820" y="670" width="700" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="m3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;align=left;verticalAlign=middle;fontSize=11;spacingLeft=10;" value="kafka_consumer_consumer_fetch_manager_metrics_records_lag_max&#10;&#9;&#9;&#9;&#9;→ per-consumer-group lag; spikes = consumers can&apos;t keep up." vertex="1">
          <mxGeometry x="100" y="730" width="1420" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="failures" parent="1" style="text;html=1;align=left;fontSize=10;fontStyle=2;" value="Where the chain can break: Pod down → sidecar 404s → ServiceMonitor selector misses → Prom scrape fails (`up` = 0) → no data in TSDB → Grafana panel says &quot;No data&quot; → alert never fires.&#10;Diagnostic ladder: oc get pod kafka-0 → oc exec kafka-0 -c jmx-exporter -- wget -O - localhost:7071/metrics → oc get servicemonitor → in Prometheus UI: up{job=&quot;kafka&quot;}." vertex="1">
          <mxGeometry x="80" y="830" width="1500" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="e_broker_exporter" parent="1" edge="1" source="broker_c" target="exporter_c" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;endArrow=classic;strokeColor=#82b366;strokeWidth=2;fontSize=10;" value="JMX"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_pod_sm" parent="1" edge="1" source="exporter_c" target="sm" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;endArrow=classic;strokeColor=#5b87b9;strokeWidth=2;fontSize=10;" value="selected by"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_sm_prom" parent="1" edge="1" source="sm" target="prom" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;endArrow=classic;strokeColor=#d79b00;strokeWidth=2;fontSize=10;" value="scrape config"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_prom_tsdb" parent="1" edge="1" source="prom" target="tsdb" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;endArrow=classic;strokeColor=#d79b00;strokeWidth=2;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_prom_grafana" parent="1" edge="1" source="prom" target="grafana" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;endArrow=classic;strokeColor=#9673a6;strokeWidth=2;fontSize=10;" value="PromQL"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_prom_amgr" parent="1" edge="1" source="tsdb" target="amgr" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;endArrow=classic;strokeColor=#b85450;strokeWidth=2;fontSize=10;" value="alert rules"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_grafana_eye" parent="1" edge="1" source="grafana" target="eye" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;endArrow=classic;strokeColor=#666666;strokeWidth=2;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_amgr_eye" parent="1" edge="1" source="amgr" target="eye" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;endArrow=classic;strokeColor=#666666;strokeWidth=2;"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
