<mxfile host="app.diagrams.net" agent="manual">
  <diagram name="CFK CR to Pod" id="cfk-cr-to-pod">
    <mxGraphModel dx="1422" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" parent="1" style="text;html=1;align=center;fontSize=16;fontStyle=1;" value="CFK Reconciliation — Kafka CR → child objects → running Pods" vertex="1">
          <mxGeometry x="80" y="20" width="1500" height="40" as="geometry"/>
        </mxCell>

        <mxCell id="user" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;fontSize=11;" value="Engineer&#10;oc apply -f kafka.yaml" vertex="1">
          <mxGeometry x="80" y="120" width="200" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="api" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#326CE5;strokeColor=#FFFFFF;strokeWidth=2;align=center;fontColor=#FFFFFF;fontSize=12;fontStyle=1;" value="kube-apiserver&#10;+ etcd" vertex="1">
          <mxGeometry x="360" y="120" width="200" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="kafka_cr" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=middle;fontSize=10;spacingLeft=8;" value="Kafka CR (in etcd)&#10;  kind: Kafka&#10;  spec.replicas: 3&#10;  spec.image: cp-server:7.7.0&#10;  spec.dependencies.kRaftController" vertex="1">
          <mxGeometry x="640" y="100" width="280" height="120" as="geometry"/>
        </mxCell>

        <mxCell id="ns_operator" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#aaaaaa;align=left;verticalAlign=top;fontStyle=1;fontSize=11;spacingLeft=10;spacingTop=8;" value="confluent-operator namespace" vertex="1">
          <mxGeometry x="80" y="280" width="500" height="280" as="geometry"/>
        </mxCell>

        <mxCell id="operator" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EE0000;strokeColor=#FFFFFF;strokeWidth=2;align=center;fontColor=#FFFFFF;fontSize=12;fontStyle=1;" value="CFK Operator Pod&#10;Watch + Reconcile loop" vertex="1">
          <mxGeometry x="120" y="320" width="280" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="reconcile" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;align=left;verticalAlign=middle;fontSize=10;spacingLeft=10;" value="1. validate spec&#10;2. read dependencies (KRaftController ready?)&#10;3. render child objects (server-side apply)&#10;4. watch child objects&#10;5. write status.conditions" vertex="1">
          <mxGeometry x="120" y="420" width="420" height="120" as="geometry"/>
        </mxCell>

        <mxCell id="ns_workload" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;fontStyle=1;fontSize=11;spacingLeft=10;spacingTop=8;" value="dah-flink-dev namespace" vertex="1">
          <mxGeometry x="640" y="280" width="940" height="700" as="geometry"/>
