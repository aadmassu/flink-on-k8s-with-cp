          <mxGeometry x="680" y="320" width="200" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="svc" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#326CE5;strokeColor=#FFFFFF;align=center;fontColor=#FFFFFF;fontSize=11;fontStyle=1;" value="Service/kafka&#10;+ headless Service" vertex="1">
          <mxGeometry x="920" y="320" width="200" height="80" as="geometry"/>
