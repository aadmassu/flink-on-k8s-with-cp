        <mxCell id="status" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=middle;fontSize=10;spacingLeft=10;" value="Kafka.status (written by operator)&#10;  conditions:&#10;    - type: cluster-ready, status: True&#10;    - type: cluster-update, status: completed&#10;  replicas: 3, readyReplicas: 3" vertex="1">
