        </mxCell>

        <mxCell id="kafka0" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=center;fontSize=11;" value="kafka-0 Pod&#10;init → broker JVM&#10;broker.id=0" vertex="1">
