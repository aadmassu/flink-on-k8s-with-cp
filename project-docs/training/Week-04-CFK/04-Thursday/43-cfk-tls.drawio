<mxfile host="app.diagrams.net" agent="manual">
  <diagram name="CFK TLS" id="cfk-tls">
    <mxGraphModel dx="1422" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" parent="1" style="text;html=1;align=center;fontSize=16;fontStyle=1;" value="CFK TLS — cert-manager + Keyfactor produces it; CFK only consumes it" vertex="1">
          <mxGeometry x="80" y="20" width="1500" height="40" as="geometry"/>
        </mxCell>

        <mxCell id="issuance" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;verticalAlign=top;fontStyle=1;fontSize=12;spacingLeft=10;spacingTop=8;" value="Issuance side" vertex="1">
          <mxGeometry x="80" y="100" width="700" height="540" as="geometry"/>
        </mxCell>

        <mxCell id="cert_cr" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=middle;fontSize=10;spacingLeft=10;" value="Certificate CR&#10;  spec.commonName&#10;  spec.dnsNames&#10;  spec.issuerRef: keyfactor-issuer&#10;  spec.secretName: kafka-tls" vertex="1">
          <mxGeometry x="120" y="160" width="320" height="120" as="geometry"/>
        </mxCell>

        <mxCell id="cm_ctrl" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#326CE5;strokeColor=#FFFFFF;align=center;fontColor=#FFFFFF;fontSize=11;fontStyle=1;" value="cert-manager&#10;Controller" vertex="1">
          <mxGeometry x="500" y="160" width="200" height="100" as="geometry"/>
        </mxCell>

        <mxCell id="issuer" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;align=center;fontSize=11;" value="ClusterIssuer&#10;keyfactor-issuer" vertex="1">
          <mxGeometry x="500" y="320" width="200" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="keyfactor" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EE0000;strokeColor=#FFFFFF;align=center;fontColor=#FFFFFF;fontSize=11;fontStyle=1;" value="Keyfactor CA&#10;(off-cluster)&#10;issues cert" vertex="1">
          <mxGeometry x="500" y="460" width="200" height="120" as="geometry"/>
        </mxCell>

        <mxCell id="secret" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#326CE5;strokeColor=#FFFFFF;align=left;verticalAlign=middle;fontColor=#FFFFFF;fontSize=10;fontStyle=1;spacingLeft=10;" value="Secret kafka-tls&#10;  tls.crt&#10;  tls.key&#10;  ca.crt" vertex="1">
          <mxGeometry x="120" y="320" width="320" height="120" as="geometry"/>
        </mxCell>

        <mxCell id="renewal" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;align=left;verticalAlign=middle;fontSize=10;fontStyle=2;spacingLeft=10;" value="cert-manager auto-renews based on Certificate.spec.duration + renewBefore.&#10;On Secret rotation, CFK operator rolling-restarts StatefulSet to pick up new key/cert." vertex="1">
          <mxGeometry x="120" y="480" width="320" height="100" as="geometry"/>
        </mxCell>

        <mxCell id="consumption" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;fontStyle=1;fontSize=12;spacingLeft=10;spacingTop=8;" value="Consumption side (broker Pod)" vertex="1">
          <mxGeometry x="820" y="100" width="760" height="540" as="geometry"/>
        </mxCell>

        <mxCell id="init" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;align=center;fontSize=11;" value="init container&#10;mounts Secret&#10;builds JKS keystore + truststore" vertex="1">
          <mxGeometry x="860" y="160" width="320" height="100" as="geometry"/>
        </mxCell>

        <mxCell id="jks" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;align=left;verticalAlign=middle;fontSize=10;spacingLeft=10;" value="keystore.jks  ← tls.crt + tls.key&#10;truststore.jks ← ca.crt (+ any extra CAs)" vertex="1">
          <mxGeometry x="1220" y="160" width="340" height="100" as="geometry"/>
        </mxCell>

        <mxCell id="broker" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=center;fontSize=11;fontStyle=1;" value="Kafka broker JVM&#10;ssl.keystore.location=keystore.jks&#10;ssl.truststore.location=truststore.jks" vertex="1">
          <mxGeometry x="860" y="320" width="700" height="120" as="geometry"/>
        </mxCell>

        <mxCell id="handshake" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=middle;fontSize=10;spacingLeft=10;" value="At client connect:&#10;  1. broker presents cert from keystore&#10;  2. client validates against its trust&#10;  3. (mTLS only) client presents cert&#10;  4. broker validates against truststore" vertex="1">
          <mxGeometry x="860" y="480" width="700" height="140" as="geometry"/>
        </mxCell>

        <mxCell id="boundary" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=center;fontSize=11;fontStyle=2;" value="Boundary: CFK does not issue certs.&#10;If truststore lacks a CA, handshake fails (tracker 2.8)." vertex="1">
          <mxGeometry x="80" y="700" width="1500" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="e_cr_cm" parent="1" edge="1" source="cert_cr" target="cm_ctrl" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;endArrow=classic;strokeColor=#d6b656;strokeWidth=2;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_cm_iss" parent="1" edge="1" source="cm_ctrl" target="issuer" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;endArrow=classic;strokeColor=#326CE5;strokeWidth=2;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_iss_kf" parent="1" edge="1" source="issuer" target="keyfactor" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;endArrow=classic;strokeColor=#d79b00;strokeWidth=2;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_cm_secret" parent="1" edge="1" source="cm_ctrl" target="secret" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;endArrow=classic;strokeColor=#326CE5;strokeWidth=2;" value="write"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_secret_init" parent="1" edge="1" source="secret" target="init" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;endArrow=classic;strokeColor=#6c8ebf;strokeWidth=2;" value="mount"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_init_jks" parent="1" edge="1" source="init" target="jks" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;endArrow=classic;strokeColor=#6c8ebf;strokeWidth=2;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_jks_broker" parent="1" edge="1" source="jks" target="broker" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;endArrow=classic;strokeColor=#82b366;strokeWidth=2;"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
