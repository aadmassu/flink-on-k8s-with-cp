<mxfile host="app.diagrams.net" agent="manual">
  <diagram name="Cluster Link" id="cluster-link">
    <mxGraphModel dx="1422" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" parent="1" style="text;html=1;align=center;fontSize=16;fontStyle=1;" value="Cluster Linking — VM CP source → CFK destination; 9094 mTLS path (tracker 2.10)" vertex="1">
          <mxGeometry x="80" y="20" width="1500" height="40" as="geometry"/>
        </mxCell>

        <mxCell id="src" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;verticalAlign=top;fontStyle=1;fontSize=12;spacingLeft=10;spacingTop=8;" value="Source — VM CP (current state)" vertex="1">
          <mxGeometry x="80" y="100" width="600" height="500" as="geometry"/>
        </mxCell>

        <mxCell id="vmbrokers" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=center;fontSize=11;" value="VM Kafka brokers&#10;(3-5 nodes per env)" vertex="1">
          <mxGeometry x="120" y="160" width="520" height="100" as="geometry"/>
        </mxCell>

        <mxCell id="vmprod" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;align=center;fontSize=10;" value="Existing producers&#10;writing to VM (today)" vertex="1">
          <mxGeometry x="120" y="320" width="240" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="vmcons" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;align=center;fontSize=10;" value="Existing consumers&#10;reading from VM (today)" vertex="1">
          <mxGeometry x="400" y="320" width="240" height="100" as="geometry"/>
        </mxCell>

        <mxCell id="vmtopics" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=center;fontSize=10;" value="topics: orders, payments,&#10;customers, ..." vertex="1">
          <mxGeometry x="120" y="460" width="520" height="100" as="geometry"/>
        </mxCell>

        <mxCell id="firewall" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=center;fontSize=11;fontStyle=1;" value="Firewall exception (tracker 2.10)&#10;VM broker → CFK broker port 9094&#10;mTLS — VM presents client cert" vertex="1">
          <mxGeometry x="720" y="240" width="280" height="200" as="geometry"/>
        </mxCell>

        <mxCell id="dst" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;fontStyle=1;fontSize=12;spacingLeft=10;spacingTop=8;" value="Destination — CFK on OpenShift (target state)" vertex="1">
          <mxGeometry x="1020" y="100" width="560" height="500" as="geometry"/>
        </mxCell>

        <mxCell id="cfkbrokers" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#326CE5;strokeColor=#FFFFFF;align=center;fontColor=#FFFFFF;fontSize=11;" value="CFK brokers&#10;9091 internal / 9092 OAuth / 9094 mTLS" vertex="1">
          <mxGeometry x="1060" y="160" width="480" height="100" as="geometry"/>
        </mxCell>

        <mxCell id="link_cr" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=middle;fontSize=10;fontFamily=Courier New;spacingLeft=10;" value="ClusterLink CR&#10;  source: vm-kafka:9094 mTLS&#10;  mirrorTopics:&#10;    - orders&#10;    - payments" vertex="1">
          <mxGeometry x="1060" y="280" width="480" height="120" as="geometry"/>
        </mxCell>

        <mxCell id="mirrors" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=center;fontSize=10;" value="mirror topics (read-only)&#10;orders, payments&#10;offset positions preserved" vertex="1">
          <mxGeometry x="1060" y="420" width="480" height="120" as="geometry"/>
        </mxCell>

        <mxCell id="cutover" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;align=left;verticalAlign=middle;fontSize=10;spacingLeft=10;" value="Cutover (per env)&#10;  1. wait for mirror lag → 0&#10;  2. pause VM producers&#10;  3. wait for VM consumers to drain&#10;  4. repoint producers to CFK&#10;  5. repoint consumers to CFK&#10;  6. decommission VM (later)" vertex="1">
          <mxGeometry x="80" y="660" width="1500" height="160" as="geometry"/>
        </mxCell>

        <mxCell id="e_vm_fw" parent="1" edge="1" source="vmbrokers" target="firewall" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;endArrow=classic;strokeColor=#d79b00;strokeWidth=2;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_fw_cfk" parent="1" edge="1" source="firewall" target="cfkbrokers" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;endArrow=classic;strokeColor=#b85450;strokeWidth=2;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_cfk_link" parent="1" edge="1" source="cfkbrokers" target="link_cr" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;endArrow=classic;strokeColor=#326CE5;strokeWidth=2;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_link_mirror" parent="1" edge="1" source="link_cr" target="mirrors" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;endArrow=classic;strokeColor=#d6b656;strokeWidth=2;"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
