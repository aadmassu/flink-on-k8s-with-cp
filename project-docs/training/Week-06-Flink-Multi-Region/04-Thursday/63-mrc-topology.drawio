<mxfile host="app.diagrams.net" agent="manual">
  <diagram name="MRC Topology" id="mrc-topology">
    <mxGraphModel dx="1422" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" parent="1" style="text;html=1;align=center;fontSize=16;fontStyle=1;" value="Multi-Region Cluster vs Cluster-Linked — two patterns for region failure tolerance" vertex="1">
          <mxGeometry x="80" y="20" width="1500" height="40" as="geometry"/>
        </mxCell>

        <mxCell id="pa" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;verticalAlign=top;fontStyle=1;fontSize=12;spacingLeft=10;spacingTop=8;" value="Pattern A — Single MRC across regions" vertex="1">
          <mxGeometry x="80" y="100" width="1500" height="380" as="geometry"/>
        </mxCell>

        <mxCell id="ra_a" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;fontSize=11;fontStyle=1;" value="Region A&#10;brokers 0,1 — KRaft node" vertex="1">
          <mxGeometry x="120" y="160" width="380" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="ra_b" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;fontSize=11;fontStyle=1;" value="Region B&#10;brokers 2,3 — KRaft node" vertex="1">
          <mxGeometry x="640" y="160" width="380" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="ra_c" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;fontSize=11;fontStyle=1;" value="Region C&#10;brokers 4,5 — KRaft node" vertex="1">
          <mxGeometry x="1160" y="160" width="380" height="120" as="geometry"/>
        </mxCell>

        <mxCell id="pa_note" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;align=left;verticalAlign=middle;fontSize=10;spacingLeft=10;" value="One Kafka cluster · partitions replicated across regions · sync replication (acks=all) gives strong consistency&#10;Pros: survives full region loss with no manual action&#10;Cons: cross-region latency on every produce; controller quorum spread across regions" vertex="1">
          <mxGeometry x="120" y="320" width="1420" height="140" as="geometry"/>
        </mxCell>

        <mxCell id="pb" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;fontStyle=1;fontSize=12;spacingLeft=10;spacingTop=8;" value="Pattern B — Two clusters with cluster linking (the platform&#39;s current architecture)" vertex="1">
          <mxGeometry x="80" y="510" width="1500" height="430" as="geometry"/>
        </mxCell>

        <mxCell id="rb_a" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#326CE5;strokeColor=#FFFFFF;align=center;fontColor=#FFFFFF;fontSize=11;fontStyle=1;" value="Region A — primary cluster&#10;brokers 0,1,2 · KRaft local quorum" vertex="1">
          <mxGeometry x="120" y="570" width="540" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="rb_b" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#326CE5;strokeColor=#FFFFFF;align=center;fontColor=#FFFFFF;fontSize=11;fontStyle=1;" value="Region B — DR cluster&#10;brokers 0,1,2 · KRaft local quorum" vertex="1">
          <mxGeometry x="1000" y="570" width="540" height="140" as="geometry"/>
        </mxCell>

        <mxCell id="rb_link" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=center;fontSize=10;" value="Cluster Link&#10;async, eventual" vertex="1">
          <mxGeometry x="700" y="600" width="240" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="pb_note" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;align=left;verticalAlign=middle;fontSize=10;spacingLeft=10;" value="Two independent clusters · asynchronous link · each region serves local clients with low latency&#10;Pros: low latency per region; independent ops; controller failures are local&#10;Cons: failover is manual (or scripted); brief data lag on cutover" vertex="1">
          <mxGeometry x="120" y="740" width="1420" height="180" as="geometry"/>
        </mxCell>

        <mxCell id="e_ra_b" parent="1" edge="1" source="ra_a" target="ra_b" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;endArrow=classic;startArrow=classic;strokeColor=#6c8ebf;strokeWidth=2;" value="sync repl"><mxGeometry relative="1" as="geometry"/></mxCell>
