# Cluster Linking + Schema Linking settings for dr.
# Consumed by .azure-pipelines/cluster-linking.yaml. No credentials live here.
# Source      = CFK PRD (PRD-P) cluster (apps/confluent-platform/prd)
# Destination = CFK cluster in dah-flink-prod
# Source is the CFK PRD-P cluster in the pd-p OpenShift cluster. CFK brokers are ClusterIP-only
# today, so the PRD-P external bootstrap must be exposed (per-broker passthrough Routes) first.
# The floating apps.pd hostnames follow the primary; use pd-s-specific names here.

# --- Link identity -----------------------------------------------------------
LINK_NAME=cfk-prd-to-cfk-dr
SCHEMA_LINK_NAME=cfk-prd-to-cfk-dr-schemas

# --- Source Kafka (client-facing OAuth listener on 9092) ---------------------
# @vargroup = hosts from variable group kafka-openshift-credentials-dr:
#   dr-kafka-broker-hosts (comma-separated host[:port]; port is replaced by SOURCE_BOOTSTRAP_PORT)
# Reference from the VM properties: CFK source; <env>-kafka-broker-hosts in the variable group points at the VM cluster, so @vargroup does not apply
SOURCE_BOOTSTRAP=REPLACE_WITH_PRD_P_CFK_EXTERNAL_BOOTSTRAP
SOURCE_BOOTSTRAP_PORT=9092
# Every resolved broker host must start with this prefix (catches a variable pointing at another env). Empty = skip.
SOURCE_HOST_PREFIX=
# @discover = the pipeline resolves the source Kafka cluster ID at run time.
SOURCE_CLUSTER_ID=@discover
SOURCE_OAUTH_SCOPE=11547.DAH(PD)
# @vargroup = kafka-oauthbearer-token-endpoint-url from the variable group.
SOURCE_OAUTH_TOKEN_ENDPOINT=@vargroup
SOURCE_MDS_URL=REPLACE_WITH_PRD_P_CFK_MDS_URL

# --- Source Schema Registry --------------------------------------------------
# @vargroup = https://<first host of dr-schema-registry-hosts>:SOURCE_SR_PORT
SOURCE_SR_URL=REPLACE_WITH_PRD_P_CFK_SR_URL
SOURCE_SR_PORT=8081
# schema.registry.group.id of the SOURCE SR = its RBAC cluster id (used in source-rolebindings.sh).
SOURCE_SR_CLUSTER_ID=schema-registry

# --- Destination (CFK) -------------------------------------------------------
DEST_NAMESPACE=dah-flink-prod
DEST_KAFKA_NAME=kafka
DEST_KAFKA_REST_CLASS=default
DEST_SR_NAME=schemaregistry
# Schema Registry URL the source-side exporter dials; must be routable from the source network.
DEST_SR_PUBLIC_URL=REPLACE_WITH_PRD_S_CFK_SR_URL
# @live = read schema.registry.group.id from the running CFK SR pod.
DEST_SR_CLUSTER_ID=@live

# --- Secrets the pipeline creates (create-link-prereqs) ----------------------
LINK_OAUTH_SECRET=oauth-clusterlink
SOURCE_CA_SECRET=clusterlink-source-ca

# --- In-pod admin client (kafka-mirrors / kafka-cluster-links on the CFK side)
LOCAL_BOOTSTRAP=kafka.dah-flink-prod.svc.cluster.local:9071
LOCAL_TRUSTSTORE=/var/ssl/truststore/bundle.p12
LOCAL_TRUSTSTORE_PASSWORD=changeit
