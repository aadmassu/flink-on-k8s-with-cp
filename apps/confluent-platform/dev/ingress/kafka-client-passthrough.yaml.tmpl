---
########################################################################
# Author:      Ayu Admassu
# Date:        2026-10-01 (created)
# Description: TEMPLATE for the Kafka `client` listener passthrough
#              Ingresses (bootstrap + one per broker). The pipeline fills
#              __HOST__ / __SERVICE__ / __NAME__ from the live advertised
#              listeners and CFK Services, one document per endpoint, and
#              applies the result (runbook H10). Not applied as-is.
########################################################################
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: __NAME__
  namespace: dah-flink-dev
  labels:
    app.kubernetes.io/name: kafka
    app.kubernetes.io/instance: __NAME__
    app.kubernetes.io/component: kafka-passthrough
    app.kubernetes.io/part-of: confluent-platform
    fcbint.net/app-id: "11547"
  annotations:
    route.openshift.io/termination: passthrough
    haproxy.router.openshift.io/timeout: 1h
    haproxy.router.openshift.io/balance: source
    fcbint.net/contact: dahkafkasupportnotification@firstcitizens.com
spec:
  ingressClassName: openshift-core-zone
  rules:
    - host: __HOST__
      http:
        paths:
          - backend:
              service:
                name: __SERVICE__
                port:
                  number: 9093
            path: ""
            pathType: ImplementationSpecific
