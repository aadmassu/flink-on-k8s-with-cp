{
  "schemaVersion": 1,
  "environment": "qa",
  "namespace": "dah-flink-qa",
  "oauth": {
    "tokenEndpoint": "https://myapps.firstcitizens.com/oauth2/default/v1/token",
    "scope": "11547.DAH(QA)"
  },
  "mds": {
    "endpoint": "https://kafka.dah-flink-qa.svc.cluster.local:8090",
    "service": "kafka",
    "caSecret": "kafka-tls",
    "caKey": "ca.crt"
  },
  "bindings": [
    {
      "id": "onboarding-user-kafka-clusteradmin",
      "principal": "User:__ONBOARDING_USER_SUB__",
      "roleName": "ClusterAdmin",
      "clusters": {"kafka-cluster": "@live"}
    },
    {
      "id": "onboarding-user-schemaregistry-systemadmin",
      "principal": "User:__ONBOARDING_USER_SUB__",
      "roleName": "SystemAdmin",
      "clusters": {"kafka-cluster": "@live", "schema-registry-cluster": "id_schemaregistry_dah-flink-qa"}
    },
    {
      "id": "onboarding-user-connect-systemadmin",
      "principal": "User:__ONBOARDING_USER_SUB__",
      "roleName": "SystemAdmin",
      "clusters": {"kafka-cluster": "@live", "connect-cluster": "dah-flink-qa.connect"}
    },
    {
      "id": "onboarding-group-kafka-clusteradmin",
      "principal": "Group:__ONBOARDING_DEVELOPER_GROUP__",
      "roleName": "ClusterAdmin",
      "clusters": {"kafka-cluster": "@live"}
    },
    {
      "id": "onboarding-group-schemaregistry-systemadmin",
      "principal": "Group:__ONBOARDING_DEVELOPER_GROUP__",
      "roleName": "SystemAdmin",
      "clusters": {"kafka-cluster": "@live", "schema-registry-cluster": "id_schemaregistry_dah-flink-qa"}
    },
    {
      "id": "onboarding-group-connect-systemadmin",
      "principal": "Group:__ONBOARDING_DEVELOPER_GROUP__",
      "roleName": "SystemAdmin",
      "clusters": {"kafka-cluster": "@live", "connect-cluster": "dah-flink-qa.connect"}
    }
  ]
}
