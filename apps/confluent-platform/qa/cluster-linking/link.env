# Cluster Linking + Schema Linking settings for qa.
# Consumed by .azure-pipelines/cluster-linking.yaml. No credentials live here.
# Source      = VM QA Confluent Platform (cp-confluent/qa)
# Destination = CFK cluster in dah-flink-qa
# QA is the pilot env for the linking pipeline. VM QA Schema Registry does NOT yet load
# the SchemaExporter extension (see README); provision-schema-link stays blocked until it does.

# --- Link identity -----------------------------------------------------------
LINK_NAME=vm-qa-to-cfk-qa
SCHEMA_LINK_NAME=vm-qa-to-cfk-qa-schemas

# --- Source Kafka (client-facing OAuth listener on 9092) ---------------------
# @vargroup = hosts from variable group kafka-openshift-credentials-qa:
#   qa-kafka-broker-hosts (comma-separated host[:port]; port is replaced by SOURCE_BOOTSTRAP_PORT)
# Reference from the VM properties: q11547varc-3572/0883/4394 :9092; SR q11547varc-5749/4925 :8081 (cp-confluent/qa)
SOURCE_BOOTSTRAP=@vargroup
SOURCE_BOOTSTRAP_PORT=9092
# Every resolved broker host must start with this prefix (catches a variable pointing at another env). Empty = skip.
SOURCE_HOST_PREFIX=q11547varc-
# @discover = the pipeline resolves the source Kafka cluster ID at run time.
SOURCE_CLUSTER_ID=@discover
SOURCE_OAUTH_SCOPE=11547.DAH(QA)
# @vargroup = kafka-oauthbearer-token-endpoint-url from the variable group.
SOURCE_OAUTH_TOKEN_ENDPOINT=@vargroup
SOURCE_MDS_URL=https://q11547varc-3572.fcpd.fcbint.net:8090

# --- Source Schema Registry --------------------------------------------------
# @vargroup = https://<first host of qa-schema-registry-hosts>:SOURCE_SR_PORT
SOURCE_SR_URL=@vargroup
SOURCE_SR_PORT=8081
# schema.registry.group.id of the SOURCE SR = its RBAC cluster id (used in source-rolebindings.sh).
SOURCE_SR_CLUSTER_ID=qa_schema_registry

# --- Destination (CFK) -------------------------------------------------------
DEST_NAMESPACE=dah-flink-qa
DEST_KAFKA_NAME=kafka
DEST_KAFKA_REST_CLASS=default
DEST_SR_NAME=schemaregistry
# Schema Registry URL the source-side exporter dials; must be routable from the source network.
DEST_SR_PUBLIC_URL=https://schemaregistry.apps.qa.ocp.fcbint.net
# @live = read schema.registry.group.id from the running CFK SR pod.
DEST_SR_CLUSTER_ID=@live

# --- Secrets the pipeline creates (create-link-prereqs) ----------------------
LINK_OAUTH_SECRET=oauth-clusterlink
SOURCE_CA_SECRET=clusterlink-source-ca

# --- In-pod admin client (kafka-mirrors / kafka-cluster-links on the CFK side)
LOCAL_BOOTSTRAP=kafka.dah-flink-qa.svc.cluster.local:9071
LOCAL_TRUSTSTORE=/var/ssl/truststore/bundle.p12
LOCAL_TRUSTSTORE_PASSWORD=changeit
